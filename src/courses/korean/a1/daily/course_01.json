    "grammar": [
        {
            "point": "「-(으)ㄴ 후에」（…之后）",
            "explain": "动词词干有收音用 -은 후에，无收音用 -ㄴ 후에。例：먹다 → 먹은 후에（吃之后）；씻다 → 씻은 후에（洗之后）；자다 → 잔 후에（睡之后）。후 = 之后，에 = 时间点。中文「…之后」直接用「之后」，韩语要配合动词变形。",
            "examples": [
                {
                    "vi": "아침을 먹은 후에 학교에 갑니다.",
                    "zh": "吃完早饭后去学校。"
                },
                {
                    "vi": "씻은 후에 잡니다.",
                    "zh": "洗完澡睡觉。"
                }
            ]
        },
        {
            "point": "「-기 전에」（…之前）",
            "explain": "动词词干 + 기 전에，形式统一（不区分有无收音）：먹기 전에（吃之前）、자기 전에（睡之前）、일어나기 전에（起床之前）。전 = 之前。注意：-기 전에 前不能接时态。中文「…之前」也用这个结构。",
            "examples": [
                {
                    "vi": "자기 전에 이를 닦습니다.",
                    "zh": "睡前刷牙。"
                },
                {
                    "vi": "일어나기 전에 알람이 울립니다.",
                    "zh": "起床之前闹钟响。"
                }
            ]
        }
    ],
