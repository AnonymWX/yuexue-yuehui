    "grammar": [
        {
            "point": "宾语助词「을/를」",
            "explain": "을/를 标记动词的宾语：名词最后一个音节有收音用 을，无收音用 를。한국어 → 한국어를（无收音）；책 → 책을（有收音 ㅅ）。中文没有格助词，靠语序区分主宾；韩语靠助词，语序可调整。",
            "examples": [
                {
                    "vi": "저는 한국어를 공부합니다.",
                    "zh": "我学习韩国语。"
                },
                {
                    "vi": "책을 읽습니다.",
                    "zh": "读书。"
                }
            ]
        },
        {
            "point": "动词正式体「-ㅂ니다/습니다」",
            "explain": "动词/形容词词干最后音节有收音用 -습니다，无收音用 -ㅂ니다。공부하다 → 공부하 + ㅂ니다 = 공부합니다；읽다 → 읽 + 습니다 = 읽습니다；말하다 → 말합니다。疑问句把 -ㅂ니다 改成 -ㅂ니까?，语序不变。",
            "examples": [
                {
                    "vi": "영어를 공부합니까?",
                    "zh": "你学习英语吗？"
                },
                {
                    "vi": "네, 영어를 공부합니다.",
                    "zh": "是的，我学习英语。"
                }
            ]
        }
    ],
    "telex": [],
