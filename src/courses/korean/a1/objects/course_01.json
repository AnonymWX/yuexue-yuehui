    "grammar": [
        {
            "point": "指示代词「이것 / 그것 / 저것」",
            "explain": "韩语按距离分三级：이것 = 离说话人近（这）；그것 = 离听话人近或双方稍远（那）；저것 = 双方都远（那个）。后接主题助词 은/는 时分别是 이것은 / 그것은 / 저것은（都无收音 → 는）。中文只有「这/那」两级，注意 그것 与 저것 的远近差别。",
            "examples": [
                {
                    "vi": "이것은 책입니다.",
                    "zh": "这是书。"
                },
                {
                    "vi": "그것은 가방입니다.",
                    "zh": "那是包。"
                }
            ]
        },
        {
            "point": "疑问句「무엇입니까?」与否定「이/가 아닙니다」",
            "explain": "무엇 = 「什么」。问「这是什么」用「이것은 무엇입니까?」，回答用「N은/는 N입니다」。否定用「N이/가 아닙니다」（有收音用 이，无收音用 가）：책 → 책이 아닙니다；가방 → 가방이 아닙니다；지갑 → 지갑이 아닙니다。",
            "examples": [
                {
                    "vi": "이것은 무엇입니까?",
                    "zh": "这是什么？"
                },
                {
                    "vi": "아니요, 그것은 지갑이 아닙니다.",
                    "zh": "不，那不是钱包。"
                }
            ]
        }
    ],
