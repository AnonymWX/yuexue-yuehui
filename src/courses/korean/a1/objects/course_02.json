    "grammar": [
        {
            "point": "位置名词「위 / 아래 / 앞 / 뒤 / 옆」",
            "explain": "位置名词：위（上）、아래（下）、앞（前）、뒤（后）、옆（旁边）、안（里）、밖（外）。用法「N + 위치명사 + 에」：책상 위에（在桌上）、의자 아래에（在椅下）。中文「在…上」对应「N 위에」。注意这些是名词，不是介词，不能单独放动词前。",
            "examples": [
                {
                    "vi": "책상 위에 있습니다.",
                    "zh": "在桌子上面。"
                },
                {
                    "vi": "의자 아래에 있습니다.",
                    "zh": "在椅子下面。"
                }
            ]
        },
        {
            "point": "「N이/가 N에 있습니다/없습니다」",
            "explain": "存在句：主语用 이/가（有收音用 이，无收音用 가），位置用 에。例：책이 책상 위에 있습니다（书在桌上）；휴대폰이 가방에 없습니다（手机不在包里）。中文「…在…」对应。注意 이/가 是主语助词，에 是位置助词，别混。",
            "examples": [
                {
                    "vi": "책이 책상 위에 있습니다.",
                    "zh": "书在桌上。"
                },
                {
                    "vi": "휴대폰이 가방에 없습니다.",
                    "zh": "手机不在包里。"
                }
            ]
        }
    ],
