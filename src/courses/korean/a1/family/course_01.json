    "grammar": [
        {
            "point": "量词「명 / 살」+ 固有数词",
            "explain": "人数用「固有数词 + 명」：한 명、두 명、세 명、네 명（1~4 变形）。年龄用「固有数词 + 살」：열 살（10 岁）、스무 살（20 岁）。固有数词：하나→한、둘→두、셋→세、넷→네、다섯、여섯、일곱、여덟、아홉、열。注意：价格/电话号码用汉字数词，人数/年龄用固有数词。",
            "examples": [
                {
                    "vi": "우리 가족은 네 명입니다.",
                    "zh": "我家四口人。"
                },
                {
                    "vi": "동생은 열 살입니다.",
                    "zh": "弟弟十岁。"
                }
            ]
        },
        {
            "point": "助词「의」（的）",
            "explain": "의 表所属关系，相当于中文「的」：아버지의 이름（父亲的名字）。口语中 의 常读作 에：아버지에 이름。저 + 의 缩略为 제（我的）。注意与 은/는/이/가 的分工：의 只表所属，不作主语/主题。",
            "examples": [
                {
                    "vi": "아버지의 이름은 무엇입니까?",
                    "zh": "父亲的名字是什么？"
                },
                {
                    "vi": "제 어머니는 선생님입니다.",
                    "zh": "我母亲是老师。"
                }
            ]
        }
    ],
