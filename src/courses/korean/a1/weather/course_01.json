    "grammar": [
        {
            "point": "形容词主语助词「이/가」",
            "explain": "形容词作谓语时，主语用 이/가（有收音用 이，无收音用 가）：날씨가 좋습니다（天气好）、날씨가 나쁩니다。注意与 은/는 的区别：은/는 表主题/对比，이/가 表新信息主语。初学者记「天气类形容词句用 가」即可。덥다 → 덥습니다（ㅂ 不规则，词干 덥 + 습니다），춥다 → 춥습니다。",
            "examples": [
                {
                    "vi": "날씨가 좋습니다.",
                    "zh": "天气好。"
                },
                {
                    "vi": "지금은 덥습니다.",
                    "zh": "现在热。"
                }
            ]
        },
        {
            "point": "「비가 오다 / 눈이 오다」",
            "explain": "韩语「下雨/下雪」用「비/눈 + 가 + 오다（来）」，不说「비가 내리다」以外的东西。正式体：비가 옵니다 / 눈이 옵니다。오다 词干 오 无收音 → -ㅂ니다。问句：비가 옵니까?（下雨吗？）",
            "examples": [
                {
                    "vi": "비가 옵니다.",
                    "zh": "下雨。"
                },
                {
                    "vi": "눈이 옵니까?",
                    "zh": "下雪吗？"
                }
            ]
        }
    ],
