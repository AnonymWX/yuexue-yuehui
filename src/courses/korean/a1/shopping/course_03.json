  "grammar": [
    {
      "point": "「교환하다 / 환불하다」+「-고 싶습니다」",
      "explain": "교환하다 = 换货，환불하다 = 退款，两个都是 하다 动词。表达意愿「想换货」用「교환하고 싶습니다」（-고 싶다 接动词词干）。问「可以换货吗」用「교환할 수 있습니까?」。中文「想换/想退」对应。注意：换货通常要「영수증」（收据），退款分「현금 환불 / 카드 환불」。",
      "examples": [
        {
          "vi": "교환하고 싶습니다.",
          "zh": "想换货。"
        },
        {
          "vi": "환불할 수 있습니까?",
          "zh": "可以退款吗？"
        }
      ]
    },
    {
      "point": "付款方式「현금 / 카드」+「-으로 계산하다」",
      "explain": "付款方式：현금（现金）、카드（卡）。结账用「-으로 계산하다」：현금으로 계산합니다（付现金）；카드로 계산합니다（刷卡）。카드 无收音 → 카드로（不是 카드으로）。中文「刷卡/付现金」对应。注意 포장（打包）常用于餐饮，「포장해 주세요」= 请打包。",
      "examples": [
        {
          "vi": "카드로 계산합니다.",
          "zh": "刷卡结账。"
        },
        {
          "vi": "현금으로 계산해 주세요.",
          "zh": "请收现金。"
        }
      ]
    }
  ],
