  "grammar": [
    {
      "point": "「얼마입니까?」+ 货币「원」",
      "explain": "问价格用「N은/는 얼마입니까?」，回答「N원입니다」。원 是韩元，数字用汉字数词（일/이/삼…），如 만 원（一万韩元）、오천 원（五千韩元）。中文问「多少钱」不分正式/非正式，韩语这里用正式体。",
      "examples": [
        {
          "vi": "이 책은 얼마입니까?",
          "zh": "这本书多少钱？"
        },
        {
          "vi": "만 원입니다.",
          "zh": "一万韩元。"
        }
      ]
    },
    {
      "point": "「비싸다 / 싸다」+「에서」",
      "explain": "비싸다 = 贵，싸다 = 便宜，正式体分别是 비쌉니다 / 쌉니다（ㅆ 有收音 → -습니다）。에서 表示动作发生的场所：「시장에서 사다」= 在市场买。注意 에 是存在位置，에서 是动作场所。",
      "examples": [
        {
          "vi": "너무 비쌉니다.",
          "zh": "太贵了。"
        },
        {
          "vi": "시장에서 책을 삽니다.",
          "zh": "在市场买书。"
        }
      ]
    }
  ],
