    "grammar": [
        {
            "point": "「N을/를 좋아하다 / 싫어하다」",
            "explain": "좋아하다 = 喜欢，싫어하다 = 讨厌，都是 하다 动词，正式体 -ㅂ니다 形式为 좋아합니다 / 싫어합니다。宾语用 을/를：영화를 좋아합니다（喜欢电影）、운동을 싫어합니다（讨厌运动）。中文「喜欢」后面直接接名词，韩语要加助词。",
            "examples": [
                {
                    "vi": "저는 영화를 좋아합니다.",
                    "zh": "我喜欢电影。"
                },
                {
                    "vi": "운동을 싫어합니까?",
                    "zh": "讨厌运动吗？"
                }
            ]
        },
        {
            "point": "「취미가 무엇입니까?」",
            "explain": "취미 = 爱好。问爱好用「취미가 무엇입니까?」，回答「제 취미는 N입니다」或「N을/를 좋아합니다」。注意这里用 이/가 标主语（新信息），回答时用 은/는 标主题。제 = 저 + 의 的缩略，表「我的」。",
            "examples": [
                {
                    "vi": "취미가 무엇입니까?",
                    "zh": "你的爱好是什么？"
                },
                {
                    "vi": "제 취미는 음악입니다.",
                    "zh": "我的爱好是音乐。"
                }
            ]
        }
    ],
    "telex": [],
