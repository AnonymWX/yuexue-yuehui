    "grammar": [
        {
            "point": "「-아/어서」（因为）",
            "explain": "词干最后元音 ㅏ/ㅗ 用 -아서，其他用 -어서，하다 用 -해서。表原因：아파서（因为疼）、바빠서（因为忙）。注意 -아/어서 前不能接时态。中文「因为…所以…」韩语常只用前半句。",
            "examples": [
                {
                    "vi": "머리가 아파서 약을 먹습니다.",
                    "zh": "因为头疼所以吃药。"
                },
                {
                    "vi": "감기에 걸려서 병원에 갑니다.",
                    "zh": "因为感冒所以去医院。"
                }
            ]
        },
        {
            "point": "「-(으)면」（如果 / 的话）",
            "explain": "词干有收音用 -으면，无收音用 -면：아프면（如果疼）、바쁘면（如果忙）。表条件或假设。例：아프면 쉬세요（不舒服就休息）。注意 -면 前不能接时态。",
            "examples": [
                {
                    "vi": "아프면 병원에 가세요.",
                    "zh": "不舒服的话去医院。"
                },
                {
                    "vi": "피곤하면 쉬세요.",
                    "zh": "累的话休息一下。"
                }
            ]
        }
    ],
