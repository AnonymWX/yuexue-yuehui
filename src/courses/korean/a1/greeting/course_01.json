  "grammar": [
    {
      "point": "主题助词「은/는」+ 判断句「입니다」",
      "explain": "「은/는」标记句子的主题：有收音用「은」，无收音用「는」。「입니다」是「是」的敬语肯定形式，接在名词后。疑问句把「입니다」改为「입니까?」，语序不变。",
      "examples": [
        {
          "vi": "저는 학생입니다.",
          "zh": "我是学生。"
        },
        {
          "vi": "선생님은 한국 사람입니까?",
          "zh": "老师是韩国人吗？"
        }
      ]
    },
    {
      "point": "否定「이/가 아닙니다」与「도」",
      "explain": "否定用「N이/가 아닙니다」（有收音用「이」，无收音用「가」）。「도」代替「은/는」，表「也」。",
      "examples": [
        {
          "vi": "저는 학생이 아닙니다.",
          "zh": "我不是学生。"
        },
        {
          "vi": "저도 학생입니다.",
          "zh": "我也是学生。"
        }
      ]
    }
  ],
