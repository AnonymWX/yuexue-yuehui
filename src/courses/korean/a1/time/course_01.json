    "grammar": [
        {
            "point": "固有数词 +「시 / 분」",
            "explain": "钟点用固有数词：하나→한、둘→두、셋→세、넷→네、다섯、여섯、일곱、여덟、아홉、열。接「시」时前四个变形：한 시、두 시、세 시、네 시。分钟用「분」，也是固有数词（십오 분 = 15 分）。注意：汉字数词用于价格/电话号码，钟点用固有数词，别混。",
            "examples": [
                {
                    "vi": "지금 두 시입니다.",
                    "zh": "现在两点。"
                },
                {
                    "vi": "오전 열 시 삼십 분입니다.",
                    "zh": "上午十点三十分。"
                }
            ]
        },
        {
            "point": "时间助词「에」与「몇 시입니까?」",
            "explain": "에 接在时间名词后表示「在…（时间）」，如 두 시에（两点）。问时间用「지금 몇 시입니까?」，몇 = 「几」。注意：에 与第 4 课位置 에 同形，但一个标时间、一个标位置，靠名词性质区分。",
            "examples": [
                {
                    "vi": "오후 세 시에 약속이 있습니다.",
                    "zh": "下午三点有约。"
                },
                {
                    "vi": "지금 몇 시입니까?",
                    "zh": "现在几点？"
                }
            ]
        }
    ],
    "telex": [],
