    "grammar": [
        {
            "point": "「맛있다 / 맛없다」",
            "explain": "맛 = 味道，있다/없다 = 有/没有，合起来就是「好吃 / 不好吃」。正式体：맛있습니다 / 맛없습니다。主语用 이/가：음식이 맛있습니다（菜好吃）。注意맛없다 是「不好吃」，不是「没味道」。",
            "examples": [
                {
                    "vi": "한국 음식이 맛있습니다.",
                    "zh": "韩国菜好吃。"
                },
                {
                    "vi": "이 음식은 맛없습니다.",
                    "zh": "这个菜不好吃。"
                }
            ]
        },
        {
            "point": "「을/를 먹다 / 마시다」",
            "explain": "먹다 = 吃（固体），마시다 = 喝（液体）。宾语用 을/를：밥을 먹습니다（吃饭）、물을 마십니다（喝水）。正式体：먹습니다 / 마십니다（词干有收音 → -습니다）。中文「吃饭/喝水」动词不同，韩语也分 먹다/마시다，别混用。",
            "examples": [
                {
                    "vi": "밥을 먹습니다.",
                    "zh": "吃饭。"
                },
                {
                    "vi": "물을 마십니까?",
                    "zh": "喝水吗？"
                }
            ]
        }
    ],
