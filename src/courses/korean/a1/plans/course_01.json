  "grammar": [
    {
      "point": "「-(으)ㄹ 겁니까?」（打算…吗？）",
      "explain": "词干有收音用 -을 겁니까?，无收音用 -ㄹ 겁니까?：하다 → 할 겁니까?（打算做吗）；먹다 → 먹을 겁니까?（打算吃吗）。表将来计划或打算。肯定回答用「-(으)ㄹ 겁니다」。中文「打算/要」用这个词尾。",
      "examples": [
        {
          "vi": "주말에 무엇을 할 겁니까?",
          "zh": "周末打算做什么？"
        },
        {
          "vi": "영화를 볼 겁니다.",
          "zh": "打算看电影。"
        }
      ]
    },
    {
      "point": "时间 +「에」+ 动词",
      "explain": "时间名词后加 에 表「在…（时间）」：주말에（周末）、내일（明天，明天不加 에）、아침에（早上）。句序：时间 + 地点 + 宾语 + 动词。例：주말에 공원에서 친구를 만납니다（周末在公园见朋友）。",
      "examples": [
        {
          "vi": "주말에 공원에 갑니다.",
          "zh": "周末去公园。"
        },
        {
          "vi": "내일 친구를 만납니다.",
          "zh": "明天见朋友。"
        }
      ]
    }
  ],
