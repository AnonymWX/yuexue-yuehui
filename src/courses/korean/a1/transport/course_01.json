  "grammar": [
    {
      "point": "「N을/를 타다」+「에서 내리다」",
      "explain": "交通工具作宾语：버스를 타다（坐公交）、지하철을 타다（坐地铁）、택시를 타다（打车）。내리다 = 下车，前面接「场所 + 에서」：학교에서 내립니다（在学校下车）。注意 에 是位置，에서 是动作发生场所。",
      "examples": [
        {
          "vi": "버스를 탑니다.",
          "zh": "坐公交车。"
        },
        {
          "vi": "학교 앞에서 내립니다.",
          "zh": "在学校前下车。"
        }
      ]
    },
    {
      "point": "「어떻게 갑니까?」+「얼마나 걸립니까?」",
      "explain": "어떻게 = 怎么（问方式），가다 = 去。问「怎么去」用「어떻게 갑니까?」。얼마나 걸리다 = 花多久，问用时「얼마나 걸립니까?」。回答用时间 + 걸립니다，如 삼십 분 걸립니다（花三十分钟）。",
      "examples": [
        {
          "vi": "학교에 어떻게 갑니까?",
          "zh": "怎么去学校？"
        },
        {
          "vi": "삼십 분 걸립니다.",
          "zh": "花三十分钟。"
        }
      ]
    }
  ],
