    "grammar": [
        {
            "point": "场所指示代词「여기 / 거기 / 저기」+「어디」",
            "explain": "与第 2 课的物质指示代词对应：여기 = 这里（离说话人近）；거기 = 那里（离听话人近）；저기 = 那里（双方都远）。疑问词是 어디（哪里）。后接 은/는 时：여기는 / 거기는 / 저기는（都无收音）。中文只有「这里/那里」两级，注意 거기 与 저기 的远近差别。",
            "examples": [
                {
                    "vi": "여기는 학교입니다.",
                    "zh": "这里是学校。"
                },
                {
                    "vi": "거기는 어디입니까?",
                    "zh": "那里是哪里？"
                }
            ]
        },
        {
            "point": "位置助词「에」+「있습니다 / 없습니다」",
            "explain": "에 表示存在的位置（在/于）。存在用 있습니다，不存在用 없습니다。句型：N은/는 + 场所 + 에 + 있습니다/없습니다。例：저는 학교에 있습니다（我在学校）。화장실은 저기에 있습니다（洗手间在那边）。注意 에 与 은/는 的分工：은/는 标主题，에 标位置。",
            "examples": [
                {
                    "vi": "화장실은 저기에 있습니다.",
                    "zh": "洗手间在那边。"
                },
                {
                    "vi": "아니요, 집에 없습니다.",
                    "zh": "不，不在家。"
                }
            ]
        }
    ],
