    "grammar": [
        {
            "point": "「-아/어 보다」（尝试）",
            "explain": "词干 ㅏ/ㅗ 用 -아 보다，其他用 -어 보다，하다 用 -해 보다。表「尝试做某事」：가 보다 → 가 봅니다（去看看）、먹어 보다 → 먹어 봅니다（尝尝）、여행해 보다 → 여행해 봅니다（旅行看看）。正式体：-아/어 봅니다。",
            "examples": [
                {
                    "vi": "한국에 가 봅니다.",
                    "zh": "去韩国看看。"
                },
                {
                    "vi": "김치를 먹어 봅니다.",
                    "zh": "尝尝泡菜。"
                }
            ]
        },
        {
            "point": "「같이」（一起）+ 推荐表达",
            "explain": "같이 = 一起，修饰动词：같이 갑니다（一起去）、같이 여행합니다（一起旅行）。注意 같이 是副词，位置在动词前。邀请别人用「같이 ~(으)ㅂ시다」或「같이 ~(으)ㄹ까요?」，本课先掌握 같이 + 普通叙述。",
            "examples": [
                {
                    "vi": "같이 여행합니다.",
                    "zh": "一起旅行。"
                },
                {
                    "vi": "같이 사진을 찍습니다.",
                    "zh": "一起拍照。"
                }
            ]
        }
    ],
