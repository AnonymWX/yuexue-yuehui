    "grammar": [
        {
            "point": "「-아/어 놓다」（做好 / 放着）",
            "explain": "词干 ㅏ/ㅗ 用 -아 놓다，其他用 -어 놓다，하다 用 -해 놓다。表「做好某事后放着」或「保持某状态」。例：전화를 걸어 놓았습니다（已经打了电话放着）；숙제를 해 놓았습니다（作业做好了）。中文「做好了」对应这个结构。注意 놓았습니다 是过去时。",
            "examples": [
                {
                    "vi": "전화를 걸어 놓았습니다.",
                    "zh": "已经打好电话了。"
                },
                {
                    "vi": "문자를 보내 놓았습니다.",
                    "zh": "已经发好短信了。"
                }
            ]
        },
        {
            "point": "「-는 동안」（在…期间）",
            "explain": "动词词干 + 는 동안，表「在…期间」。例：기다리는 동안（在等的时候）；통화하는 동안（在通话期间）；자는 동안（在睡觉期间）。中文「…的时候 / 期间」对应。注意 동안 前接动词用 -는，接名词直接加 동안（방학 동안 放假期间）。",
            "examples": [
                {
                    "vi": "기다리는 동안 문자를 보냈습니다.",
                    "zh": "等的时候发了短信。"
                },
                {
                    "vi": "통화하는 동안 조용히 해 주세요.",
                    "zh": "通话期间请安静。"
                }
            ]
        }
    ],
