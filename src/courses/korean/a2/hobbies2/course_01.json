    "grammar": [
        {
            "point": "「-곤 하다」（经常做）",
            "explain": "动词词干 + 곤 하다，表「经常/有时会做」。例：등산을 곤 합니다（常去登山）；노래를 부르곤 합니다（常唱歌）。常与 자주（经常）、가끔（偶尔）搭配。中文「常常/有时会」对应。注意是 -곤 不是 -고，别混。",
            "examples": [
                {
                    "vi": "주말에는 등산을 곤 합니다.",
                    "zh": "周末常去登山。"
                },
                {
                    "vi": "가끔 낚시를 하곤 합니다.",
                    "zh": "偶尔钓鱼。"
                }
            ]
        },
        {
            "point": "「-(으)ㄹ 때」（…的时候）",
            "explain": "词干有收音用 -을 때，无收音用 -ㄹ 때。表「做…的时候」。例：시간이 있을 때（有时间的时候）；주말일 때（周末的时候）；심심할 때（无聊的时候）。中文「…的时候」对应。注意 때 前动词用 -ㄹ，形容词用 -(으)ㄴ。",
            "examples": [
                {
                    "vi": "시간이 있을 때 그림을 그립니다.",
                    "zh": "有时间的时候画画。"
                },
                {
                    "vi": "주말일 때 등산을 합니다.",
                    "zh": "周末的时候去登山。"
                }
            ]
        }
    ],
