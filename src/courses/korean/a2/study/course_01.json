    "grammar": [
        {
            "point": "「-기 때문에」（因为…所以）",
            "explain": "动词/形容词词干 + 기 때문에，表原因，比 -아/어서 更正式、更强调因果。例：바쁘기 때문에（因为忙）、시험이 있기 때문에（因为有考试）。注意：-기 때문에 后可接时态和命令/劝诱，而 -아/어서 不行。中文「因为…所以…」对应这个结构。",
            "examples": [
                {
                    "vi": "시험이 있기 때문에 공부해야 합니다.",
                    "zh": "因为要考试必须学习。"
                },
                {
                    "vi": "바쁘기 때문에 갈 수 없습니다.",
                    "zh": "因为忙不能去。"
                }
            ]
        },
        {
            "point": "「-기로 하다」（决定做…）",
            "explain": "动词词干 + 기로 하다，表「决定做某事」。例：공부하기로 했습니다（决定学习）；가기로 했습니다（决定去）；한국어를 배우기로 했습니다（决定学韩语）。中文「决定…」对应这个结构。注意是「决定」不是「打算」，打算用 -(으)ㄹ 겁니다。",
            "examples": [
                {
                    "vi": "도서관에서 공부하기로 했습니다.",
                    "zh": "决定在图书馆学习。"
                },
                {
                    "vi": "내일 시험을 준비하기로 했습니다.",
                    "zh": "决定准备明天的考试。"
                }
            ]
        }
    ],
