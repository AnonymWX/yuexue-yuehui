  "grammar": [
    {
      "point": "「-더라도」（即使…也）",
      "explain": "词干 + 더라도，表「即使…也」。例：어려워도 / 어렵더라도（即使难）；바쁘더라도（即使忙）。比 -아/어도 更书面、更强调让步。中文「即使…也」对应。注意 -더라도 前不能接时态。",
      "examples": [
        {
          "vi": "어렵더라도 계속 공부하겠습니다.",
          "zh": "即使难也会继续学习。"
        },
        {
          "vi": "바쁘더라도 복습해야 합니다.",
          "zh": "即使忙也必须复习。"
        }
      ]
    },
    {
      "point": "「-(으)ㄹ수록」（越…越）",
      "explain": "词干有收音用 -을수록，无收音用 -ㄹ수록。表「越…越…」。例：공부할수록（越学越）；어려울수록（越难越）；많을수록（越多越）。中文「越…越…」对应。常与 -아/어지다 搭配表变化：공부할수록 재미있어집니다（越学越有趣）。",
      "examples": [
        {
          "vi": "공부할수록 재미있어집니다.",
          "zh": "越学越有趣。"
        },
        {
          "vi": "어려울수록 포기하지 마세요.",
          "zh": "越难越不要放弃。"
        }
      ]
    }
  ],
