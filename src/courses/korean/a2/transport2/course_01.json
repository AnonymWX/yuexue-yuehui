    "grammar": [
        {
            "point": "「-는 길에」（在…路上）",
            "explain": "动词词干 + 는 길에，表「在做…的路上 / 顺便」。例：가다 → 가는 길에（去…的路上）；집에 가는 길에（回家路上）；오는 길에（来的路上）。中文「…的路上」对应。길 就是「路」，本课词条也收录。",
            "examples": [
                {
                    "vi": "집에 가는 길에 은행에 들렀습니다.",
                    "zh": "回家路上去了银行。"
                },
                {
                    "vi": "학교에 오는 길에 친구를 만났습니다.",
                    "zh": "来学校的路上遇到了朋友。"
                }
            ]
        },
        {
            "point": "方向词 + 「-쪽 / -에」",
            "explain": "方向词：왼쪽（左边）、오른쪽（右边）、앞（前）、뒤（后）、건너편（对面）。后接 에（位置）或 로（方向）：왼쪽에 있습니다（在左边）；오른쪽으로 가세요（往右走）。中文「往左/在右」对应。注意 쪽 是「方向」，可省略。",
            "examples": [
                {
                    "vi": "은행은 왼쪽에 있습니다.",
                    "zh": "银行在左边。"
                },
                {
                    "vi": "오른쪽으로 가세요.",
                    "zh": "请往右走。"
                }
            ]
        }
    ],
