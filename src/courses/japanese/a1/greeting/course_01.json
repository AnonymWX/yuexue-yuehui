    "grammar": [
        {
            "point": "判断句「N は N です」",
            "explain": "「は」是主题助词，读作 wa，标记句子的主题。「です」是判断助动词，表肯定。否定用「じゃありません」（口语）或「ではありません」（正式）。疑问句在句末加「か」。",
            "examples": [
                {
                    "vi": "私は学生です。",
                    "zh": "我是学生。"
                },
                {
                    "vi": "ミラーさんは会社員じゃありません。",
                    "zh": "米勒先生不是公司职员。"
                }
            ]
        },
        {
            "point": "疑问与「も」",
            "explain": "句末加「か」构成疑问，语序不变。「も」代替「は」，表「也」。注意回答用「はい」或「いいえ」。",
            "examples": [
                {
                    "vi": "ミラーさんは会社員ですか。",
                    "zh": "米勒先生是公司职员吗？"
                },
                {
                    "vi": "サントスさんも会社員です。",
                    "zh": "桑托斯先生也是公司职员。"
                }
            ]
        }
    ],
