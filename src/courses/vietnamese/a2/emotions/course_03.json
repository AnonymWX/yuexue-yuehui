  "grammar": [
    {
      "point": "使动表达：khiến / làm cho + 人 + 情绪",
      "explain": "「khiến + 人 + 情绪」= 使某人感到…（书面/中性）；「làm cho + 人 + 情绪」= 让某人感到…（口语更常用）。二者结构：主语（事/物）+ khiến/làm cho + 对象 + 情绪形容词。注意：khiến/làm cho 后必须接对象，不能省略。",
      "examples": [
        {
          "vi": "Tin này khiến tôi rất bất ngờ.",
          "zh": "这个消息让我非常意外。"
        },
        {
          "vi": "Câu chuyện của cô ấy làm cho tôi cảm động.",
          "zh": "她的故事让我感动。"
        },
        {
          "vi": "Thành công của con trai khiến bà ấy vô cùng tự hào.",
          "zh": "儿子的成功让她无比自豪。"
        }
      ]
    },
    {
      "point": "喜欢/在乎：thích / yêu / ghét / quan tâm",
      "explain": "「thích」= 喜欢（口语最常用）；「yêu」= 爱（强烈情感，多用于人或物）；「ghét」= 讨厌；「quan tâm」= 关心/在乎（有情感投入）。程度递增：thích thú（略感兴趣）< thích < rất thích < yêu。否定用 không: không thích / không quan tâm。",
      "examples": [
        {
          "vi": "Tôi rất thích đọc sách vào buổi tối.",
          "zh": "我很喜欢晚上读书。"
        },
        {
          "vi": "Anh ấy ghét phải chờ đợi người khác.",
          "zh": "他讨厌等人。"
        },
        {
          "vi": "Mẹ tôi luôn quan tâm đến sức khỏe của cả nhà.",
          "zh": "我妈妈总是关心全家人的健康。"
        }
      ]
    }
  ],
