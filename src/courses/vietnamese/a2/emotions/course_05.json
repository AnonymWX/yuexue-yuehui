    "grammar": [
        {
            "point": "赞美句式：...quá / ...lắm / thật là...",
            "explain": "赞美常用：「...quá!」= 太…了（形容词后）；「...lắm!」= 很…（口语）；「thật là...!」= 真是…！（形容词前）。三者语感：quá 最有感叹力，thật là 稍正式，lắm 最口语。注意不要滥用 quá，会显得夸张。",
            "examples": [
                {
                    "vi": "Bạn hát hay quá!",
                    "zh": "你唱得太好听了！"
                },
                {
                    "vi": "Chị hôm nay xinh lắm!",
                    "zh": "你今天很漂亮！"
                },
                {
                    "vi": "Anh thật là tài năng và thông minh.",
                    "zh": "你真是又有才华又聪明。"
                }
            ]
        },
        {
            "point": "感谢表达：cảm ơn / biết ơn / cảm kích",
            "explain": "程度递增：「cảm ơn」= 谢谢（日常）；「cảm ơn chân thành」= 衷心感谢（正式）；「biết ơn」= 感恩（深切的，多对恩人）；「cảm kích」= 感激（心受触动）。回应感谢：「Không có gì」（没什么）或「Có gì đâu」（哪的话）。",
            "examples": [
                {
                    "vi": "Cảm ơn chị đã giúp đỡ tôi rất nhiều.",
                    "zh": "非常感谢你帮了我很多。"
                },
                {
                    "vi": "Tôi vô cùng biết ơn thầy cô đã dạy dỗ tôi nên người.",
                    "zh": "我无比感恩老师们教导我成人。"
                },
                {
                    "vi": "Có gì đâu, chuyện nhỏ mà, bạn đừng khách sáo.",
                    "zh": "哪的话，小事而已，你别客气。"
                }
            ]
        }
    ],
