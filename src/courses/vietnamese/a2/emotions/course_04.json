    "grammar": [
        {
            "point": "鼓励句式：đừng / hãy / cố lên",
            "explain": "「đừng + V」= 别…（劝阻）；「hãy + V」= 请…吧（建议/命令，较强硬）；「cố lên!」= 加油（独立感叹句，最常用）。注意：「hãy」在口语中常省略，直接说动词更自然：「Cố gắng nhé!」（加油哦）。「nhé」放句末软化语气。",
            "examples": [
                {
                    "vi": "Đừng buồn nữa, mọi chuyện rồi sẽ ổn thôi.",
                    "zh": "别难过了，一切都会好起来的。"
                },
                {
                    "vi": "Hãy tin vào bản thân mình, bạn làm được mà.",
                    "zh": "请相信你自己，你能做到的。"
                },
                {
                    "vi": "Cố lên nhé, tôi luôn ở bên cạnh bạn!",
                    "zh": "加油哦，我一直都在你身边！"
                }
            ]
        },
        {
            "point": "安慰表达：tôi hiểu / tôi ở bên / sẽ ổn thôi",
            "explain": "温暖安慰句：「Tôi hiểu cảm giác của bạn」（我理解你的感受）；「Tôi ở bên cạnh bạn」（我在你身边）；「Mọi chuyện sẽ ổn thôi」（一切都会好的）。避免直接说「Đừng khóc」（别哭）等否定情绪的句子，会显得不体谅。",
            "examples": [
                {
                    "vi": "Tôi hiểu cảm giác của bạn lúc này, thật sự rất khó khăn.",
                    "zh": "我理解你现在的感受，确实很难。"
                },
                {
                    "vi": "Bạn không cô đơn đâu, tôi luôn ở bên cạnh bạn.",
                    "zh": "你并不孤单，我一直在你身边。"
                },
                {
                    "vi": "Thất bại chỉ là tạm thời, mọi chuyện rồi sẽ ổn thôi.",
                    "zh": "失败只是暂时的，一切都会好起来的。"
                }
            ]
        }
    ],
