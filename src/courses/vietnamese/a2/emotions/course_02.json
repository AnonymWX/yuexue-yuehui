  "grammar": [
    {
      "point": "对比句型：...thì..., nhưng...",
      "explain": "「A thì B, nhưng C」= A（虽然）是 B，但 C。「thì」在此作对比标记（非时态助词），强调前后对比。也可单用「nhưng」：「Anh ấy chăm chỉ nhưng ít nói.」（他勤奋但话少）。注意：thì 在此读重音，与时间助词 thì（时）不同。",
      "examples": [
        {
          "vi": "Anh trai tôi thì hướng ngoại, còn tôi thì ít nói hơn.",
          "zh": "我哥哥外向，而我比较话少。"
        },
        {
          "vi": "Cô ấy rất hài hước nhưng cũng rất nghiêm túc trong công việc.",
          "zh": "她很幽默，但在工作中也很严肃。"
        },
        {
          "vi": "Tính cách của hai chị em hoàn toàn khác nhau.",
          "zh": "两姐妹的性格完全不同。"
        }
      ]
    },
    {
      "point": "描述印象：có vẻ / trông / hình như",
      "explain": "「có vẻ」= 似乎、看上去（书面/中性）；「trông」= 看起来（口语，多指外观/神态）；「hình như」= 好像（不确定判断）。三者语气从强到弱：có vẻ ≈ trông > hình như。",
      "examples": [
        {
          "vi": "Anh ấy có vẻ là người rất thân thiện.",
          "zh": "他看上去是个很友好的人。"
        },
        {
          "vi": "Trông chị hơi mệt, chị có sao không?",
          "zh": "你看起来有点累，你还好吗？"
        },
        {
          "vi": "Hình như cô ấy là người khá kín đáo.",
          "zh": "她好像是个比较内向的人。"
        }
      ]
    }
  ],
