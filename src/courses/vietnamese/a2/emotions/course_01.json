    "grammar": [
        {
            "point": "表达感受：cảm thấy / thấy + 情绪",
            "explain": "「cảm thấy」= 感觉（较正式）；「thấy」= 觉得（口语常用）。二者都可接情绪形容词。结构：Tôi cảm thấy + 情绪；Tôi thấy + 情绪。强调原因可加 vì/bởi vì：「Tôi cảm thấy vui vì...」（我因为…而感到高兴）。",
            "examples": [
                {
                    "vi": "Hôm nay tôi cảm thấy rất vui vì được gặp bạn.",
                    "zh": "今天能见到你，我感到很高兴。"
                },
                {
                    "vi": "Tôi thấy hơi mệt mỏi sau một ngày làm việc.",
                    "zh": "工作一天之后我觉得有点累。"
                },
                {
                    "vi": "Cô ấy cảm thấy lo lắng vì kết quả thi sắp công bố.",
                    "zh": "她因为考试结果即将公布而感到担心。"
                }
            ]
        },
        {
            "point": "询问情绪：thế nào / có...không",
            "explain": "「Bạn cảm thấy thế nào?」= 你感觉怎样？「Bạn có vui không?」= 你高兴吗？前者开放，后者是非问句。「Dạo này bạn thế nào?」= 最近你怎样（问候）。回答用形容词直接答：Vui / Buồn / Bình thường。",
            "examples": [
                {
                    "vi": "Dạo này bạn cảm thấy thế nào?",
                    "zh": "最近你感觉怎样？"
                },
                {
                    "vi": "Nghe tin đó, bạn có ngạc nhiên không?",
                    "zh": "听到那个消息，你惊讶吗？"
                },
                {
                    "vi": "Sao trông anh buồn thế? Có chuyện gì à?",
                    "zh": "怎么看起来你很伤心？发生什么事了吗？"
                }
            ]
        }
    ],
