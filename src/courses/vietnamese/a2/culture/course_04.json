  "grammar": [
    {
      "point": "祝贺与哀悼：chúc mừng / chia buồn / xin chia buồn",
      "explain": "「Chúc mừng + 人/事」= 祝贺（婚礼、生日、升职）；「Chia buồn + với + 人」= 对…表示哀悼；「Xin chia buồn cùng gia đình」= 谨向家属表示哀悼（正式）。注意：婚丧场合用语绝不可混淆。",
      "examples": [
        {
          "vi": "Chúc mừng hạnh phúc của cô dâu chú rể!",
          "zh": "祝新郎新娘幸福！"
        },
        {
          "vi": "Tôi xin chia buồn cùng gia đình anh.",
          "zh": "谨向您家人表示哀悼。"
        },
        {
          "vi": "Chúc mừng năm mới, chúc anh và gia đình vạn sự như ý.",
          "zh": "新年快乐，祝您和家人万事如意。"
        }
      ]
    },
    {
      "point": "参加场合：dự / tham dự / đến",
      "explain": "参加活动三词：「dự」= 出席（正式，婚礼、会议）；「tham dự」= 参加（正式，同 dự）；「đến」= 来、到场（口语）。婚礼常用「đi đám cưới」（去参加婚礼），葬礼说「đi viếng」（去吊唁）。",
      "examples": [
        {
          "vi": "Tôi được mời dự đám cưới của bạn thân vào Chủ nhật.",
          "zh": "我受邀参加好朋友周日的婚礼。"
        },
        {
          "vi": "Anh có đến dự đám cưới của chị Lan không?",
          "zh": "你去参加兰姐的婚礼吗？"
        },
        {
          "vi": "Cả gia đình đi viếng ông nội của bạn tôi.",
          "zh": "全家人去吊唁我朋友的祖父。"
        }
      ]
    }
  ],
