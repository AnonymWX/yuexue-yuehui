    "grammar": [
        {
            "point": "习俗表达：có tục / theo phong tục / theo truyền thống",
            "explain": "「có tục + V」= 有…习俗；「theo phong tục」= 按照风俗；「theo truyền thống」= 按照传统。三者都可作状语。注意：「theo」在此表「依照」义，与「theo + 人」（跟随）不同。",
            "examples": [
                {
                    "vi": "Người Việt có tục thờ cúng tổ tiên trong nhà.",
                    "zh": "越南人有在家中供奉祖先的习俗。"
                },
                {
                    "vi": "Theo phong tục, con cháu phải chúc Tết ông bà vào ngày mùng một.",
                    "zh": "按照风俗，子孙要在大年初一给祖父母拜年。"
                },
                {
                    "vi": "Theo truyền thống, gia đình sum họp vào dịp Tết.",
                    "zh": "按照传统，春节时家人团聚。"
                }
            ]
        },
        {
            "point": "文化对比：giống / khác / cũng như",
            "explain": "对比用法：「giống」= 像、相同；「khác」= 不同；「cũng như」= 也如同（书面）。结构：「A giống B ở chỗ...」（A 与 B 相同在…）；「A khác B ở chỗ...」（A 与 B 不同在…）。A2 讨论文化差异高频。",
            "examples": [
                {
                    "vi": "Việt Nam và Trung Quốc đều có tục thờ cúng tổ tiên.",
                    "zh": "越南和中国都有供奉祖先的习俗。"
                },
                {
                    "vi": "Phong tục ăn Tết của Việt Nam có nhiều điểm khác với Trung Quốc.",
                    "zh": "越南的春节习俗与中国有很多不同。"
                },
                {
                    "vi": "Cũng như nhiều nước châu Á, Việt Nam coi trọng gia đình.",
                    "zh": "如同许多亚洲国家一样，越南重视家庭。"
                }
            ]
        }
    ],
