  "grammar": [
    {
      "point": "节庆时间：vào / trong dịp / nhân dịp",
      "explain": "「vào + 节日」= 在…节（具体日期）；「trong dịp + 节日」= 在…期间（一段时间）；「nhân dịp + 节日」= 值此…之际（正式书面）。前两者口语，第三者多用于致辞、贺卡。",
      "examples": [
        {
          "vi": "Vào Tết Nguyên Đán, cả nhà sum họp cùng nhau.",
          "zh": "春节时，全家人团聚在一起。"
        },
        {
          "vi": "Trong dịp Tết, người ta thường đi chúc Tết họ hàng.",
          "zh": "春节期间，人们常走亲访友拜年。"
        },
        {
          "vi": "Nhân dịp năm mới, tôi xin chúc gia đình anh nhiều sức khỏe.",
          "zh": "值此新年之际，我祝您全家身体健康。"
        }
      ]
    },
    {
      "point": "节庆习俗描述：thường / hay / có tục",
      "explain": "描述习俗三种表达：「thường + V」= 常常（一般性）；「hay + V」= 经常（口语）；「có tục + V」= 有…习俗（书面、说明风俗）。后接具体动作，如：có tục gói bánh chưng（有包粽子的习俗）。",
      "examples": [
        {
          "vi": "Người Việt thường gói bánh chưng vào dịp Tết.",
          "zh": "越南人春节时经常包方形粽子。"
        },
        {
          "vi": "Trẻ em rất thích được nhận lì xì vào ngày Tết.",
          "zh": "孩子们很喜欢在春节收到红包。"
        },
        {
          "vi": "Người Việt có tục xông đất vào ngày mùng một Tết.",
          "zh": "越南人有大年初一「冲地」的习俗。"
        }
      ]
    }
  ],
