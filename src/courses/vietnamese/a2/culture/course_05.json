  "grammar": [
    {
      "point": "信仰表达：tin vào / thờ / theo + 宗教",
      "explain": "「tin vào + 对象」= 相信…；「thờ + 对象」= 供奉…；「theo + 宗教」= 信仰…（宗教意义上）。注意：「theo」后面接宗教名，不接人：theo đạo Phật（信佛）、theo đạo Công giáo（信天主教）。「đạo」= 教，是宗教的通用名词。",
      "examples": [
        {
          "vi": "Phần lớn người Việt Nam theo đạo Phật hoặc không theo đạo nào.",
          "zh": "大多数越南人信佛教或不信仰任何宗教。"
        },
        {
          "vi": "Nhiều gia đình Việt Nam thờ tổ tiên và thần linh trong nhà.",
          "zh": "许多越南家庭在家中供奉祖先和神灵。"
        },
        {
          "vi": "Cô ấy tin vào nhân quả và luôn sống thiện lành.",
          "zh": "她相信因果，始终行善。"
        }
      ]
    },
    {
      "point": "宗教场所访问：viếng / cúng / cầu",
      "explain": "「viếng chùa」= 拜佛寺；「cúng」= 上供、祭拜；「cầu」= 求（cầu an 求平安、cầu tài 求财、cầu duyên 求姻缘）。在宗教场所要注意着装：không mặc áo ngắn（不穿短衣）、không nói to（不大声说话）。",
      "examples": [
        {
          "vi": "Vào ngày rằm, nhiều người đi chùa để cầu an cho gia đình.",
          "zh": "月圆之日，很多人去寺庙为家人求平安。"
        },
        {
          "vi": "Khách du lịch nên ăn mặc lịch sự khi viếng chùa.",
          "zh": "游客参拜寺庙时应着装得体。"
        },
        {
          "vi": "Mọi người cúng hoa quả và hương trước bàn thờ.",
          "zh": "人们在供桌前供奉水果和香。"
        }
      ]
    }
  ],
