  "grammar": [
    {
      "point": "介绍特产：nổi tiếng / nổi tiếng với / đặc sản của",
      "explain": "「nổi tiếng」= 著名（形容词）；「nổi tiếng với + 名词」= 以…而著名；「đặc sản của + 地方」= …的特产。介绍美食时高频：「Phở là đặc sản nổi tiếng của Việt Nam」（河粉是越南著名的特产）。",
      "examples": [
        {
          "vi": "Phở là món ăn nổi tiếng nhất của Việt Nam.",
          "zh": "河粉是越南最著名的菜肴。"
        },
        {
          "vi": "Huế nổi tiếng với các món ăn cung đình.",
          "zh": "顺化以宫廷菜著名。"
        },
        {
          "vi": "Bánh mì là đặc sản đường phố của Sài Gòn.",
          "zh": "法棍面包是西贡的街头特产。"
        }
      ]
    },
    {
      "point": "饮食描述：có vị / ăn kèm / chấm",
      "explain": "「có vị + 味觉」= 有…味道（có vị cay 辣味、có vị ngọt 甜味）；「ăn kèm + 食物」= 搭配…一起吃；「chấm + 酱」= 蘸…。三个都是越南饮食描述高频词。",
      "examples": [
        {
          "vi": "Món này có vị chua ngọt rất ngon.",
          "zh": "这道菜酸甜可口，很好吃。"
        },
        {
          "vi": "Phở thường ăn kèm với rau thơm và giá đỗ.",
          "zh": "河粉通常配香菜和豆芽一起吃。"
        },
        {
          "vi": "Người Việt hay chấm trái cây với muối ớt.",
          "zh": "越南人常把水果蘸辣椒盐吃。"
        }
      ]
    }
  ],
