    "grammar": [
        {
            "point": "材料与来源：được làm bằng / có nguồn gốc từ",
            "explain": "「được làm bằng + 材料」= 由…制成（被动）；「có nguồn gốc từ + 地方/时间」= 起源于…。前者描述工艺材料，后者描述历史来源。注意：làm bằng 用于材料，làm từ 也可（稍书面），làm bởi 用于人。",
            "examples": [
                {
                    "vi": "Nón lá được làm bằng lá cọ và tre.",
                    "zh": "斗笠用棕叶和竹子制成。"
                },
                {
                    "vi": "Áo dài có nguồn gốc từ trang phục truyền thống của người Việt.",
                    "zh": "奥黛起源于越南人的传统服饰。"
                },
                {
                    "vi": "Múa rối nước là loại hình nghệ thuật có nguồn gốc từ đồng bằng Bắc Bộ.",
                    "zh": "水上木偶戏是起源于北部平原的艺术形式。"
                }
            ]
        },
        {
            "point": "文化传承：giữ gìn / bảo tồn / truyền lại",
            "explain": "「giữ gìn」= 维护、保持（口语）；「bảo tồn」= 保护、保存（正式，多指文化遗产）；「truyền lại」= 传承、留给后代。三者常用于文化讨论：「giữ gìn bản sắc」（保持本色）、「bảo tồn di sản」（保护遗产）、「truyền lại cho con cháu」（传给子孙）。",
            "examples": [
                {
                    "vi": "Chúng ta cần giữ gìn và phát huy bản sắc văn hóa dân tộc.",
                    "zh": "我们需要保持并发扬民族文化的本色。"
                },
                {
                    "vi": "UNESCO đã công nhận và bảo tồn nhiều di sản văn hóa Việt Nam.",
                    "zh": "联合国教科文组织已认可并保护多项越南文化遗产。"
                },
                {
                    "vi": "Ông bà tôi truyền lại nghề làm nón cho con cháu.",
                    "zh": "我的祖父母把做斗笠的手艺传给了子孙。"
                }
            ]
        }
    ],
