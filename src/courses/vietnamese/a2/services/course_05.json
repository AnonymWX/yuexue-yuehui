  "grammar": [
    {
      "point": "表达不满：không hài lòng về / có vấn đề về",
      "explain": "「Tôi không hài lòng về + 名词」= 我对…不满意；「Có vấn đề về + 名词」= 在…方面有问题；「Tôi muốn phàn nàn về...」= 我想投诉…。注意：「về」在此表「关于」，不能省略。正式书面可加「xin」（Tôi xin phàn nàn về...）。",
      "examples": [
        {
          "vi": "Tôi không hài lòng về chất lượng của sản phẩm này.",
          "zh": "我对这个产品的质量不满意。"
        },
        {
          "vi": "Sản phẩm này có vấn đề về chất lượng, tôi muốn đổi.",
          "zh": "这个产品在质量上有问题，我想换。"
        },
        {
          "vi": "Tôi muốn phàn nàn về dịch vụ của nhà hàng này.",
          "zh": "我想投诉这家餐厅的服务。"
        }
      ]
    },
    {
      "point": "要求退换：đổi / trả / hoàn tiền",
      "explain": "「đổi」= 换（换同款或不同款）；「trả」= 退（把商品退回）；「hoàn tiền」= 退款。三者在购物投诉场景中高频。结构：「Tôi muốn + đổi/trả/hoàn tiền + 名词」。保留 hóa đơn（发票）和 biên lai（收据）是退换的前提。",
      "examples": [
        {
          "vi": "Sản phẩm bị lỗi, tôi muốn đổi cái khác.",
          "zh": "产品有缺陷，我想换一个。"
        },
        {
          "vi": "Tôi muốn trả hàng và yêu cầu hoàn tiền.",
          "zh": "我想退货并要求退款。"
        },
        {
          "vi": "Nếu không đổi được, tôi muốn hoàn lại tiền.",
          "zh": "如果不能换，我想退款。"
        }
      ]
    }
  ],
