    "grammar": [
        {
            "point": "寄送地点：gửi đến / gửi tới / gửi về",
            "explain": "三者都表示「寄往」，区别在语感：đến（最中性，通用）；tới（口语，与 đến 基本可换）；về（偏向「寄回」，有返回意味）。结构：「gửi + 物 + đến/tới/về + 地点/人」。例：gửi thư đến Hà Nội（寄信到河内）；gửi quà về quê（寄礼物回老家）。",
            "examples": [
                {
                    "vi": "Tôi muốn gửi gói hàng này đến thành phố Hồ Chí Minh.",
                    "zh": "我想把这个包裹寄到胡志明市。"
                },
                {
                    "vi": "Cô ấy gửi quà về quê cho bố mẹ.",
                    "zh": "她寄礼物回老家给父母。"
                },
                {
                    "vi": "Tôi cần gửi bưu thiếp tới bạn tôi ở Đà Nẵng.",
                    "zh": "我需要寄一张明信片给我在岘港的朋友。"
                }
            ]
        },
        {
            "point": "询问时间与费用：mất bao lâu / bao nhiêu tiền",
            "explain": "「mất bao lâu」= 要多久（时间）；「bao nhiêu tiền」= 多少钱（费用）。在邮局场景高频。「khoảng」= 大约，「ít nhất」= 至少，「tối đa」= 最多。可与「chuyển phát nhanh」（快递）对比「gửi thường」（平邮）的速度与费用。",
            "examples": [
                {
                    "vi": "Gửi chuyển phát nhanh đến Hà Nội mất bao lâu?",
                    "zh": "寄快递到河内要多久？"
                },
                {
                    "vi": "Gửi thường rẻ hơn nhưng mất khoảng một tuần.",
                    "zh": "平邮便宜些，但要大约一周。"
                },
                {
                    "vi": "Phí gửi gói hàng này là bao nhiêu tiền?",
                    "zh": "寄这个包裹要多少钱？"
                }
            ]
        }
    ],
