    "grammar": [
        {
            "point": "礼貌提出需求：muốn / cần / có thể",
            "explain": "「Tôi muốn + V」= 我想做…（表达意愿）；「Tôi cần + V」= 我需要做…（客观必要）；「Tôi có thể + V + không?」= 我可以…吗？（请求许可）。三者语气从软到硬：có thể（最礼貌）< muốn（直接表达）< cần（强调必要）。",
            "examples": [
                {
                    "vi": "Tôi muốn mở một tài khoản ngân hàng mới.",
                    "zh": "我想开一个新的银行账户。"
                },
                {
                    "vi": "Tôi cần rút tiền mặt, cây ATM ở đâu ạ?",
                    "zh": "我需要取现金，ATM 在哪里？"
                },
                {
                    "vi": "Tôi có thể chuyển tiền cho người khác bằng ứng dụng không?",
                    "zh": "我可以用应用给别人转账吗？"
                }
            ]
        },
        {
            "point": "询问费用/汇率：bao nhiêu / mất phí gì không",
            "explain": "「…bao nhiêu tiền?」= …多少钱？「có mất phí không?」= 要收费吗？「phí giao dịch là bao nhiêu?」= 手续费是多少？注意：「mất phí」中的 mất 是「花费」义，不是「丢失」。回答可用「miễn phí」（免费）或「X nghìn đồng」（X 千盾）。",
            "examples": [
                {
                    "vi": "Phí chuyển tiền là bao nhiêu ạ?",
                    "zh": "转账手续费是多少？"
                },
                {
                    "vi": "Mở tài khoản có mất phí gì không?",
                    "zh": "开户要收费吗？"
                },
                {
                    "vi": "Tỷ giá đổi đô la Mỹ hôm nay là bao nhiêu?",
                    "zh": "今天美元汇率是多少？"
                }
            ]
        }
    ],
