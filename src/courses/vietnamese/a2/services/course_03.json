    "grammar": [
        {
            "point": "程度副词：vừa / hơi / quá",
            "explain": "「vừa」= 刚好、合适（程度恰好）；「hơi」= 稍微（轻度过量）；「quá」= 太（明显过量）。三者位置：都放形容词前（hơi 只能在前，quá 可在前也可在后）。理发场景高频：「cắt hơi ngắn quá」= 剪得有点太短了。",
            "examples": [
                {
                    "vi": "Độ dài này vừa đẹp, không cần cắt thêm.",
                    "zh": "这个长度刚好，不用再剪了。"
                },
                {
                    "vi": "Anh cắt hơi ngắn, làm ơn để dài hơn một chút.",
                    "zh": "你剪得有点短，请留长一点。"
                },
                {
                    "vi": "Tóc tôi dài quá rồi, cần cắt bớt khoảng năm phân.",
                    "zh": "我头发太长了，需要剪掉大约五厘米。"
                }
            ]
        },
        {
            "point": "礼貌指令：làm ơn / xin / giúp tôi",
            "explain": "「Làm ơn + V」= 请…（书面/较正式）；「Xin + V」= 请…（更正式）；「V + giúp tôi」= 帮我做…（口语自然）。在理发店建议用软语，如「Làm ơn cắt ngắn hơn một chút」比「Cắt ngắn hơn」更礼貌。",
            "examples": [
                {
                    "vi": "Làm ơn cắt tóc cho tôi ngắn hơn khoảng ba phân.",
                    "zh": "请帮我把头发剪短大约三厘米。"
                },
                {
                    "vi": "Xin gội đầu và sấy tóc giúp tôi.",
                    "zh": "请帮我洗头和吹干。"
                },
                {
                    "vi": "Giúp tôi tỉa phần tóc mái một chút.",
                    "zh": "帮我修一下刘海。"
                }
            ]
        }
    ],
