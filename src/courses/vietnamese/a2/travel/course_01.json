  "grammar": [
    {
      "point": "乘坐方式：đi bằng / đi + 工具",
      "explain": "两种表达：「đi bằng + 交通工具」（= 坐…去，bằng 强调方式），「đi + 交通工具」（口语简洁）。如：đi bằng xe buýt = đi xe buýt。注意「đi bộ」是特例（步行，不加 bằng）。问句：「đi bằng gì?」= 坐什么去？",
      "examples": [
        {
          "vi": "Tôi đi làm bằng xe buýt mỗi ngày.",
          "zh": "我每天坐公交车上班。"
        },
        {
          "vi": "Từ Hà Nội đến Huế đi tàu hỏa mất khoảng 13 tiếng.",
          "zh": "从河内到顺化坐火车大约 13 小时。"
        },
        {
          "vi": "Bạn thường đi học bằng gì?",
          "zh": "你通常坐什么去上学？"
        }
      ]
    },
    {
      "point": "问时长：mất bao lâu / mất bao nhiêu thời gian",
      "explain": "「mất + 时长」= 花费…时间；「mất bao lâu?」= 要花多久？mất 在此是「耗费」义，主语是行程或路程。注意与汉语对比：汉语「从 A 到 B 要多久」，越南语说「Từ A đến B mất bao lâu?」顺序相反。",
      "examples": [
        {
          "vi": "Từ đây đến sân bay mất bao lâu?",
          "zh": "从这里到机场要多久？"
        },
        {
          "vi": "Đi xe máy từ nhà đến chợ mất khoảng 15 phút.",
          "zh": "从家骑摩托车到市场大约 15 分钟。"
        },
        {
          "vi": "Đi bộ đến ga tàu mất 10 phút, không xa lắm.",
          "zh": "步行到火车站要 10 分钟，不算远。"
        }
      ]
    }
  ],
