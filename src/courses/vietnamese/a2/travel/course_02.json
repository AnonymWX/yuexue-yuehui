    "grammar": [
        {
            "point": "问处所：ở đâu? / như thế nào?",
            "explain": "「ở đâu?」= 在哪里（问位置，问点）；「đi như thế nào?」= 怎么走（问路线）；「đi đường nào?」= 走哪条路。回答用「ở + 处所」「đi theo đường + 路名 + rẽ trái/phải」。注意：đâu 在句末，thế nào 也在句末。",
            "examples": [
                {
                    "vi": "Cho tôi hỏi, nhà ga ở đâu ạ?",
                    "zh": "请问，火车站在哪里？"
                },
                {
                    "vi": "Bạn có thể chỉ cho tôi đường đến chợ Bến Thành không?",
                    "zh": "你能告诉我去滨城市场的路吗？"
                },
                {
                    "vi": "Đi từ đây đến bưu điện như thế nào?",
                    "zh": "从这里到邮局怎么走？"
                }
            ]
        },
        {
            "point": "方位词：trước / sau / bên cạnh / đối diện / giữa",
            "explain": "trước = 前、sau = 后、bên cạnh = 旁边、đối diện = 对面、giữa = 中间、gần = 近、xa = 远。结构：「处所 A + ở + 方位词 + 处所 B」，如「ngân hàng ở bên cạnh chợ」（银行在市场旁边）。注意：方位词与处所间不用「của」。",
            "examples": [
                {
                    "vi": "Hiệu thuốc ở đối diện bệnh viện.",
                    "zh": "药店在医院对面。"
                },
                {
                    "vi": "Ngân hàng ở bên cạnh chợ Bến Thành, rất dễ tìm.",
                    "zh": "银行在滨城市场旁边，很好找。"
                },
                {
                    "vi": "Trường học nằm giữa công viên và bệnh viện.",
                    "zh": "学校在公园和医院之间。"
                }
            ]
        }
    ],
