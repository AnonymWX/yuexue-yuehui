    "grammar": [
        {
            "point": "允许/禁止：được phép / không được phép / bị phạt",
            "explain": "「được phép + V」= 被允许做…（正面被动，正式）；「không được phép + V」= 不允许做…；「bị phạt vì + V」= 因…被罚款。注意：口语中「được phép」常简化为「được」，但正式文本仍保留完整形式。",
            "examples": [
                {
                    "vi": "Ở Việt Nam, người nước ngoài được phép lái xe nếu có bằng lái quốc tế.",
                    "zh": "在越南，外国人如有国际驾照就可以开车。"
                },
                {
                    "vi": "Bạn không được phép uống rượu bia khi lái xe.",
                    "zh": "开车时不许喝酒。"
                },
                {
                    "vi": "Anh ấy bị phạt vì chạy quá tốc độ.",
                    "zh": "他因超速被罚款。"
                }
            ]
        },
        {
            "point": "交通规则常用：nên / phải / cần",
            "explain": "规劝用 nên（应该）：Bạn nên đội mũ bảo hiểm（你应该戴头盔）；强制用 phải（必须）：Phải giảm tốc độ ở khu dân cư；客观需要 cần（需要）：Cần đổ xăng trước khi đi xa。三者可叠加：phải nhớ / cần nhớ。",
            "examples": [
                {
                    "vi": "Bạn phải đội mũ bảo hiểm khi đi xe máy.",
                    "zh": "骑摩托车时必须戴头盔。"
                },
                {
                    "vi": "Ở gần trường học, bạn nên giảm tốc độ xuống dưới 30 km/h.",
                    "zh": "在学校附近，你应该把速度降到 30 公里/小时以下。"
                },
                {
                    "vi": "Trước khi đi đường dài, bạn cần kiểm tra xăng và lốp xe.",
                    "zh": "跑长途之前，你需要检查汽油和轮胎。"
                }
            ]
        }
    ],
