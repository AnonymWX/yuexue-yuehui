    "grammar": [
        {
            "point": "礼貌请求：có thể...không? / xin / làm ơn",
            "explain": "「Bạn có thể + V + không?」= 你能…吗？（最常用礼貌请求）；「Xin + V」= 请…（更正式）；「Làm ơn + V」= 劳驾…（书面/正式）。注意：「có...không」是一种「yes/no」问句结构，回答「Có」（有/可以）或「Không」（没有/不行）。",
            "examples": [
                {
                    "vi": "Bạn có thể cho tôi xem phòng không?",
                    "zh": "你能让我看看房间吗？"
                },
                {
                    "vi": "Xin vui lòng cho tôi mượn một chiếc ô.",
                    "zh": "请借我一把伞。"
                },
                {
                    "vi": "Làm ơn đưa giúp tôi hành lý lên phòng.",
                    "zh": "劳驾帮我把行李送到房间。"
                }
            ]
        },
        {
            "point": "询问设施：có...không?",
            "explain": "问是否有某物/某服务：「Khách sạn có + 名词 + không?」（酒店有…吗？）；「Phòng có + 名词 + không?」（房间有…吗？）。回答：Có（有）/ Không（没有）/ Không có（不提供）。可加「ạ」表示礼貌。",
            "examples": [
                {
                    "vi": "Khách sạn này có hồ bơi không ạ?",
                    "zh": "这家酒店有游泳池吗？"
                },
                {
                    "vi": "Phòng có wifi miễn phí không?",
                    "zh": "房间有免费 Wi-Fi 吗？"
                },
                {
                    "vi": "Ở đây có dịch vụ giặt ủi không?",
                    "zh": "这里有洗衣服务吗？"
                }
            ]
        }
    ],
