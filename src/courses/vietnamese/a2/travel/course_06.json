    "grammar": [
        {
            "point": "紧急求助句式：giúp tôi với! / cứu tôi với!",
            "explain": "「giúp tôi với!」= 帮帮我！（最常用）；「cứu tôi với!」= 救救我！（更紧急）；「làm ơn giúp tôi」= 请帮帮我（较礼貌）。「với」在句末加强恳求语气，不可省略。报警用 113（警察）、115（急救）、114（消防）。",
            "examples": [
                {
                    "vi": "Giúp tôi với! Tôi bị mất hộ chiếu rồi!",
                    "zh": "帮帮我！我的护照丢了！"
                },
                {
                    "vi": "Cứu tôi với! Có người bị tai nạn ở đây!",
                    "zh": "救命！这里有人出事故了！"
                },
                {
                    "vi": "Làm ơn gọi cấp cứu 115 giúp tôi, tôi cảm thấy rất khó thở.",
                    "zh": "请帮我打 115 叫救护车，我感觉呼吸困难。"
                }
            ]
        },
        {
            "point": "描述被偷/被抢：bị + 动词",
            "explain": "bị 表遭遇负面事件：bị trộm（被偷，常用 bị mất 更自然）/ bị cướp（被抢）/ bị lừa（被骗）。结构：「Chủ thể + bị + 名词 + V」= 主语被…（发生）了。报警时必须说明：时间、地点、丢失物品、特征。",
            "examples": [
                {
                    "vi": "Tôi bị mất ví ở chợ Bến Thành, trong ví có hộ chiếu và tiền mặt.",
                    "zh": "我在滨城市场丢了钱包，里面有护照和现金。"
                },
                {
                    "vi": "Điện thoại của tôi bị cướp khi tôi đang đi bộ trên đường.",
                    "zh": "我走在路上时手机被抢了。"
                },
                {
                    "vi": "Cô ấy bị lừa mua tour giả với giá rất cao.",
                    "zh": "她被骗以高价买了假旅游团。"
                }
            ]
        }
    ],
