    "grammar": [
        {
            "point": "先后顺序：trước khi / sau khi",
            "explain": "「trước khi + V」= 在…之前；「sau khi + V」= 在…之后。注意：这两个词组后面跟动词原形，不跟完整小句；如果要接完整句用「trước khi mà / sau khi mà」（少用）。例：trước khi lên máy bay = 登机前；sau khi hạ cánh = 降落后。",
            "examples": [
                {
                    "vi": "Trước khi lên máy bay, bạn phải qua cửa an ninh.",
                    "zh": "登机前，你必须过安检。"
                },
                {
                    "vi": "Sau khi hạ cánh, hành khách sẽ lấy hành lý ở băng chuyền số 5.",
                    "zh": "降落后，乘客将在 5 号转盘取行李。"
                },
                {
                    "vi": "Trước khi đi du lịch, tôi thường kiểm tra hộ chiếu và visa.",
                    "zh": "旅游前我通常检查护照和签证。"
                }
            ]
        },
        {
            "point": "应对延误/问题：bị / xin lỗi vì / có thể...không",
            "explain": "航班延误：「Chuyến bay bị hoãn」（航班被延误）；行李丢失：「Hành lý của tôi bị thất lạc」（我的行李丢失了）。交涉时常用：「Xin lỗi, chuyến bay của tôi bị hoãn, tôi có thể...？」（抱歉，我的航班延误了，我可以…？）。注意：正式场合「quý khách」= 尊敬的乘客。",
            "examples": [
                {
                    "vi": "Xin lỗi, chuyến bay của tôi bị hoãn hai tiếng, tôi có thể đổi chuyến khác không?",
                    "zh": "抱歉，我的航班延误两小时，我可以换航班吗？"
                },
                {
                    "vi": "Hành lý của tôi bị thất lạc, tôi phải liên hệ với ai?",
                    "zh": "我的行李丢了，我该联系谁？"
                },
                {
                    "vi": "Quý khách lưu ý, chuyến bay VN123 sẽ khởi hành sau ba mươi phút nữa.",
                    "zh": "各位乘客请注意，VN123 航班将在三十分钟后起飞。"
                }
            ]
        }
    ],
