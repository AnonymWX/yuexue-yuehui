    "grammar": [
        {
            "point": "招聘表达：tuyển / cần tuyển / đang tuyển",
            "explain": "「tuyển」= 招（招人）；「cần tuyển」= 需要招；「đang tuyển」= 正在招。招聘广告常见结构：「Công ty X cần tuyển + 职位 + 数量」。应聘方说：「Tôi muốn ứng tuyển vào vị trí...」（我想应聘…岗位）。注意：「tuyển dụng」是名词，「tuyển」是动词。",
            "examples": [
                {
                    "vi": "Công ty này đang tuyển hai nhân viên kinh doanh.",
                    "zh": "这家公司正在招两名销售。"
                },
                {
                    "vi": "Chúng tôi cần tuyển người có kinh nghiệm ít nhất hai năm.",
                    "zh": "我们需要招至少有两年经验的人。"
                },
                {
                    "vi": "Tôi muốn ứng tuyển vào vị trí phiên dịch tiếng Việt.",
                    "zh": "我想应聘越南语翻译岗位。"
                }
            ]
        },
        {
            "point": "求职常用：xin việc / tìm việc / ứng tuyển",
            "explain": "「xin việc」= 求职（强调申请）；「tìm việc」= 找工作（强调寻找过程）；「ứng tuyển」= 应聘（正式，向某岗位投递）。三者句法：「xin việc ở/tại + 公司」「tìm việc + 地点」「ứng tuyển vào + 职位」。",
            "examples": [
                {
                    "vi": "Tôi đang tìm việc làm thêm vào buổi tối.",
                    "zh": "我正在找晚上的兼职。"
                },
                {
                    "vi": "Cô ấy xin việc ở một công ty xuất nhập khẩu.",
                    "zh": "她在一家进出口公司求职。"
                },
                {
                    "vi": "Tôi đã ứng tuyển vào ba công ty khác nhau.",
                    "zh": "我已经向三家公司投了简历。"
                }
            ]
        }
    ],
