    "grammar": [
        {
            "point": "自我介绍：Tôi là / Tôi có / Tôi tốt nghiệp",
            "explain": "自我介绍三种结构：「Tôi là + 名字/职业」= 我是…；「Tôi có + 经验/技能」= 我有…；「Tôi tốt nghiệp + 学校/专业」= 我毕业于…。加「đã từng」（曾经）可描述过去经历：「Tôi đã từng làm việc ở...」（我曾在…工作过）。",
            "examples": [
                {
                    "vi": "Tôi là Nguyễn Văn Nam, tốt nghiệp Đại học Ngoại thương.",
                    "zh": "我是阮文南，毕业于对外贸易大学。"
                },
                {
                    "vi": "Tôi có ba năm kinh nghiệm trong lĩnh vực xuất nhập khẩu.",
                    "zh": "我在进出口领域有三年经验。"
                },
                {
                    "vi": "Tôi đã từng làm việc ở một công ty Nhật Bản hai năm.",
                    "zh": "我曾在日本公司工作过两年。"
                }
            ]
        },
        {
            "point": "礼貌提问：cho tôi hỏi / tôi có thể hỏi",
            "explain": "面试末尾提问环节常用：「Cho tôi hỏi về...」= 请问关于…；「Tôi có thể hỏi về... không?」= 我能问一下关于…吗？注意：面试中问问题显示你对公司的兴趣，但要避开过早问薪水和假期。",
            "examples": [
                {
                    "vi": "Cho tôi hỏi về quy trình làm việc ở công ty mình.",
                    "zh": "请问贵公司的工作流程是怎样的。"
                },
                {
                    "vi": "Tôi có thể hỏi về cơ hội thăng tiến trong công ty không?",
                    "zh": "我能问一下公司内部的晋升机会吗？"
                },
                {
                    "vi": "Cho tôi hỏi khi nào tôi sẽ nhận được kết quả phỏng vấn?",
                    "zh": "请问我什么时候能收到面试结果？"
                }
            ]
        }
    ],
