    "grammar": [
        {
            "point": "委婉表达辞职：xin / muốn / quyết định",
            "explain": "「Tôi xin nghỉ việc」= 我请求辞职（正式、谦恭）；「Tôi muốn nghỉ việc」= 我想辞职（口语）；「Tôi quyết định chuyển việc」= 我决定换工作（说明决定）。注意：xin 表示恭敬地请示，越南语辞职信通常用 xin。",
            "examples": [
                {
                    "vi": "Tôi xin gửi đơn nghỉ việc lên phòng nhân sự.",
                    "zh": "我向人事部提交辞职信。"
                },
                {
                    "vi": "Tôi quyết định chuyển việc vì muốn phát triển bản thân hơn.",
                    "zh": "我决定换工作是因为想让自己更好地发展。"
                },
                {
                    "vi": "Tôi muốn thông báo trước một tháng theo đúng quy định.",
                    "zh": "我想按公司规定提前一个月通知。"
                }
            ]
        },
        {
            "point": "保持礼貌：cảm ơn / rất tiếc / hy vọng",
            "explain": "辞职时得体表达：「Cảm ơn công ty đã tạo điều kiện cho tôi...」（感谢公司给我…的机会）；「Tôi rất tiếc phải rời công ty」（很遗憾要离开公司）；「Hy vọng chúng ta vẫn giữ liên lạc」（希望我们保持联系）。避免吐槽公司或同事。",
            "examples": [
                {
                    "vi": "Cảm ơn anh chị đã giúp đỡ tôi trong suốt thời gian qua.",
                    "zh": "感谢各位一直以来的帮助。"
                },
                {
                    "vi": "Tôi rất tiếc phải rời công ty, nhưng đây là quyết định của tôi.",
                    "zh": "很遗憾要离开公司，但这是我的决定。"
                },
                {
                    "vi": "Hy vọng chúng ta vẫn giữ liên lạc sau khi tôi chuyển việc.",
                    "zh": "希望我换工作后我们仍然保持联系。"
                }
            ]
        }
    ],
