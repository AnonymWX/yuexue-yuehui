    "grammar": [
        {
            "point": "商务邮件格式：kính gửi / trân trọng",
            "explain": "越南语商务邮件格式：开头「Kính gửi + 称谓/公司」（尊敬的…）；结尾「Trân trọng」（谨启）或「Trân trọng cảm ơn」（谨此致谢）。较随和的同事邮件可用「Chào anh/chị」（你好）+「Cảm ơn anh/chị」（感谢）。注意：kính gửi 比 chào 正式得多。",
            "examples": [
                {
                    "vi": "Kính gửi anh Nam, tôi xin gửi anh báo cáo tháng này.",
                    "zh": "尊敬的南先生，我向您发送本月报告。"
                },
                {
                    "vi": "Trân trọng cảm ơn anh đã phản hồi sớm.",
                    "zh": "衷心感谢您及时回复。"
                },
                {
                    "vi": "Chào chị Lan, em gửi chị file đính kèm, chị kiểm tra giúp em nhé.",
                    "zh": "兰姐你好，我把附件发给你，请帮我检查一下。"
                }
            ]
        },
        {
            "point": "电话沟通：xin nghe / làm ơn nhắc lại",
            "explain": "接电话：「Xin nghe, tôi là...」（您好，我是…，正式）；「Alo, tôi là...」（喂，我是…，口语）。请求重复：「Làm ơn nhắc lại giúp tôi」（请帮我再说一遍）；「Xin lỗi, tôi chưa nghe rõ」（抱歉，我没听清）。留言：「Tôi có thể để lại lời nhắn không?」（我可以留言吗？）",
            "examples": [
                {
                    "vi": "Xin nghe, tôi là Minh từ công ty ABC.",
                    "zh": "您好，我是 ABC 公司的明。"
                },
                {
                    "vi": "Xin lỗi, tôi chưa nghe rõ, làm ơn nhắc lại giúp tôi.",
                    "zh": "抱歉，我没听清，请帮我再说一遍。"
                },
                {
                    "vi": "Anh ấy đang họp, chị có muốn để lại lời nhắn không?",
                    "zh": "他正在开会，你想留言吗？"
                }
            ]
        }
    ],
