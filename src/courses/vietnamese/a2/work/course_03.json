    "grammar": [
        {
            "point": "礼貌请求：nhờ / làm ơn / phiền",
            "explain": "「nhờ + 人 + V」= 拜托某人做…（口语、亲近）；「làm ơn + V」= 请做…（正式、礼貌）；「phiền + 人 + V」= 麻烦某人做…（客气，稍显正式）。「phiền」后常接「anh/chị/em」等称谓。三者礼貌度：phiền > làm ơn > nhờ。",
            "examples": [
                {
                    "vi": "Tôi nhờ anh kiểm tra lại báo cáo giúp tôi.",
                    "zh": "我拜托你帮我再检查一遍报告。"
                },
                {
                    "vi": "Phiền chị gửi lại file cho tôi qua email.",
                    "zh": "麻烦你把文件通过邮件再发给我。"
                },
                {
                    "vi": "Làm ơn cho tôi biết khi nào cần nộp báo cáo.",
                    "zh": "请告诉我报告什么时候需要交。"
                }
            ]
        },
        {
            "point": "汇报进度：đã / đang / sẽ + V",
            "explain": "汇报工作时用三态区分：「đã + V」= 已经完成…；「đang + V」= 正在做…；「sẽ + V」= 将会…。加上「xong」（完）表示完成状态：「đã làm xong」（做完了）。「sắp xong」= 快完成。「chưa」= 还没。",
            "examples": [
                {
                    "vi": "Tôi đã hoàn thành báo cáo tháng này rồi.",
                    "zh": "我已经完成了这个月的报告。"
                },
                {
                    "vi": "Tôi đang phối hợp với phòng kỹ thuật để giải quyết vấn đề.",
                    "zh": "我正在和技术部协作解决问题。"
                },
                {
                    "vi": "Dự án sẽ hoàn thành trước hạn chót hai ngày.",
                    "zh": "项目将在截止日期前两天完成。"
                }
            ]
        }
    ],
