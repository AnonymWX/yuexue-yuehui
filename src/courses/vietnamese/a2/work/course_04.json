    "grammar": [
        {
            "point": "表达观点：theo tôi / tôi nghĩ / tôi cho rằng",
            "explain": "三种常用：「theo tôi」= 依我看（最常用，口语）；「tôi nghĩ」= 我觉得（中性）；「tôi cho rằng」= 我认为（书面）。结构：短语 + 完整小句。温和表达分歧：「Tôi hiểu ý anh, nhưng...」（我理解你的意思，但是…）。",
            "examples": [
                {
                    "vi": "Theo tôi, chúng ta nên tập trung vào khách hàng trước.",
                    "zh": "依我看，我们应该先关注客户。"
                },
                {
                    "vi": "Tôi cho rằng kế hoạch này cần thêm thời gian chuẩn bị.",
                    "zh": "我认为这个计划需要更多准备时间。"
                },
                {
                    "vi": "Tôi hiểu ý anh, nhưng tôi nghĩ phương án khác sẽ hiệu quả hơn.",
                    "zh": "我理解你的意思，但我认为另一个方案会更有效。"
                }
            ]
        },
        {
            "point": "会议流程：bắt đầu / tiếp theo / kết thúc",
            "explain": "会议高频词：「bắt đầu cuộc họp」= 会议开始；「tiếp theo」= 接下来；「chuyển sang vấn đề...」= 转到…话题；「tóm lại」= 总结；「kết thúc」= 结束。「tóm lại」用于收束讨论，比「kết luận」更口语。",
            "examples": [
                {
                    "vi": "Chúng ta bắt đầu cuộc họp với nội dung chính hôm nay.",
                    "zh": "我们以今天的核心内容开始会议。"
                },
                {
                    "vi": "Tiếp theo, chúng ta sẽ chuyển sang vấn đề ngân sách.",
                    "zh": "接下来，我们将转到预算问题。"
                },
                {
                    "vi": "Tóm lại, chúng ta thống nhất ba điểm quan trọng.",
                    "zh": "总结一下，我们达成了三点重要共识。"
                }
            ]
        }
    ],
