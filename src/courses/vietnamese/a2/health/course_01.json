  "grammar": [
    {
      "point": "指示代词 này / đó / kia 后置",
      "explain": "越南语的指示代词放在名词后面（与中文相反）。này = 这个（近）；đó = 那个（中距离）；kia = 那个（远）。常与量词连用：cái đầu này（这个头）。",
      "examples": [
        {
          "vi": "Cái đầu này đau lắm.",
          "zh": "这个头很疼。"
        },
        {
          "vi": "Mắt đó rất đẹp.",
          "zh": "那双眼睛很美。"
        },
        {
          "vi": "Bàn tay kia bị thương rồi.",
          "zh": "那只手受伤了。"
        }
      ]
    },
    {
      "point": "所属关系「của」（……的）",
      "explain": "结构：A + của + B = B 的 A。của 可以省略，尤其在口语中，但当 B 是代词时通常保留以避免歧义。",
      "examples": [
        {
          "vi": "Mắt của tôi rất to.",
          "zh": "我的眼睛很大。"
        },
        {
          "vi": "Tóc cô ấy dài và đen.",
          "zh": "她的头发又长又黑。（省略 của）"
        },
        {
          "vi": "Bàn tay của em bé rất nhỏ.",
          "zh": "宝宝的手很小。"
        }
      ]
    }
  ],
