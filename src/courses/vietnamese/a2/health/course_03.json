    "grammar": [
        {
            "point": "情态动词 cần / phải / nên（需要 / 必须 / 应该）",
            "explain": "三者在语气强度上有区别：phải（必须，最强，无选择余地）> cần（需要，客观需要）> nên（应该，建议）。否定时：không cần（不需要，没必要）≠ không phải（不是…／不用，视语境）≠ không nên（不应该，劝止）。口诀：phải 硬、nên 软、cần 中性。",
            "examples": [
                {
                    "vi": "Bạn phải mang thẻ bảo hiểm khi đi khám.",
                    "zh": "看病时必须带医保卡。"
                },
                {
                    "vi": "Bạn cần đăng ký trước để lấy số thứ tự.",
                    "zh": "你需要先登记才能拿到排队号。"
                },
                {
                    "vi": "Anh nên đi khám sớm, đừng để lâu quá.",
                    "zh": "你应该早点去看病，别拖太久。"
                }
            ]
        },
        {
            "point": "「để」表目的（为了…）",
            "explain": "「để + V」或「để + 主谓」= 为了做某事。可与「để mà」「nhằm」互换（后者书面）。注意与汉语对比：汉语「为了…」通常放在句首，越南语「để…」作为从句多放在主句之后。",
            "examples": [
                {
                    "vi": "Tôi gọi điện trước để đặt lịch hẹn.",
                    "zh": "我提前打电话是为了预约。"
                },
                {
                    "vi": "Bạn nên đến sớm để không phải chờ lâu.",
                    "zh": "你应该早点到，免得等太久。"
                },
                {
                    "vi": "Bác sĩ cho thuốc để tôi uống ở nhà.",
                    "zh": "医生给我开药是为了让我在家服用。"
                }
            ]
        }
    ],
