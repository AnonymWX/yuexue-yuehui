    "grammar": [
        {
            "point": "被动语态 được / bị",
            "explain": "được = 得到（正面）被动；bị = 遭遇（负面）被动。规律：được 后接对主语有利的事（được khen 被表扬、được bác sĩ khám 被医生看诊）；bị 后接对主语不利的事（bị bệnh 生病、bị phạt 被罚）。注意与汉语对比：汉语「被」中性，越南语必须区分正负，用错语义反转。",
            "examples": [
                {
                    "vi": "Tôi được bác sĩ khám và kê đơn.",
                    "zh": "我被医生看诊并开了处方。"
                },
                {
                    "vi": "Anh ấy bị chẩn đoán là viêm dạ dày.",
                    "zh": "他被诊断为胃炎。"
                },
                {
                    "vi": "Nhờ uống thuốc đúng giờ nên tôi được hồi phục nhanh chóng.",
                    "zh": "因为按时服药，我得以很快康复。"
                }
            ]
        },
        {
            "point": "转述医嘱（间接引语：dặn / nói rằng / bảo）",
            "explain": "转述他人话语用 dặn（叮嘱）、nói rằng（说）、bảo（让/叫）。结构：「主语 + dặn/nói/bảo + 对象 + 动词原形」或「主语 + nói rằng + 完整小句」。转述时人称需按逻辑调整：tôi → anh ấy / cô ấy（第三人称）。越南语不像汉语需加「了」，动词保持原形。",
            "examples": [
                {
                    "vi": "Bác sĩ dặn tôi nghỉ ngơi và uống nhiều nước.",
                    "zh": "医生叮嘱我休息和多喝水。"
                },
                {
                    "vi": "Bác sĩ nói rằng tôi cần ăn kiêng đồ cay trong một tuần.",
                    "zh": "医生说我需要忌口辣食一周。"
                },
                {
                    "vi": "Y tá bảo bệnh nhân uống thuốc đúng giờ.",
                    "zh": "护士让病人按时服药。"
                }
            ]
        }
    ],
