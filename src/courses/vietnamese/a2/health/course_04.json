  "grammar": [
    {
      "point": "比较级 hơn / 最高级 nhất",
      "explain": "「A + 形容词 + hơn + B」= A 比 B 更…；「A + 形容词 + nhất」= A 最…。否定比较：「không ... bằng」= 不如。注意「hơn」兼有「多」（số lượng）和「更」（比较）两义，靠位置判断：đắt hơn = 更贵；hơn ba người = 三人以上。",
      "examples": [
        {
          "vi": "Thuốc này tốt hơn thuốc kia.",
          "zh": "这种药比那种药好。"
        },
        {
          "vi": "Đây là loại thuốc hiệu quả nhất trong hiệu thuốc.",
          "zh": "这是药店里最有效的药。"
        },
        {
          "vi": "Tôi không cao bằng anh trai tôi.",
          "zh": "我没有我哥哥高。"
        }
      ]
    },
    {
      "point": "否定祈使句 đừng / chớ（别…）",
      "explain": "「đừng + V」= 别做某事（口语最常用，语气适中）。「chớ + V」= 别（书面/南方口语，语气稍强）。强调请求：「xin đừng」「làm ơn đừng」。对比：không nên（不应该，劝说）< đừng（别，明确指令）。",
      "examples": [
        {
          "vi": "Đừng quên uống thuốc sau khi ăn.",
          "zh": "别忘了饭后吃药。"
        },
        {
          "vi": "Đừng tự ý mua kháng sinh uống, phải có đơn thuốc.",
          "zh": "别擅自买抗生素吃，得有处方。"
        },
        {
          "vi": "Chớ uống thuốc đã hết hạn, rất nguy hiểm.",
          "zh": "别吃过期的药，很危险。"
        }
      ]
    }
  ],
