    "grammar": [
        {
            "point": "「bị」表示遭遇负面状况（症状 / 疾病）",
            "explain": "「bị」后接名词或动词，表示「遭遇不好的事」。健康场景下几乎所有症状都用「bị + 症状」表达，与汉语「得了/患上」相当。「được」是其正面对应词（bị 负面 / được 正面），例如：Tôi được khen（我被表扬）。注意：不要说「Tôi được sốt」，这是病句。",
            "examples": [
                {
                    "vi": "Tôi bị sốt từ hôm qua.",
                    "zh": "我从昨天开始就发烧。"
                },
                {
                    "vi": "Anh ấy bị đau bụng cả buổi sáng.",
                    "zh": "他肚子痛了一上午。"
                },
                {
                    "vi": "Cô ấy bị dị ứng với hải sản.",
                    "zh": "她对海鲜过敏。"
                }
            ]
        },
        {
            "point": "「vì...nên / ...nên」表因果关系",
            "explain": "「vì A nên B」= 因为 A 所以 B，是 A2 复合句的入门句型。口语中常省略「vì」，直接用前半句陈述事实 +「nên」引出结果。可与「vì thế」连用（= 因此）。注意：「nên」作情态动词时是「应该」，作连词时是「所以」，靠位置区分。",
            "examples": [
                {
                    "vi": "Vì trời mưa nên tôi ở nhà.",
                    "zh": "因为下雨所以我在家。"
                },
                {
                    "vi": "Tôi bị sổ mũi nên không ngửi được gì cả.",
                    "zh": "我流鼻涕，所以什么都闻不到。"
                },
                {
                    "vi": "Ăn không hợp nên cô ấy bị tiêu chảy.",
                    "zh": "吃了不对的东西，所以她腹泻了。"
                }
            ]
        }
    ],
