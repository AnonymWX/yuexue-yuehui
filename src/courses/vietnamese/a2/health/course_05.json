    "grammar": [
        {
            "point": "让步句 tuy...nhưng（虽然…但是）",
            "explain": "「tuy A nhưng B」= 虽然 A，但是 B。口语中常省略「tuy」，只用「nhưng」开头半句；书面正式场合则用「mặc dù...nhưng」或「dù...nhưng」，意思相同。注意越南语不像汉语可以省略「但是」，nhưng 一般不能省。",
            "examples": [
                {
                    "vi": "Tuy công việc rất bận nhưng tôi vẫn tập thể dục mỗi ngày.",
                    "zh": "虽然工作很忙，但我还是每天锻炼。"
                },
                {
                    "vi": "Tuy thức khuya có hại cho sức khỏe nhưng nhiều người vẫn không bỏ được.",
                    "zh": "虽然熬夜有害健康，但很多人还是戒不掉。"
                },
                {
                    "vi": "Mặc dù trời mưa to nhưng cô ấy vẫn đi chạy bộ.",
                    "zh": "尽管雨很大，她还是去跑步了。"
                }
            ]
        },
        {
            "point": "条件句 nếu...thì（如果…就）",
            "explain": "「nếu A thì B」= 如果 A，就 B。口语中「thì」常省略，但书面/正式写作保留会更严谨。与汉语不同：越南语的「nếu」从句在前，「thì」引出的主句在后，位置较固定。变体：「nếu không thì」= 否则。",
            "examples": [
                {
                    "vi": "Nếu bạn thức khuya thường xuyên thì sức khỏe sẽ giảm sút.",
                    "zh": "如果你经常熬夜，健康就会变差。"
                },
                {
                    "vi": "Nếu muốn giảm cân, bạn nên ăn nhiều rau xanh và tập thể dục.",
                    "zh": "如果想减肥，你应该多吃蔬菜多锻炼。"
                },
                {
                    "vi": "Phải ngủ đủ giấc, nếu không thì cơ thể rất mệt mỏi.",
                    "zh": "要睡够，否则身体会很累。"
                }
            ]
        }
    ],
