  "grammar": [
    {
      "point": "「vừa...vừa」表达同时进行",
      "explain": "「vừa A vừa B」= 一边 A 一边 B（两个动作同时进行）。可以 3 项：vừa A vừa B vừa C。「vừa」与「vừa mới」（刚刚）不同，靠位置区分：两个 vừa 夹动词是「一边…一边…」；vừa mới + V 是「刚刚」。",
      "examples": [
        {
          "vi": "Tôi vừa học vừa làm thêm để có thêm thu nhập.",
          "zh": "我一边学习一边做兼职以增加收入。"
        },
        {
          "vi": "Sinh viên vừa tham gia câu lạc bộ vừa học các kỹ năng mềm.",
          "zh": "学生一边参加社团一边学软技能。"
        },
        {
          "vi": "Cô ấy vừa học tiếng Việt vừa học tiếng Anh, rất giỏi.",
          "zh": "她一边学越南语一边学英语，很厉害。"
        }
      ]
    },
    {
      "point": "参加活动：tham gia / tham dự / có mặt",
      "explain": "三者都表示「参加」，语感略不同：「tham gia」= 参与（投入，最常用）；「tham dự」= 出席（到场）；「có mặt」= 在场（口语，强调人在）。结构：tham gia + 活动/tổ chức。注意 tham gia 是动词，后直接跟宾语，不加 vào 也可（口语加 vào 更自然）。",
      "examples": [
        {
          "vi": "Tôi muốn tham gia một câu lạc bộ tiếng Anh ở trường.",
          "zh": "我想参加学校的一个英语社团。"
        },
        {
          "vi": "Rất nhiều sinh viên tham dự buổi hội thảo hôm qua.",
          "zh": "很多学生出席了昨天的研讨会。"
        },
        {
          "vi": "Ngày mai tôi sẽ có mặt ở buổi họp câu lạc bộ lúc bảy giờ.",
          "zh": "明天我七点会出席社团会议。"
        }
      ]
    }
  ],
