    "grammar": [
        {
            "point": "时态组合：vừa mới / vẫn đang / sắp",
            "explain": "「vừa mới + V」= 刚刚（动作刚完成不久）；「vẫn đang + V」= 仍在（动作未终止）；「sắp + V」= 即将（马上要）。三者都是 A2 高频时态。可对比：「Tôi vừa mới làm xong」（我刚做完）≠「Tôi đang làm」（我在做）≠「Tôi sắp làm」（我快做）。",
            "examples": [
                {
                    "vi": "Tôi vừa mới nộp bài tập cho cô giáo.",
                    "zh": "我刚把作业交给了老师。"
                },
                {
                    "vi": "Tôi vẫn đang ôn bài, chưa xong nữa.",
                    "zh": "我还在复习，还没做完。"
                },
                {
                    "vi": "Sắp thi rồi, tôi phải học chăm chỉ hơn.",
                    "zh": "快考试了，我必须更用功。"
                }
            ]
        },
        {
            "point": "评价学习：khó / dễ / chăm chỉ / lười",
            "explain": "「khó」= 难，「dễ」= 容易（形容词直接描述，无需 là）；「chăm chỉ」= 勤奋，「lười」或「lười biếng」= 懒惰（形容人的性格/状态）。修饰程度加「rất / hơi / quá」：rất khó（很难）、hơi khó（有点难）、quá khó（太难）。",
            "examples": [
                {
                    "vi": "Bài học hôm nay hơi khó nhưng mà thú vị.",
                    "zh": "今天的课有点难但很有意思。"
                },
                {
                    "vi": "Anh ấy học rất chăm chỉ, luôn hoàn thành bài tập đúng hạn.",
                    "zh": "他学习很用功，总是按时完成作业。"
                },
                {
                    "vi": "Nếu lười biếng quá thì sẽ không đạt điểm cao được.",
                    "zh": "如果太懒就无法取得高分。"
                }
            ]
        }
    ],
