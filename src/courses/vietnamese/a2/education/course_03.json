    "grammar": [
        {
            "point": "考试结果：thi đậu / thi rớt / đạt điểm",
            "explain": "「thi đậu」= 考中、通过；「thi rớt」= 考落榜、不及格；「đạt điểm cao/thấp」= 取得高/低分。注意：「rớt」比「không đậu」口语化。「đậu」在南方更常说，北方口语则用「đỗ」（两词同义异形）。",
            "examples": [
                {
                    "vi": "Anh ấy thi đậu đại học với điểm rất cao.",
                    "zh": "他考上大学，分数很高。"
                },
                {
                    "vi": "Cô ấy thi rớt lần đầu, nhưng năm sau đã đỗ.",
                    "zh": "她第一次没考上，但第二年就通过了。"
                },
                {
                    "vi": "Tôi đạt điểm cao nhất trong lớp môn tiếng Việt.",
                    "zh": "我在班里越南语考了最高分。"
                }
            ]
        },
        {
            "point": "努力与结果：nhờ...nên / vì...nên（复习强化）",
            "explain": "「nhờ A nên B」= 多亏 A 才 B（正面原因）；「vì A nên B」= 因为 A 所以 B（中性原因）。A 是正面时优先用 nhờ，负面时用 vì。「tuy...nhưng」表让步。三者是 A2 写作高分句型。",
            "examples": [
                {
                    "vi": "Nhờ chăm chỉ ôn thi nên tôi đã đạt điểm cao.",
                    "zh": "多亏认真备考，我取得了高分。"
                },
                {
                    "vi": "Vì lo lắng quá nên cô ấy làm bài không tốt.",
                    "zh": "因为太紧张，所以她考试没发挥好。"
                },
                {
                    "vi": "Tuy bài thi rất khó nhưng nhiều bạn vẫn đạt điểm cao.",
                    "zh": "虽然考试很难，但很多同学还是得了高分。"
                }
            ]
        }
    ],
