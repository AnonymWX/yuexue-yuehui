  "grammar": [
    {
      "point": "就读表达：học ở / học tại / học + 学校",
      "explain": "三种表达：「học ở + 学校」（口语最常用）；「học tại + 学校」（书面、正式）；「học + 学校名」（简略）。「học」后接科目/专业用「học + 名词」：học tiếng Việt（学越南语）、học y（学医）。注意：「học sinh」指中小学生，「sinh viên」指大学生，不要混用。",
      "examples": [
        {
          "vi": "Tôi học ở trường Đại học Quốc gia Hà Nội.",
          "zh": "我在河内国家大学学习。"
        },
        {
          "vi": "Cô ấy học chuyên ngành tiếng Việt tại một trường ở Huế.",
          "zh": "她在顺化的一所学校读越南语专业。"
        },
        {
          "vi": "Anh trai tôi học y, còn tôi học luật.",
          "zh": "我哥哥学医，我学法律。"
        }
      ]
    },
    {
      "point": "学制询问：mấy năm / bao lâu",
      "explain": "「học mấy năm?」= 学几年（问学制，期待数字答案）；「học bao lâu?」= 学多久（问时长，可长可短）。回答：「học bốn năm」（读四年）、「học khoảng hai năm rưỡi」（约两年半）。「rưỡi」= 半（用于整数后）。",
      "examples": [
        {
          "vi": "Chương trình đại học ở Việt Nam học mấy năm?",
          "zh": "越南的大学课程要读几年？"
        },
        {
          "vi": "Khoa tiếng Việt học bốn năm, còn cao học hai năm.",
          "zh": "越南语系读四年，硕士两年。"
        },
        {
          "vi": "Tôi học tiếng Việt được khoảng một năm rưỡi rồi.",
          "zh": "我学越南语已经大约一年半了。"
        }
      ]
    }
  ],
