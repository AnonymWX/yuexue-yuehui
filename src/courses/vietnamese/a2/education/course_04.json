    "grammar": [
        {
            "point": "定语从句：mà",
            "explain": "「mà」= 关系代词「……的」，用于修饰前面的名词。结构：「名词 + mà + 小句」，如「quyển sách mà tôi mua hôm qua」（我昨天买的那本书）。「mà」在口语中常省略，但书面保留更清楚。注意：mà 不是「但是」（那是 nhưng），也不同于「mà thôi」（而已）。",
            "examples": [
                {
                    "vi": "Quyển sách mà tôi mượn ở thư viện rất hay.",
                    "zh": "我在图书馆借的那本书很好看。"
                },
                {
                    "vi": "Đây là giảng viên mà tôi rất kính trọng.",
                    "zh": "这是我非常尊敬的讲师。"
                },
                {
                    "vi": "Tôi thích những bài học mà có nhiều ví dụ thực tế.",
                    "zh": "我喜欢那些有很多实际例子的课程。"
                }
            ]
        },
        {
            "point": "自习建议：nên / không nên / cần",
            "explain": "「nên + V」= 应该（建议）；「không nên + V」= 不应该（劝止）；「cần + V」= 需要。建议型句子常与条件连用：Nếu muốn tập trung thì nên...（如果想专注就应该…）。自习场景高频。",
            "examples": [
                {
                    "vi": "Bạn nên tự học ít nhất hai tiếng mỗi ngày.",
                    "zh": "你应该每天至少自学两小时。"
                },
                {
                    "vi": "Không nên học ở nơi ồn ào, sẽ rất khó tập trung.",
                    "zh": "不该在吵闹的地方学习，很难专注。"
                },
                {
                    "vi": "Nếu muốn đạt kết quả tốt, bạn cần có kế hoạch học tập rõ ràng.",
                    "zh": "如果想取得好成绩，你需要有明确的学习计划。"
                }
            ]
        }
    ],
