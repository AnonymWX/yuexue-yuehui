    "grammar": [
        {
            "point": "温度提问与表达：bao nhiêu / độ",
            "explain": "问温度：「Nhiệt độ bao nhiêu độ?」（多少度？）；回答：「khoảng 30 độ C」或口语「30 độ」。注意：越南语说温度必须在数字后加「độ」，不能只说「30」。摄氏度说 độ C，华氏度说 độ F，但越南只用摄氏度。",
            "examples": [
                {
                    "vi": "Nhiệt độ hôm nay bao nhiêu độ?",
                    "zh": "今天温度多少度？"
                },
                {
                    "vi": "Nhiệt độ khoảng 25 độ C, rất dễ chịu.",
                    "zh": "温度大约 25 度，很舒服。"
                },
                {
                    "vi": "Ở Hà Nội mùa đông có thể xuống dưới 10 độ C.",
                    "zh": "河内冬天可能降到 10 度以下。"
                }
            ]
        },
        {
            "point": "程度副词：quá / lắm / rất / hơi",
            "explain": "quá = 太（超出预期，可放形容词后，也可前）；lắm = 很（口语，必须放形容词后）；rất = 很（书面，必须放形容词前，不能后）；hơi = 有点（放形容词前）。位置规律：rất / hơi 在前，quá / lắm 可在后，quá 也可在前。",
            "examples": [
                {
                    "vi": "Hôm nay trời nóng quá!",
                    "zh": "今天太热了！"
                },
                {
                    "vi": "Trời lạnh lắm, bạn mặc áo ấm vào.",
                    "zh": "天很冷，你穿件暖衣。"
                },
                {
                    "vi": "Sáng nay hơi se lạnh, nhưng trưa sẽ ấm hơn.",
                    "zh": "今天早上有点微凉，但中午会暖一些。"
                }
            ]
        }
    ],
