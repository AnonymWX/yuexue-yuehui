  "grammar": [
    {
      "point": "比较级 hơn / 最高级 nhất / 等同 bằng（复习强化）",
      "explain": "A + adj + hơn + B = A 比 B 更…；A + adj + nhất = A 最…；A + không + adj + bằng + B = A 不如 B。注意「nhất」放在形容词后，与汉语「最…」位置相反；「hơn」前不能加「rất」（❌ rất nóng hơn）。",
      "examples": [
        {
          "vi": "Miền Nam nóng hơn miền Bắc quanh năm.",
          "zh": "南方全年比北方热。"
        },
        {
          "vi": "Mùa thu là mùa đẹp nhất ở Hà Nội.",
          "zh": "秋天是河内最美的季节。"
        },
        {
          "vi": "Mùa đông ở Sài Gòn không lạnh bằng mùa đông ở Hà Nội.",
          "zh": "西贡的冬天没有河内的冬天冷。"
        }
      ]
    },
    {
      "point": "đặc trưng / đặc điểm 描述特征",
      "explain": "「đặc trưng」= 典型特征（区别于其他）；「đặc điểm」= 特点（中性）。常用结构：「X có đặc trưng là...」或「đặc trưng của X là...」。写说明文时非常好用。",
      "examples": [
        {
          "vi": "Khí hậu nhiệt đới gió mùa là đặc trưng của Việt Nam.",
          "zh": "热带季风气候是越南的典型特征。"
        },
        {
          "vi": "Đặc trưng của mùa khô là ít mưa và nắng nhiều.",
          "zh": "旱季的特征是雨少阳光多。"
        },
        {
          "vi": "Mỗi vùng miền có đặc điểm khí hậu khác nhau.",
          "zh": "每个地区的气候特点不同。"
        }
      ]
    }
  ],
