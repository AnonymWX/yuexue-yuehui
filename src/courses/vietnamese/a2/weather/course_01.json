  "grammar": [
    {
      "point": "时态进阶：đang / sắp / sẽ",
      "explain": "đang = 正在（进行，动作此刻发生）；sắp = 即将（马上要，一两分钟内）；sẽ = 将要（将来，时间可远可近）。口诀：đang 现在 → sắp 马上 → sẽ 将来。三者位置都在动词前，可叠用：sắp sửa（快要）、đang chuẩn bị（正在准备）。",
      "examples": [
        {
          "vi": "Trời đang mưa to, bạn nhớ mang áo mưa nhé.",
          "zh": "现在正下大雨，你记得带雨衣。"
        },
        {
          "vi": "Trời sắp mưa rồi, mây đen kéo đến rất nhanh.",
          "zh": "快下雨了，乌云来得很快。"
        },
        {
          "vi": "Ngày mai trời sẽ nắng, nhiệt độ khoảng 30 độ.",
          "zh": "明天会晴，温度大约 30 度。"
        }
      ]
    },
    {
      "point": "询问天气：thế nào?",
      "explain": "「Thời tiết hôm nay thế nào?」= 今天天气怎样？thế nào 是万能疑问短语，可问天气、感受、状态。「như thế nào」稍书面。回答用形容词直接描述即可，无需加「là」。",
      "examples": [
        {
          "vi": "Thời tiết ở Hà Nội hôm nay thế nào?",
          "zh": "今天河内的天气怎样？"
        },
        {
          "vi": "Ngoài trời có gió to không?",
          "zh": "外面风大吗？"
        },
        {
          "vi": "Trời hôm nay đẹp lắm, không nóng cũng không lạnh.",
          "zh": "今天天气很好，不热也不冷。"
        }
      ]
    }
  ],
