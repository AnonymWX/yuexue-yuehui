    "grammar": [
        {
            "point": "目的与建议：để / nên / phải（综合复习）",
            "explain": "「để + V」= 为了（表目的）；「nên + V」= 应该（建议）；「phải + V」= 必须（强制）。三者常连用：先说明目的（để），再给建议（nên）或强调义务（phải）。注意：「để」引导的从句放主句后，而「nên / phải」直接修饰动词。",
            "examples": [
                {
                    "vi": "Để đảm bảo an toàn, bạn nên ở trong nhà khi bão đến.",
                    "zh": "为了确保安全，台风来临时你应该待在屋里。"
                },
                {
                    "vi": "Khi có lũ, mọi người phải sơ tán đến nơi cao ráo.",
                    "zh": "发生洪水时，所有人都必须疏散到高处。"
                },
                {
                    "vi": "Chúng ta phải chuẩn bị đèn pin và nước uống để ứng phó với bão.",
                    "zh": "我们必须准备手电筒和饮用水以应对台风。"
                }
            ]
        },
        {
            "point": "被动句描述受灾：được / bị（复习）",
            "explain": "受灾用 bị（负面）：bị thiệt hại / bị ngập / bị sạt lở。获得帮助用 được（正面）：được cứu hộ / được sơ tán / được cứu trợ。注意：sơ tán 既可用 được（被安排疏散）也可用 chủ động（居民自行疏散），根据主语意愿判断。",
            "examples": [
                {
                    "vi": "Nhiều ngôi nhà bị ngập trong trận lũ vừa qua.",
                    "zh": "不少房屋在上次洪水中被淹。"
                },
                {
                    "vi": "Người dân vùng bão đã được sơ tán đến nơi an toàn.",
                    "zh": "台风地区的居民已被疏散到安全地点。"
                },
                {
                    "vi": "Khu vực miền núi bị sạt lở nghiêm trọng sau nhiều ngày mưa.",
                    "zh": "山区在连雨多日后发生严重滑坡。"
                }
            ]
        }
    ],
