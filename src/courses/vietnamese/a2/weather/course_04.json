  "grammar": [
    {
      "point": "条件句 nếu...thì（复习强化）",
      "explain": "「nếu A thì B」= 如果 A，就 B。天气预报中常用来表达假设场景。可叠用「nếu không thì」= 否则。口语省略 thì 也常见，但保留更严谨。",
      "examples": [
        {
          "vi": "Nếu ngày mai trời mưa thì chúng ta sẽ hoãn chuyến đi.",
          "zh": "如果明天下雨，我们就推迟出行。"
        },
        {
          "vi": "Nếu nhiệt độ xuống dưới 10 độ thì bạn phải mặc áo rất ấm.",
          "zh": "如果温度降到 10 度以下，你就必须穿很暖的衣服。"
        },
        {
          "vi": "Phải theo dõi dự báo thường xuyên, nếu không thì rất dễ gặp nguy hiểm.",
          "zh": "要经常关注预报，否则很容易遇到危险。"
        }
      ]
    },
    {
      "point": "被动/预期：được dự báo / dự kiến",
      "explain": "「được dự báo」= 被预报（预报说…）；「dự kiến」= 预计（无被动含义，直接接动词）。二者都用于转述官方/权威信息。新闻类正式文本常用。",
      "examples": [
        {
          "vi": "Theo dự báo, ngày mai trời được dự báo sẽ có mưa to.",
          "zh": "据预报，明天被预报会有大雨。"
        },
        {
          "vi": "Cơn bão dự kiến sẽ đổ bộ vào đất liền vào tối nay.",
          "zh": "台风预计今晚登陆。"
        },
        {
          "vi": "Nhiệt độ được dự báo sẽ giảm mạnh trong hai ngày tới.",
          "zh": "预计未来两天温度会大幅下降。"
        }
      ]
    }
  ],
