    "grammar": [
        {
            "point": "「nước」表示国家",
            "explain": "「nước」本义是「水」，也可表示「国家」。说某国时，既可直接用国名（如「Việt Nam」），也可加「nước」表示强调。",
            "examples": [
                {
                    "vi": "Tôi ở Việt Nam.",
                    "zh": "我在越南。"
                },
                {
                    "vi": "Đây là nước Trung Quốc.",
                    "zh": "这是中国。"
                }
            ]
        },
        {
            "point": "国家名称的单音节习惯",
            "explain": "越南语部分国家名称用单音节词表示，如「Mỹ」（美国）、「Anh」（英国）、「Pháp」（法国）。正式场合常加「nước」以免歧义。",
            "examples": [
                {
                    "vi": "Anh ấy là người Mỹ.",
                    "zh": "他是美国人。"
                },
                {
                    "vi": "Nước Pháp rất đẹp.",
                    "zh": "法国很美。"
                }
            ]
        }
    ],
