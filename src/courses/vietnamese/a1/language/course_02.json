    "grammar": [
        {
            "point": "问国籍：「Quốc tịch của bạn là gì?」",
            "explain": "问国籍标准句式是「Quốc tịch của + 人称 + là gì?」。「của」表所属，「gì」表疑问。口语中更常说「Bạn là người nước nào?」。",
            "examples": [
                {
                    "vi": "Quốc tịch của bạn là gì?",
                    "zh": "你的国籍是什么？"
                },
                {
                    "vi": "Bạn là người nước nào?",
                    "zh": "你是哪国人？"
                }
            ]
        },
        {
            "point": "回答国籍：「Tôi là người + 国名」",
            "explain": "回答国籍用「người + 国名」，如「người Việt Nam」（越南人）、「người Trung Quốc」（中国人）。泛指外国人用「người nước ngoài」。",
            "examples": [
                {
                    "vi": "Tôi là người Việt Nam.",
                    "zh": "我是越南人。"
                },
                {
                    "vi": "Anh ấy là người nước ngoài.",
                    "zh": "他是外国人。"
                }
            ]
        }
    ],
