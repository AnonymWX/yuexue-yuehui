    "grammar": [
        {
            "point": "综合介绍「Tôi là người... , tôi nói tiếng...」",
            "explain": "综合介绍国籍和语言时，可把两句合并，用逗号或「và」连接。",
            "examples": [
                {
                    "vi": "Tôi là người Việt Nam, tôi nói tiếng Việt và tiếng Anh.",
                    "zh": "我是越南人，我说越南语和英语。"
                },
                {
                    "vi": "Tôi là người Trung Quốc, tôi đang học tiếng Việt.",
                    "zh": "我是中国人，我正在学越南语。"
                }
            ]
        },
        {
            "point": "「cùng + 动词」表一起做某事",
            "explain": "「cùng」意为「一起」，后接动词表示共同做某事，如「cùng học」（一起学）。",
            "examples": [
                {
                    "vi": "Chúng ta cùng học tiếng Việt.",
                    "zh": "我们一起学越南语。"
                },
                {
                    "vi": "Tôi và bạn cùng luyện tập.",
                    "zh": "我和朋友一起练习。"
                }
            ]
        }
    ],
