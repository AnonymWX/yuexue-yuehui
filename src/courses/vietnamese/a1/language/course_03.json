    "grammar": [
        {
            "point": "「tiếng + 国名」表语言",
            "explain": "表达某国语言用「tiếng + 国名」，如「tiếng Việt」（越南语）、「tiếng Anh」（英语）。注意「tiếng Anh」是固定说法，不写作「tiếng Anh Quốc」。",
            "examples": [
                {
                    "vi": "Tôi học tiếng Việt.",
                    "zh": "我学越南语。"
                },
                {
                    "vi": "Anh ấy nói tiếng Anh.",
                    "zh": "他说英语。"
                }
            ]
        },
        {
            "point": "「người + 国名」与「tiếng + 国名」的区别",
            "explain": "「người + 国名」指人，「tiếng + 国名」指语言。注意英语「tiếng Anh」、美国「nước Mỹ」的不对称用法。",
            "examples": [
                {
                    "vi": "Tôi là người Việt Nam, tôi nói tiếng Việt.",
                    "zh": "我是越南人，我说越南语。"
                },
                {
                    "vi": "Anh ấy là người Anh, anh ấy nói tiếng Anh.",
                    "zh": "他是英国人，他说英语。"
                }
            ]
        }
    ],
