    "grammar": [
        {
            "point": "问候语「Xin chào」的使用",
            "explain": "「Xin chào」是最正式、最通用的问候语，相当于汉语的「您好」。可以单独使用，也可以在后面加称呼。",
            "examples": [
                {
                    "vi": "Xin chào!",
                    "zh": "您好！"
                },
                {
                    "vi": "Xin chào anh!",
                    "zh": "您好，哥哥！"
                }
            ]
        },
        {
            "point": "按时段问候",
            "explain": "越南语按上午、下午、晚上分别使用不同的问候语，结构为「chào buổi + 时段」。",
            "examples": [
                {
                    "vi": "Chào buổi sáng!",
                    "zh": "早上好！"
                },
                {
                    "vi": "Chào buổi tối!",
                    "zh": "晚上好！"
                }
            ]
        }
    ],
