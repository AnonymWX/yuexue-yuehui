    "grammar": [
        {
            "point": "「Vâng」与「Dạ」的区别",
            "explain": "两者都表示「是」，但「vâng」偏北方、「dạ」偏南方，且「dạ」更显礼貌、谦逊，常用于对长辈或正式场合。",
            "examples": [
                {
                    "vi": "Vâng, tôi hiểu rồi.",
                    "zh": "是的，我明白了。"
                },
                {
                    "vi": "Dạ, em cảm ơn anh.",
                    "zh": "是的，谢谢哥哥。"
                }
            ]
        },
        {
            "point": "肯定与否定「Có / Không」",
            "explain": "越南语中「có」表示肯定，「không」表示否定，常用于回答一般疑问句。",
            "examples": [
                {
                    "vi": "Bạn có khỏe không? — Có, tôi khỏe.",
                    "zh": "你好吗？——是的，我很好。"
                },
                {
                    "vi": "Anh có biết tiếng Việt không? — Không, tôi không biết.",
                    "zh": "你会越南语吗？——不，我不会。"
                }
            ]
        }
    ],
