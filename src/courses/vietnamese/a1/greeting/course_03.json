    "grammar": [
        {
            "point": "人称代词按年龄和辈分选择",
            "explain": "越南语人称代词与汉语不同，不是简单的「你、我、他」，而是根据对方年龄、性别、与说话人的关系来选择。对年长男性用「ông」或「anh」，对年长女性用「bà」或「chị」，对年幼者用「em」。",
            "examples": [
                {
                    "vi": "Chào anh!",
                    "zh": "哥哥你好！"
                },
                {
                    "vi": "Chào em!",
                    "zh": "妹妹你好！"
                }
            ]
        },
        {
            "point": "自称「tôi」与「mình」",
            "explain": "「tôi」是正式的自称，「mình」更亲切、口语化。与朋友交谈时常用「mình」。",
            "examples": [
                {
                    "vi": "Tôi là giáo viên.",
                    "zh": "我是老师。（正式）"
                },
                {
                    "vi": "Mình là sinh viên.",
                    "zh": "我是学生。（亲切）"
                }
            ]
        }
    ],
