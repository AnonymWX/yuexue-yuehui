    "grammar": [
        {
            "point": "越南地址结构「số + đường + phường + quận + thành phố」",
            "explain": "越南地址从具体到宏观排列：门牌号 → 街名 → 坊 → 郡 → 城市。如「số 10 đường Nguyễn Huệ, phường 1, quận 1, thành phố Hồ Chí Minh」。",
            "examples": [
                {
                    "vi": "Số 10 đường Nguyễn Huệ.",
                    "zh": "阮惠街 10 号。"
                },
                {
                    "vi": "Số 5 đường Lê Lợi, quận 1.",
                    "zh": "黎利街 5 号，1 郡。"
                }
            ]
        },
        {
            "point": "「số + 数字」表门牌号",
            "explain": "报门牌号用「số + 数字」，如「số 20」（20 号）。",
            "examples": [
                {
                    "vi": "Nhà tôi ở số 20.",
                    "zh": "我家在 20 号。"
                },
                {
                    "vi": "Số nhà tôi là 15.",
                    "zh": "我家门牌号是 15。"
                }
            ]
        }
    ],
