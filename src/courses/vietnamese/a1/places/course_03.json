    "grammar": [
        {
            "point": "问地址「Địa chỉ của bạn là gì?」",
            "explain": "正式问地址用「Địa chỉ của bạn là gì?」，口语常用「Bạn ở đâu?」（你住哪？）。",
            "examples": [
                {
                    "vi": "Địa chỉ của bạn là gì?",
                    "zh": "你的地址是什么？"
                },
                {
                    "vi": "Bạn ở đâu?",
                    "zh": "你住哪？"
                }
            ]
        },
        {
            "point": "「ghi + 内容」表写、记录",
            "explain": "「ghi」意为「写、记」，如「ghi địa chỉ」（写地址）。填写表格用「điền vào phiếu」。",
            "examples": [
                {
                    "vi": "Tôi ghi địa chỉ vào phiếu.",
                    "zh": "我把地址写在表格上。"
                },
                {
                    "vi": "Xin điền thông tin vào đây.",
                    "zh": "请把信息填在这里。"
                }
            ]
        }
    ],
