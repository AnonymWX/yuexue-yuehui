    "grammar": [
        {
            "point": "「đi đến + 地点」表去某地",
            "explain": "表示「去某地」用「đi đến + 地点」，口语常用「đi + 地点」。",
            "examples": [
                {
                    "vi": "Tôi đi đến công viên.",
                    "zh": "我去公园。"
                },
                {
                    "vi": "Tôi đi siêu thị.",
                    "zh": "我去超市。"
                }
            ]
        },
        {
            "point": "「ở + 地点」表在某处",
            "explain": "「ở」表示存在或所在，后接地点名词，如「ở thư viện」（在图书馆）。",
            "examples": [
                {
                    "vi": "Tôi ở thư viện.",
                    "zh": "我在图书馆。"
                },
                {
                    "vi": "Anh ấy ở sân bay.",
                    "zh": "他在机场。"
                }
            ]
        }
    ],
