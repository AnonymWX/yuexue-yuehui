  "grammar": [
    {
      "point": "问人数「mấy người?」",
      "explain": "问家庭人数用「Gia đình + 人称 + có mấy người?」。回答用「có + 数字 + người」。",
      "examples": [
        {
          "vi": "Gia đình bạn có mấy người?",
          "zh": "你家有几口人？"
        },
        {
          "vi": "Gia đình tôi có bốn người.",
          "zh": "我家有四口人。"
        }
      ]
    },
    {
      "point": "「nội」与「ngoại」的区别",
      "explain": "「nội」指父系，「ngoại」指母系。所以「ông nội」是爷爷，「ông ngoại」是外公。",
      "examples": [
        {
          "vi": "Ông nội tôi 80 tuổi.",
          "zh": "我爷爷 80 岁。"
        },
        {
          "vi": "Bà ngoại tôi ở Hà Nội.",
          "zh": "我外婆在河内。"
        }
      ]
    }
  ],
