  "grammar": [
    {
      "point": "「gia đình + 人称」表某人的家庭",
      "explain": "表达「某人的家庭」用「gia đình + 人称」，如「gia đình tôi」（我的家庭）。",
      "examples": [
        {
          "vi": "Gia đình tôi có bốn người.",
          "zh": "我家有四口人。"
        },
        {
          "vi": "Gia đình bạn thế nào?",
          "zh": "你家怎么样？"
        }
      ]
    },
    {
      "point": "兄弟姐妹的区分",
      "explain": "越南语区分兄弟姐妹的性别和长幼：「anh trai」哥哥、「chị gái」姐姐、「em trai」弟弟、「em gái」妹妹。注意「anh/chị/em」前面已有基础，但加入「trai/gái」后特指亲属关系。",
      "examples": [
        {
          "vi": "Anh trai tôi là bác sĩ.",
          "zh": "我哥哥是医生。"
        },
        {
          "vi": "Em gái tôi học tiếng Anh.",
          "zh": "我妹妹学英语。"
        }
      ]
    }
  ],
