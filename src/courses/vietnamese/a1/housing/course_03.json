    "grammar": [
        {
            "point": "「sống ở + 地点」表居住",
            "explain": "表示「住在某处」用「sống ở + 地点」或「ở + 地点」。",
            "examples": [
                {
                    "vi": "Tôi sống ở căn hộ.",
                    "zh": "我住在公寓。"
                },
                {
                    "vi": "Anh ấy sống ở biệt thự.",
                    "zh": "他住在别墅。"
                }
            ]
        },
        {
            "point": "楼层表达「tầng + 数字」",
            "explain": "楼层用「tầng + 数字」。北方用「tầng」，南方用「lầu」。越南语中「tầng 1」通常指地面层。",
            "examples": [
                {
                    "vi": "Tôi ở tầng 3.",
                    "zh": "我住 3 楼。"
                },
                {
                    "vi": "Anh ấy ở tầng 1.",
                    "zh": "他住 1 楼。"
                }
            ]
        }
    ],
