  "grammar": [
    {
      "point": "「trong + 房间」表在某房间内",
      "explain": "「trong」意为「在……里面」，后接房间名称，如「trong phòng khách」（在客厅里）。",
      "examples": [
        {
          "vi": "Mẹ tôi ở trong nhà bếp.",
          "zh": "我妈妈在厨房。"
        },
        {
          "vi": "Anh tôi ở trong phòng ngủ.",
          "zh": "我哥哥在卧室。"
        }
      ]
    },
    {
      "point": "「Nhà tôi có + 房间数」表房间数量",
      "explain": "表示家里有几个房间用「Nhà tôi có + 数字 + phòng」。",
      "examples": [
        {
          "vi": "Nhà tôi có ba phòng ngủ.",
          "zh": "我家有三间卧室。"
        },
        {
          "vi": "Nhà tôi có một phòng khách.",
          "zh": "我家有一个客厅。"
        }
      ]
    }
  ],
