    "grammar": [
        {
            "point": "「phụ trách + 名词」表负责",
            "explain": "表示负责某项事务用「phụ trách + 名词」，如「phụ trách nấu ăn」（负责做饭）。",
            "examples": [
                {
                    "vi": "Mẹ tôi phụ trách nấu ăn.",
                    "zh": "我妈妈负责做饭。"
                },
                {
                    "vi": "Tôi phụ trách rửa chén.",
                    "zh": "我负责洗碗。"
                }
            ]
        },
        {
            "point": "「cùng + 动词」表一起做",
            "explain": "「cùng」意为「一起」，后接动词表示一起做某事。",
            "examples": [
                {
                    "vi": "Cả nhà cùng ăn cơm.",
                    "zh": "全家一起吃饭。"
                },
                {
                    "vi": "Chúng tôi cùng xem tivi.",
                    "zh": "我们一起看电视。"
                }
            ]
        }
    ],
