    "grammar": [
        {
            "point": "「đi / đội / đeo」表穿戴",
            "explain": "不同物品用不同动词：鞋用「đi」（đi giày 穿鞋）、帽用「đội」（đội mũ 戴帽）、眼镜/手表/围巾用「đeo」（đeo kính 戴眼镜）。",
            "examples": [
                {
                    "vi": "Tôi đi giày mới.",
                    "zh": "我穿新鞋。"
                },
                {
                    "vi": "Anh ấy đội mũ.",
                    "zh": "他戴帽子。"
                }
            ]
        },
        {
            "point": "问鞋码「Cỡ bao nhiêu?」",
            "explain": "问鞋码用「Cỡ bao nhiêu?」，回答用「cỡ + 数字」。",
            "examples": [
                {
                    "vi": "Anh đi cỡ bao nhiêu?",
                    "zh": "您穿几码？"
                },
                {
                    "vi": "Tôi đi cỡ 40.",
                    "zh": "我穿 40 码。"
                }
            ]
        }
