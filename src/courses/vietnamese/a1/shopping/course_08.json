    "grammar": [
        {
            "point": "退货「Tôi muốn trả lại + 商品」",
            "explain": "表示「我想退货」用「Tôi muốn trả lại + 商品」，或「Tôi muốn đổi + 商品」（想换货）。",
            "examples": [
                {
                    "vi": "Tôi muốn trả lại cái áo này.",
                    "zh": "我想退这件衣服。"
                },
                {
                    "vi": "Tôi muốn đổi cái khác.",
                    "zh": "我想换另一个。"
                }
            ]
        },
        {
            "point": "「bị + 动词」表不如意",
            "explain": "「bị」表示遭遇不如意的事情，如「bị hỏng」（坏了）、「bị lỗi」（有缺陷）。",
            "examples": [
                {
                    "vi": "Cái này bị hỏng.",
                    "zh": "这个坏了。"
                },
                {
                    "vi": "Điện thoại bị lỗi.",
                    "zh": "手机有缺陷。"
                }
            ]
        }
    ],
