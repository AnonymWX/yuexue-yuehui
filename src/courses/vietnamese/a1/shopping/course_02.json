    "grammar": [
        {
            "point": "「Tôi muốn thử + 服装」表试穿",
            "explain": "试穿服装用「Tôi muốn thử + 服装」，售货员会指向试衣间「phòng thử」。",
            "examples": [
                {
                    "vi": "Tôi muốn thử cái áo này.",
                    "zh": "我想试这件衣服。"
                },
                {
                    "vi": "Phòng thử ở đâu?",
                    "zh": "试衣间在哪？"
                }
            ]
        },
        {
            "point": "「vừa / chật / rộng」表合身程度",
            "explain": "用「vừa」表示合身，「chật」表示太紧，「rộng」表示太宽。",
            "examples": [
                {
                    "vi": "Cái áo này vừa.",
                    "zh": "这件衣服合身。"
                },
                {
                    "vi": "Cái quần này chật.",
                    "zh": "这条裤子紧。"
                }
            ]
        }
    ],
