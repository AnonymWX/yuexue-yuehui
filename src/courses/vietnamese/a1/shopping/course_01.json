    "grammar": [
        {
            "point": "量词「cái」的通用性",
            "explain": "「cái」是越南语最通用的量词，用于大多数无生命物体，如「cái bàn」（桌子）、「cái ghế」（椅子）、「cái bút」（笔）。",
            "examples": [
                {
                    "vi": "Đây là cái bàn.",
                    "zh": "这是桌子。"
                },
                {
                    "vi": "Đây là cái ghế.",
                    "zh": "这是椅子。"
                }
            ]
        },
        {
            "point": "量词与名词的搭配",
            "explain": "不同类别名词用不同量词：书本用「quyển」，动物用「con」，车辆衣物用「chiếc」，画/照片/信用「bức」。",
            "examples": [
                {
                    "vi": "Đây là quyển sách.",
                    "zh": "这是书。"
                },
                {
                    "vi": "Đây là con mèo.",
                    "zh": "这是猫。"
                }
            ]
        }
    ],
