    "grammar": [
        {
            "point": "去哪购物：đi + 商店名",
            "explain": "「đi + 商店名」= 去某商店。越南语中「đi」后可直接接地点，无需介词。如「đi chợ」= 去市场，「đi siêu thị」= 去超市。加「để + V」表目的：「đi siêu thị để mua đồ ăn」（去超市买食物）。",
            "examples": [
                {
                    "vi": "Tôi đi siêu thị mua đồ ăn.",
                    "zh": "我去超市买食物。"
                },
                {
                    "vi": "Cô ấy đi chợ mỗi sáng.",
                    "zh": "她每天早上都去市场。"
                }
            ]
        },
        {
            "point": "问地点：… ở đâu?",
            "explain": "「A ở đâu?」= A 在哪里？回答：「A ở + 地点」。例：「Siêu thị ở đâu?」→「Siêu thị ở gần nhà tôi」。要问「哪里有…」用「Ở đâu có A?」（倒装）。",
            "examples": [
                {
                    "vi": "Hiệu thuốc ở đâu?",
                    "zh": "药店在哪里？"
                },
                {
                    "vi": "Chợ ở gần nhà tôi.",
                    "zh": "市场在我家附近。"
                }
            ]
        }
    ],
