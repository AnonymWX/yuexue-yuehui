  "grammar": [
    {
      "point": "地点介词 ở + 地点",
      "explain": "「ở」表示「在（某处）」，与中文「在」基本对应。位置：主语 + 动词 + ở + 地点，或「地点 + ở + 方位」。",
      "examples": [
        {
          "vi": "Quầy tính tiền ở lối ra.",
          "zh": "收银台在出口处。"
        },
        {
          "vi": "Bãi đỗ xe ở tầng hầm.",
          "zh": "停车场在地下楼层。"
        }
      ]
    },
    {
      "point": "问位置：... ở đâu?",
      "explain": "「ở đâu」= 在哪里，疑问时放句末。礼貌形式在句首加「Cho tôi hỏi,」（请问……）或结尾加「ạ」。",
      "examples": [
        {
          "vi": "Kệ sữa ở đâu?",
          "zh": "牛奶货架在哪？"
        },
        {
          "vi": "Cho tôi hỏi, thang máy ở đâu ạ?",
          "zh": "请问，电梯在哪？"
        }
      ]
    }
  ],
