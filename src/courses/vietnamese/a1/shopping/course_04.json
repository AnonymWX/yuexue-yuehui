    "grammar": [
        {
            "point": "「một + 量词 + 食材」表数量",
            "explain": "买食材用「một + 量词 + 食材」，如「một ký thịt」（一公斤肉）、「một con cá」（一条鱼）、「một chục trứng」（十个蛋）。",
            "examples": [
                {
                    "vi": "Cho tôi một ký thịt.",
                    "zh": "给我一公斤肉。"
                },
                {
                    "vi": "Mua một chục trứng.",
                    "zh": "买十个蛋。"
                }
            ]
        },
        {
            "point": "「một ký / một lạng」表重量",
            "explain": "「ký」千克（公斤），「lạng」百克（一两）。市场买卖常用这两个量词。",
            "examples": [
                {
                    "vi": "Một ký gạo bao nhiêu tiền?",
                    "zh": "一公斤米多少钱？"
                },
                {
                    "vi": "Cho tôi hai lạng thịt.",
                    "zh": "给我两百克肉。"
                }
            ]
        }
    ],
