    "grammar": [
        {
            "point": "「đắt quá / rẻ quá」表太贵/太便宜",
            "explain": "「đắt quá」意为「太贵」，「rẻ quá」意为「太便宜」。「quá」放在形容词后表示「太」。",
            "examples": [
                {
                    "vi": "Cái này đắt quá.",
                    "zh": "这个太贵了。"
                },
                {
                    "vi": "Cái này rẻ quá.",
                    "zh": "这个太便宜了。"
                }
            ]
        },
        {
            "point": "砍价「Bớt cho tôi ... đồng」",
            "explain": "砍价常用「Bớt cho tôi + 金额 + đồng」（给我减……盾）或「Giảm giá cho tôi」（给我打折）。",
            "examples": [
                {
                    "vi": "Bớt cho tôi 10 nghìn đồng.",
                    "zh": "给我减 1 万盾。"
                },
                {
                    "vi": "Giảm giá cho tôi đi.",
                    "zh": "给我打折吧。"
                }
            ]
        }
    ],
