    "grammar": [
        {
            "point": "「trả bằng + 支付方式」表用……付款",
            "explain": "「trả bằng」意为「用……付」，后接支付方式，如「trả bằng tiền mặt」（用现金付）、「trả bằng thẻ」（用卡付）。",
            "examples": [
                {
                    "vi": "Tôi trả bằng tiền mặt.",
                    "zh": "我用现金付。"
                },
                {
                    "vi": "Anh trả bằng thẻ được không?",
                    "zh": "您能用卡付吗？"
                }
            ]
        },
        {
            "point": "「quét mã + 平台」表扫码支付",
            "explain": "扫码支付用「quét mã」+ 平台名称，如「quét mã ngân hàng」（扫银行码）。",
            "examples": [
                {
                    "vi": "Tôi quét mã để thanh toán.",
                    "zh": "我扫码支付。"
                },
                {
                    "vi": "Quét mã bằng ví điện tử.",
                    "zh": "用电子钱包扫码。"
                }
            ]
        }
    ],
