  "grammar": [
    {
      "point": "「làm việc ở + 地点」",
      "explain": "表示在某处工作用「làm việc ở + 地点」。口语中可省略「việc」，直接用「làm ở + 地点」。",
      "examples": [
        {
          "vi": "Tôi làm việc ở bệnh viện.",
          "zh": "我在医院工作。"
        },
        {
          "vi": "Anh ấy làm ở ngân hàng.",
          "zh": "他在银行工作。"
        }
      ]
    },
    {
      "point": "「ở」表地点",
      "explain": "「ở」相当于汉语的「在」，可以表示存在、居住、工作等。",
      "examples": [
        {
          "vi": "Chị ấy ở Hà Nội.",
          "zh": "她在河内。"
        },
        {
          "vi": "Tôi ở văn phòng.",
          "zh": "我在办公室。"
        }
      ]
    }
  ],
