    "grammar": [
        {
            "point": "「Tôi muốn + 动词」表意愿",
            "explain": "表达求职意愿用「Tôi muốn + 动词」，如「Tôi muốn ứng tuyển」（我想应聘）。",
            "examples": [
                {
                    "vi": "Tôi muốn tìm việc.",
                    "zh": "我想找工作。"
                },
                {
                    "vi": "Tôi muốn ứng tuyển vị trí này.",
                    "zh": "我想应聘这个职位。"
                }
            ]
        },
        {
            "point": "「có + 名词」表拥有",
            "explain": "介绍自己的经验、技能时用「Tôi có + 名词」，如「Tôi có kinh nghiệm」（我有经验）。",
            "examples": [
                {
                    "vi": "Tôi có kinh nghiệm 3 năm.",
                    "zh": "我有 3 年经验。"
                },
                {
                    "vi": "Tôi có kỹ năng giao tiếp.",
                    "zh": "我有沟通技能。"
                }
            ]
        }
