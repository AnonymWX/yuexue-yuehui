    "grammar": [
        {
            "point": "职业名词作表语",
            "explain": "越南语中介绍职业用「主语 + là + 职业名词」，不需要冠词。",
            "examples": [
                {
                    "vi": "Tôi là bác sĩ.",
                    "zh": "我是医生。"
                },
                {
                    "vi": "Anh ấy là kỹ sư.",
                    "zh": "他是工程师。"
                }
            ]
        },
        {
            "point": "职业名词的性别区分",
            "explain": "部分职业可通过前缀区分性别，如「nam bác sĩ」（男医生）、「nữ bác sĩ」（女医生），但日常多不区分。",
            "examples": [
                {
                    "vi": "Cô ấy là nữ bác sĩ.",
                    "zh": "她是女医生。"
                },
                {
                    "vi": "Anh ấy là nam y tá.",
                    "zh": "他是男护士。"
                }
            ]
        }
    ],
