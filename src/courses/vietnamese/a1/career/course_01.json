    "grammar": [
        {
            "point": "星期表达「thứ + 序数」",
            "explain": "越南语从「thứ hai」（第二）开始算一周的第一天，对应汉语的星期一。星期日用「chủ nhật」，不从 thứ 序列。",
            "examples": [
                {
                    "vi": "Thứ hai là ngày đầu tuần.",
                    "zh": "星期一是一周的第一天。"
                },
                {
                    "vi": "Chủ nhật tôi nghỉ.",
                    "zh": "星期日我休息。"
                }
            ]
        },
        {
            "point": "「vào thứ + 数字」表在某天",
            "explain": "表示「在星期几」用「vào thứ + 数字」，或直接说「thứ + 数字」。",
            "examples": [
                {
                    "vi": "Vào thứ hai tôi đi làm.",
                    "zh": "星期一我去上班。"
                },
                {
                    "vi": "Thứ bảy tôi đi chơi.",
                    "zh": "星期六我出去玩。"
                }
            ]
        }
    ],
