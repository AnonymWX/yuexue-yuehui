    "grammar": [
        {
            "point": "问职业「Làm nghề gì?」",
            "explain": "「Làm nghề gì?」是最常用的问职业句型，意为「做什么工作？」。也可用「Làm gì?」（更口语）。",
            "examples": [
                {
                    "vi": "Anh làm nghề gì?",
                    "zh": "你做什么工作？"
                },
                {
                    "vi": "Chị làm nghề gì?",
                    "zh": "你做什么工作？（女性）"
                }
            ]
        },
        {
            "point": "回答职业「Tôi làm + 职业」",
            "explain": "回答时用「Tôi làm + 职业名词」，或直接用「Tôi là + 职业名词」，后者更简洁。",
            "examples": [
                {
                    "vi": "Tôi làm giáo viên.",
                    "zh": "我当老师。"
                },
                {
                    "vi": "Tôi là nhân viên công ty.",
                    "zh": "我是公司职员。"
                }
            ]
        }
    ],
