    "grammar": [
        {
            "point": "自我介绍「Tôi tên là...」",
            "explain": "面试自我介绍通常以「Tôi tên là...」开头，然后介绍学历、经验和技能。",
            "examples": [
                {
                    "vi": "Tôi tên là Nam, tôi 25 tuổi.",
                    "zh": "我叫南，25 岁。"
                },
                {
                    "vi": "Tôi tốt nghiệp đại học.",
                    "zh": "我大学毕业。"
                }
            ]
        },
        {
            "point": "「điểm mạnh của tôi là...」",
            "explain": "回答优缺点时用「Điểm mạnh của tôi là...」（我的优点是……）和「Điểm yếu của tôi là...」（我的缺点是……）。",
            "examples": [
                {
                    "vi": "Điểm mạnh của tôi là chăm chỉ.",
                    "zh": "我的优点是勤奋。"
                },
                {
                    "vi": "Điểm yếu của tôi là thiếu kinh nghiệm.",
                    "zh": "我的缺点是经验不足。"
                }
            ]
        }
    ],
