    {
      "point": "问薪资「Lương bao nhiêu?」",
      "explain": "问工资用「Lương bao nhiêu?」（工资多少？），正式场合可用「Mức lương là bao nhiêu?」。",
      "examples": [
        {
          "vi": "Lương của anh bao nhiêu?",
          "zh": "你工资多少？"
        },
        {
          "vi": "Mức lương là bao nhiêu?",
          "zh": "薪资是多少？"
        }
      ]
    },
    {
      "point": "「có + 名词 + không?」疑问句",
      "explain": "问是否有某福利用「Có + 名词 + không?」，如「Có bảo hiểm không?」（有保险吗？）。",
      "examples": [
        {
          "vi": "Công ty có bảo hiểm không?",
          "zh": "公司有保险吗？"
        },
        {
          "vi": "Có phụ cấp không?",
          "zh": "有补贴吗？"
        }
      ]
    }
