    "grammar": [
        {
            "point": "「sinh nhật của tôi là ngày...」",
            "explain": "表达「我的生日是……」用「Sinh nhật của tôi là ngày + 数字 + tháng + 数字」。",
            "examples": [
                {
                    "vi": "Sinh nhật của tôi là ngày 15 tháng 8.",
                    "zh": "我的生日是 8 月 15 日。"
                },
                {
                    "vi": "Sinh nhật của anh ấy là ngày 1 tháng 1.",
                    "zh": "他的生日是 1 月 1 日。"
                }
            ]
        },
        {
            "point": "「tổ chức + 活动」表举办",
            "explain": "「tổ chức」意为「组织、举办」，后接活动名词，如「tổ chức tiệc sinh nhật」（举办生日派对）。",
            "examples": [
                {
                    "vi": "Tôi tổ chức tiệc sinh nhật.",
                    "zh": "我举办生日派对。"
                },
                {
                    "vi": "Chúng tôi tổ chức tiệc ở nhà.",
                    "zh": "我们在家举办派对。"
                }
            ]
        }
    ],
