    "grammar": [
        {
            "point": "「bao nhiêu tuổi」问年龄",
            "explain": "对成人问年龄用「bao nhiêu tuổi」，对小孩用「mấy tuổi」。回答用「số + tuổi」。",
            "examples": [
                {
                    "vi": "Anh bao nhiêu tuổi?",
                    "zh": "你多大了？"
                },
                {
                    "vi": "Em mấy tuổi?",
                    "zh": "你几岁了？"
                }
            ]
        },
        {
            "point": "年龄段的表达",
            "explain": "用「tuổi thơ」（童年）、「thanh xuân」（青春）、「trung niên」（中年，已引入）、「cao tuổi」（高龄）描述人生阶段。",
            "examples": [
                {
                    "vi": "Tuổi thơ của tôi rất đẹp.",
                    "zh": "我的童年很美好。"
                },
                {
                    "vi": "Bà tôi đã cao tuổi.",
                    "zh": "我奶奶已经高龄了。"
                }
            ]
        }
