  "grammar": [
    {
      "point": "问出生年份：sinh năm bao nhiêu?",
      "explain": "「sinh năm bao nhiêu?」= 哪年出生？回答「Tôi sinh năm + 年份」。越南语年号直接连写，如「1995」读作「một nghìn chín trăm chín mươi lăm」，「năm 1995」= 1995 年。注意：「năm」既是「年」，也可表示「五」，靠上下文区分。",
      "examples": [
        {
          "vi": "Bạn sinh năm bao nhiêu?",
          "zh": "你哪年出生？"
        },
        {
          "vi": "Tôi sinh năm 2000.",
          "zh": "我 2000 年出生。"
        }
      ]
    },
    {
      "point": "问年龄：bao nhiêu tuổi / mấy tuổi",
      "explain": "「bao nhiêu tuổi?」= 多大？「mấy tuổi?」= 几岁（问儿童更自然）。回答「Tôi + 数字 + tuổi」。注意越南语数词读法：mười lăm（15）、hai mươi（20）、ba mươi mốt（31）。亲属间问年龄很常见，不冒犯。",
      "examples": [
        {
          "vi": "Năm nay bạn bao nhiêu tuổi?",
          "zh": "今年你多大了？"
        },
        {
          "vi": "Em tôi mười tuổi.",
          "zh": "我弟弟十岁。"
        }
      ]
    }
  ],
