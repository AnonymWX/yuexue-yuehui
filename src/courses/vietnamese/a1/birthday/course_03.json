    "grammar": [
        {
            "point": "数字 1-10 与进位规律",
            "explain": "越南语数字 1-9：một / hai / ba / bốn / năm / sáu / bảy / tám / chín；10 是 mười。11 = mười một，20 = hai mươi，21 = hai mươi mốt。",
            "examples": [
                {
                    "vi": "Một, hai, ba, bốn, năm.",
                    "zh": "一、二、三、四、五。"
                },
                {
                    "vi": "Mười, hai mươi, ba mươi.",
                    "zh": "十、二十、三十。"
                }
            ]
        },
        {
            "point": "「mươi」与「mười」的区别",
            "explain": "单独说 10 用「mười」；10 作为十位时用「mươi」（如 20 = hai mươi）。注意 15 = mười lăm（不是 mười năm）。",
            "examples": [
                {
                    "vi": "Tôi ba mươi tuổi.",
                    "zh": "我三十岁。"
                },
                {
                    "vi": "Có hai mươi người.",
                    "zh": "有二十个人。"
                }
            ]
        }
    ],
