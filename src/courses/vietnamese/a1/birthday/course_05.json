  "grammar": [
    {
      "point": "问生日「Sinh nhật của bạn là ngày nào?」",
      "explain": "问生日用「Sinh nhật của bạn là ngày nào?」，回答用「là ngày + 数字 + tháng + 数字」。",
      "examples": [
        {
          "vi": "Sinh nhật của bạn là ngày nào?",
          "zh": "你的生日是哪天？"
        },
        {
          "vi": "Sinh nhật của tôi là ngày 20 tháng 10.",
          "zh": "我的生日是 10 月 20 日。"
        }
      ]
    },
    {
      "point": "祝贺语「Chúc mừng sinh nhật!」",
      "explain": "最常用的生日祝贺是「Chúc mừng sinh nhật!」（生日快乐！）。更完整可说「Chúc mừng sinh nhật, chúc bạn hạnh phúc」。",
      "examples": [
        {
          "vi": "Chúc mừng sinh nhật!",
          "zh": "生日快乐！"
        },
        {
          "vi": "Chúc mừng sinh nhật, chúc bạn khỏe mạnh.",
          "zh": "生日快乐，祝你健康。"
        }
      ]
    }
  ],
