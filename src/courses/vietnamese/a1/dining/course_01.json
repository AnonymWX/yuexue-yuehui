  "grammar": [
    {
      "point": "「quán + 品类」表专门店",
      "explain": "「quán」意为「店、馆」，后接品类表示专门店，如「quán ăn」（饭馆）、「quán cà phê」（咖啡店）。「nhà hàng」更正式，指正式餐厅。",
      "examples": [
        {
          "vi": "Chúng ta đi quán ăn nhé.",
          "zh": "我们去饭馆吧。"
        },
        {
          "vi": "Đây là nhà hàng lớn.",
          "zh": "这是家大餐厅。"
        }
      ]
    },
    {
      "point": "「chọn + 名词」表选择",
      "explain": "「chọn」意为「选择」，后接名词，如「chọn quán」（选店）。",
      "examples": [
        {
          "vi": "Tôi chọn quán này.",
          "zh": "我选这家店。"
        },
        {
          "vi": "Bạn chọn nhà hàng nào?",
          "zh": "你选哪家餐厅？"
        }
      ]
    }
  ],
