    "grammar": [
        {
            "point": "「nước + 品类」表饮品",
            "explain": "「nước」本义是水，也可指饮品，组合成「nước ngọt」（甜饮料→汽水）、「nước ép」（榨汁→果汁）。",
            "examples": [
                {
                    "vi": "Cho tôi một ly nước cam.",
                    "zh": "给我一杯橙汁。"
                },
                {
                    "vi": "Tôi muốn uống nước ngọt.",
                    "zh": "我想喝汽水。"
                }
            ]
        },
        {
            "point": "「cà phê + sữa/đá」表咖啡种类",
            "explain": "越南咖啡常用「cà phê sữa」（奶咖啡）、「cà phê đá」（冰咖啡）、「cà phê sữa đá」（冰奶咖啡）。",
            "examples": [
                {
                    "vi": "Cho tôi cà phê sữa đá.",
                    "zh": "给我冰奶咖啡。"
                },
                {
                    "vi": "Tôi uống cà phê đá.",
                    "zh": "我喝冰咖啡。"
                }
            ]
        }
    ],
