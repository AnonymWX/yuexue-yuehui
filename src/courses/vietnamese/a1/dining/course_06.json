    "grammar": [
        {
            "point": "「Mời + 人 + 动词」表请客",
            "explain": "用餐时常用「Mời + 人 + 动词」邀请对方，如「Mời anh ăn cơm」（请您吃饭）。",
            "examples": [
                {
                    "vi": "Mời anh ăn cơm.",
                    "zh": "请您吃饭。"
                },
                {
                    "vi": "Mời chị uống trà.",
                    "zh": "请您喝茶。"
                }
            ]
        },
        {
            "point": "「ăn cơm / uống nước」搭配",
            "explain": "「ăn」用于固体食物（吃饭、吃菜），「uống」用于液体（喝水、喝茶）。",
            "examples": [
                {
                    "vi": "Mời anh ăn cơm.",
                    "zh": "请您吃饭。"
                },
                {
                    "vi": "Mời chị uống nước.",
                    "zh": "请您喝水。"
                }
            ]
        }
