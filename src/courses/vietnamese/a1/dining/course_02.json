    "grammar": [
        {
            "point": "「đặt bàn + số người」表订桌人数",
            "explain": "订桌用「đặt bàn」，问人数用「cho mấy người?」（给几位？）。",
            "examples": [
                {
                    "vi": "Tôi muốn đặt bàn cho 4 người.",
                    "zh": "我想订 4 人的桌。"
                },
                {
                    "vi": "Anh đặt bàn mấy người?",
                    "zh": "您订几位的桌？"
                }
            ]
        },
        {
            "point": "「còn / hết + bàn」表还有/没桌",
            "explain": "「còn bàn」表示还有空桌，「hết bàn」表示满座。",
            "examples": [
                {
                    "vi": "Còn bàn không?",
                    "zh": "还有空桌吗？"
                },
                {
                    "vi": "Xin lỗi, hết bàn rồi.",
                    "zh": "抱歉，满座了。"
                }
            ]
        }
    ],
