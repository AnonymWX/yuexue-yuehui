    "grammar": [
        {
            "point": "礼貌投诉「Xin lỗi, món này bị...」",
            "explain": "礼貌投诉用「Xin lỗi, món này bị...」（不好意思，这道菜……），后接问题，如「bị sai」（上错了）、「bị nguội」（凉了）。",
            "examples": [
                {
                    "vi": "Xin lỗi, món này bị sai.",
                    "zh": "不好意思，这道菜上错了。"
                },
                {
                    "vi": "Xin lỗi, món này bị nguội.",
                    "zh": "不好意思，这道菜凉了。"
                }
            ]
        },
        {
            "point": "「đổi + 名词」表换",
            "explain": "「đổi」意为「换」，后接名词，如「đổi món」（换菜）、「đổi bàn」（换桌）。",
            "examples": [
                {
                    "vi": "Cho tôi đổi món khác.",
                    "zh": "请给我换一道菜。"
                },
                {
                    "vi": "Tôi muốn đổi bàn.",
                    "zh": "我想换桌。"
                }
            ]
        }
    ],
