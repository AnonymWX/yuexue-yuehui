    "grammar": [
        {
            "point": "「không + 动词」表不要",
            "explain": "表示「不要」用「không + 动词」，如「không cho đường」（不要放糖）、「không cho đá」（不要冰）。",
            "examples": [
                {
                    "vi": "Cho tôi cà phê không đường.",
                    "zh": "给我不加糖的咖啡。"
                },
                {
                    "vi": "Nước cam không đá.",
                    "zh": "橙汁不加冰。"
                }
            ]
        },
        {
            "point": "「ít / nhiều + 形容词」表少/多",
            "explain": "「ít」意为「少」，「nhiều」意为「多」，放在形容词前。",
            "examples": [
                {
                    "vi": "Cho ít đường.",
                    "zh": "少放糖。"
                },
                {
                    "vi": "Cho nhiều đá.",
                    "zh": "多放冰。"
                }
            ]
        }
    ],
