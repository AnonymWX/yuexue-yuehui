    "grammar": [
        {
            "point": "「... ở đâu?」问地点",
            "explain": "问某地在哪用「地点 + ở đâu?」，如「Chợ ở đâu?」（市场在哪？）。",
            "examples": [
                {
                    "vi": "Chợ ở đâu?",
                    "zh": "市场在哪？"
                },
                {
                    "vi": "Bệnh viện ở đâu?",
                    "zh": "医院在哪？"
                }
            ]
        },
        {
            "point": "「ở + 地点」表在某处",
            "explain": "「ở」意为「在」，后接地点名词，如「ở chợ」（在市场）。",
            "examples": [
                {
                    "vi": "Chợ ở gần đây.",
                    "zh": "市场在附近。"
                },
                {
                    "vi": "Bệnh viện ở phía bắc.",
                    "zh": "医院在北边。"
                }
            ]
        }
    ],
