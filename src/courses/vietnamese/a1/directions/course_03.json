  "grammar": [
    {
      "point": "「ở ngã tư / ngã ba」表在路口",
      "explain": "「ở ngã tư」意为「在十字路口」，「ở ngã ba」意为「在三岔路口」。",
      "examples": [
        {
          "vi": "Tôi ở ngã tư.",
          "zh": "我在十字路口。"
        },
        {
          "vi": "Rẽ trái ở ngã ba.",
          "zh": "在三岔路口左转。"
        }
      ]
    },
    {
      "point": "「qua + 地点」表穿过",
      "explain": "「qua」意为「过、穿过」，如「qua cầu」（过桥）。",
      "examples": [
        {
          "vi": "Đi qua cầu.",
          "zh": "过桥。"
        },
        {
          "vi": "Đi qua ngã tư.",
          "zh": "穿过十字路口。"
        }
      ]
    }
  ],
