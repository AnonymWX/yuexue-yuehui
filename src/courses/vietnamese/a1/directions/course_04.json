    "grammar": [
        {
            "point": "礼貌问路「Xin lỗi, cho tôi hỏi...」",
            "explain": "礼貌问路以「Xin lỗi」开头，后接「cho tôi hỏi」（请问），再接具体问题。",
            "examples": [
                {
                    "vi": "Xin lỗi, cho tôi hỏi chợ ở đâu?",
                    "zh": "对不起，请问市场在哪？"
                },
                {
                    "vi": "Xin lỗi, làm ơn chỉ đường giúp tôi.",
                    "zh": "对不起，劳驾帮我指路。"
                }
            ]
        },
        {
            "point": "「chỉ + 名词 + cho + 人」表给某人指",
            "explain": "「chỉ」意为「指」，结构为「chỉ + 名词 + cho + 人」，如「chỉ đường cho tôi」（给我指路）。",
            "examples": [
                {
                    "vi": "Anh ấy chỉ đường cho tôi.",
                    "zh": "他给我指路。"
                },
                {
                    "vi": "Cô ấy chỉ vị trí cho tôi.",
                    "zh": "她给我指位置。"
                }
            ]
        }
    ],
