    "grammar": [
        {
            "point": "「rẽ trái / rẽ phải」表向左/右转",
            "explain": "表示「向左转」用「rẽ trái」，「向右转」用「rẽ phải」。南方用「quẹo trái / quẹo phải」。",
            "examples": [
                {
                    "vi": "Rẽ trái ở ngã tư.",
                    "zh": "在十字路口左转。"
                },
                {
                    "vi": "Quẹo phải ở ngã ba.",
                    "zh": "在三岔路口右转。"
                }
            ]
        },
        {
            "point": "「đi thẳng + 距离」表直走多远",
            "explain": "表示「直走多远」用「đi thẳng + 距离」，如「đi thẳng 100 mét」（直走 100 米）。",
            "examples": [
                {
                    "vi": "Đi thẳng 100 mét.",
                    "zh": "直走 100 米。"
                },
                {
                    "vi": "Đi thẳng rồi rẽ trái.",
                    "zh": "直走然后左转。"
                }
            ]
        }
    ],
