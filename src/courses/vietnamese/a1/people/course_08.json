    "grammar": [
        {
            "point": "「cửa hàng + 品类」表专门店",
            "explain": "「cửa hàng」意为「店」，后接品类表示专门店，如「cửa hàng quần áo」（服装店）、「cửa hàng sách」（书店）。",
            "examples": [
                {
                    "vi": "Tôi đi cửa hàng quần áo.",
                    "zh": "我去服装店。"
                },
                {
                    "vi": "Cửa hàng sách ở gần đây.",
                    "zh": "书店在附近。"
                }
            ]
        },
        {
            "point": "「siêu thị / chợ / trung tâm thương mại」三类场所对比",
            "explain": "「siêu thị」超市（自选）、「chợ」市场（摊贩）、「trung tâm thương mại」购物中心（综合体）。",
            "examples": [
                {
                    "vi": "Tôi đi siêu thị mua đồ.",
                    "zh": "我去超市买东西。"
                },
                {
                    "vi": "Chợ đông người.",
                    "zh": "市场人很多。"
                }
            ]
        }
    ],
