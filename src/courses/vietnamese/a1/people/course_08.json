  "grammar": [
    {
      "point": "询问职业：làm nghề gì? / làm gì?",
      "explain": "「Bạn làm nghề gì?」= 你做什么职业？回答用「Tôi làm + 职业」或「Tôi là + 职业」。「làm」更强调动作（从事），「là」更强调身份（是）。日常口语两种都可。",
      "examples": [
        {
          "vi": "Bạn làm nghề gì?",
          "zh": "你做什么工作？"
        },
        {
          "vi": "Tôi là giáo viên.",
          "zh": "我是教师。"
        }
      ]
    },
    {
      "point": "职业名词不加量词",
      "explain": "职业名词在句中一般不加量词（不同于「cái bát」）。当指具体某人时才加「người / anh / chị」等：một người giáo viên（一位教师）——口语里更常说「một giáo viên」。中文「一个医生」对应「một bác sĩ」。",
      "examples": [
        {
          "vi": "Anh ấy là bác sĩ.",
          "zh": "他是医生。"
        },
        {
          "vi": "Có hai giáo viên trong lớp.",
          "zh": "教室里有两位老师。"
        }
      ]
    }
  ],
