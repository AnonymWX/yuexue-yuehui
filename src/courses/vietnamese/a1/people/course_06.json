    "grammar": [
        {
            "point": "「hơi + 形容词」缓和语气",
            "explain": "「hơi」意为「有点」，加在形容词前可缓和批评语气，如「hơi lười」（有点懒）。",
            "examples": [
                {
                    "vi": "Anh ấy hơi lười.",
                    "zh": "他有点懒。"
                },
                {
                    "vi": "Cô ấy hơi nóng tính.",
                    "zh": "她有点急躁。"
                }
            ]
        },
        {
            "point": "「không được + 形容词」表不适合",
            "explain": "「không được」加形容词表示「不太好」，用于委婉评价。",
            "examples": [
                {
                    "vi": "Anh ấy không được chăm chỉ.",
                    "zh": "他不太勤奋。"
                },
                {
                    "vi": "Cô ấy không được thân thiện.",
                    "zh": "她不太友好。"
                }
            ]
        }
    ],
