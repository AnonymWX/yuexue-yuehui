    "grammar": [
        {
            "point": "「mặc + 服装」表穿",
            "explain": "「mặc」意为「穿」，后接服装名词，如「mặc áo」（穿衣服）。鞋帽用「đi」或「đội」。",
            "examples": [
                {
                    "vi": "Cô ấy mặc áo đẹp.",
                    "zh": "她穿着漂亮的衣服。"
                },
                {
                    "vi": "Anh ấy đi giày mới.",
                    "zh": "他穿着新鞋。"
                }
            ]
        },
        {
            "point": "「đang mặc」表现在穿着",
            "explain": "表示「正在穿」用「đang mặc」，描述当前穿着状态。",
            "examples": [
                {
                    "vi": "Cô ấy đang mặc váy.",
                    "zh": "她正穿着裙子。"
                },
                {
                    "vi": "Anh ấy đang đội mũ.",
                    "zh": "他正戴着帽子。"
                }
            ]
        }
    ],
