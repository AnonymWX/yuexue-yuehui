    "grammar": [
        {
            "point": "「tính cách + 形容词」描述性格",
            "explain": "描述性格用「tính cách + 形容词」，也可直接说「主语 + 形容词」表示性格。",
            "examples": [
                {
                    "vi": "Tính cách của anh ấy rất tốt.",
                    "zh": "他的性格很好。"
                },
                {
                    "vi": "Cô ấy chăm chỉ.",
                    "zh": "她勤奋。"
                }
            ]
        },
        {
            "point": "「rất / lắm / quá」程度副词",
            "explain": "「rất」放在形容词前，表示「很」；「lắm」和「quá」放在形容词后，也表示「很/太」。",
            "examples": [
                {
                    "vi": "Anh ấy rất thông minh.",
                    "zh": "他很聪明。"
                },
                {
                    "vi": "Cô ấy tốt bụng lắm.",
                    "zh": "她很善良。"
                }
            ]
        }
    ],
