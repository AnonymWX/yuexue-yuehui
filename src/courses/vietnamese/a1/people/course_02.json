  "grammar": [
    {
      "point": "「có + 名词 + 形容词」描述特征",
      "explain": "描述某人某部位特征用「主语 + có + 名词 + 形容词」，如「Cô ấy có mắt đẹp」（她的眼睛漂亮）。",
      "examples": [
        {
          "vi": "Cô ấy có mắt đẹp.",
          "zh": "她的眼睛漂亮。"
        },
        {
          "vi": "Anh ấy có tóc dài.",
          "zh": "他头发长。"
        }
      ]
    },
    {
      "point": "「mặt + 形容词」表脸型",
      "explain": "描述脸型用「mặt + 形容词」，如「mặt tròn」（圆脸）、「mặt dài」（长脸）。",
      "examples": [
        {
          "vi": "Cô ấy có mặt tròn.",
          "zh": "她是圆脸。"
        },
        {
          "vi": "Anh ấy có mặt dài.",
          "zh": "他是长脸。"
        }
      ]
    }
  ],
