    "grammar": [
        {
            "point": "「cảm thấy + 情绪」表感觉",
            "explain": "表达情绪常用「cảm thấy + 情绪形容词」，如「cảm thấy vui」（感到开心）。",
            "examples": [
                {
                    "vi": "Tôi cảm thấy hạnh phúc.",
                    "zh": "我感到幸福。"
                },
                {
                    "vi": "Tôi cảm thấy lo lắng.",
                    "zh": "我感到担心。"
                }
            ]
        },
        {
            "point": "「làm cho + 人 + 情绪」表使役",
            "explain": "表示「让某人感到……」用「làm cho + 人 + 情绪形容词」。",
            "examples": [
                {
                    "vi": "Điều này làm cho tôi lo lắng.",
                    "zh": "这让我担心。"
                },
                {
                    "vi": "Anh ấy làm cho tôi giận.",
                    "zh": "他让我生气。"
                }
            ]
        }
    ],
