    "grammar": [
        {
            "point": "形容词语序：「người + 形容词」",
            "explain": "越南语描述人的外貌用「người + 形容词」结构，người 在此作主语，等于「这个人/那人」。口语中 người 可省略，直接说「Anh ấy cao」。形容词直接跟主语，不加「là」。",
            "examples": [
                {
                    "vi": "Anh ấy cao và gầy.",
                    "zh": "他又高又瘦。"
                },
                {
                    "vi": "Cô ấy đẹp và trẻ.",
                    "zh": "她又漂亮又年轻。"
                }
            ]
        },
        {
            "point": "程度副词：rất / hơi / quá",
            "explain": "「rất + 形容词」= 很…（书面，放前）；「hơi + 形容词」= 有点…（放前）；「quá」= 太…（放后，感叹）。三者在 A1 高频，描述外貌时常用 hơi 缓解语气（hơi béo = 有点胖，礼貌）。",
            "examples": [
                {
                    "vi": "Em ấy hơi béo.",
                    "zh": "他/她有点胖。"
                },
                {
                    "vi": "Bạn tôi rất cao.",
                    "zh": "我朋友很高。"
                }
            ]
        }
    ],
