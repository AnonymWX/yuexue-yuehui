    "grammar": [
        {
            "point": "「để lại lời nhắn」表留言",
            "explain": "「để lại」意为「留下」，「lời nhắn」意为「留言」，合起来表示「留言」。",
            "examples": [
                {
                    "vi": "Tôi muốn để lại lời nhắn.",
                    "zh": "我想留言。"
                },
                {
                    "vi": "Anh có muốn để lại lời nhắn không?",
                    "zh": "您要留言吗？"
                }
            ]
        },
        {
            "point": "「nhắn + 人 + 动词」表通知",
            "explain": "「nhắn」意为「通知、转告」，结构为「nhắn + 人 + 动词」，如「nhắn anh ấy gọi lại」（转告他回电）。",
            "examples": [
                {
                    "vi": "Nhắn anh ấy gọi lại cho tôi.",
                    "zh": "转告他给我回电。"
                },
                {
                    "vi": "Nhắn chị ấy tôi đã gọi.",
                    "zh": "转告她我打过电话。"
                }
            ]
        }
    ],
