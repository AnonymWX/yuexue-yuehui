    "grammar": [
        {
            "point": "「A lô」与「Xin nghe」的区别",
            "explain": "「A lô」是接电话时的招呼语，相当于汉语的「喂」。「Xin nghe」更正式，意为「请讲」，多用于商务场合。",
            "examples": [
                {
                    "vi": "A lô, tôi nghe đây.",
                    "zh": "喂，我在听。"
                },
                {
                    "vi": "Xin nghe, ai đấy ạ?",
                    "zh": "请讲，请问是哪位？"
                }
            ]
        },
        {
            "point": "问对方是谁「Ai đấy ạ?」",
            "explain": "电话中问对方是谁用「Ai đấy ạ?」（是哪位？），比「Ai đấy?」更礼貌。",
            "examples": [
                {
                    "vi": "A lô, ai đấy ạ?",
                    "zh": "喂，请问是哪位？"
                },
                {
                    "vi": "Xin nghe, ai đấy ạ?",
                    "zh": "请讲，请问是哪位？"
                }
            ]
        }
    ],
