    "grammar": [
        {
            "point": "日期表达「ngày mùng + 数字」",
            "explain": "1 号到 10 号用「ngày mùng + 数字」，如「ngày mùng 1」（1 号）。11 号以上直接用「ngày + 数字」。",
            "examples": [
                {
                    "vi": "Hôm nay là ngày mùng 1.",
                    "zh": "今天是 1 号。"
                },
                {
                    "vi": "Ngày 15 là rằm.",
                    "zh": "15 号是农历十五。"
                }
            ]
        },
        {
            "point": "「đầu / giữa / cuối + tháng」表月内阶段",
            "explain": "用「đầu tháng」（月初）、「giữa tháng」（月中）、「cuối tháng」（月底）表示月份内的不同阶段。",
            "examples": [
                {
                    "vi": "Đầu tháng tôi bận.",
                    "zh": "月初我忙。"
                },
                {
                    "vi": "Cuối tháng tôi đi chơi.",
                    "zh": "月底我出去玩。"
                }
            ]
        }
    ],
