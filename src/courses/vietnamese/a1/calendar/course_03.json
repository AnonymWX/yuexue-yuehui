  "grammar": [
    {
      "point": "月份表达「tháng + 数字」",
      "explain": "越南语月份从「tháng một」（一月）开始，直接「tháng + 数字」。注意「tháng tư」（四月）用「tư」而不是「bốn」。",
      "examples": [
        {
          "vi": "Tháng một là tháng đầu năm.",
          "zh": "一月是一年的第一个月。"
        },
        {
          "vi": "Tháng tư tôi đi du lịch.",
          "zh": "四月我去旅游。"
        }
      ]
    },
    {
      "point": "「vào tháng + 数字」表在某月",
      "explain": "表示在某月用「vào tháng + 数字」，如「vào tháng ba」（在三月）。",
      "examples": [
        {
          "vi": "Vào tháng ba tôi đi du lịch.",
          "zh": "三月我去旅游。"
        },
        {
          "vi": "Sinh nhật tôi vào tháng tư.",
          "zh": "我的生日在四月。"
        }
      ]
    }
  ],
