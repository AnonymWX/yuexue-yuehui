  "grammar": [
    {
      "point": "「năm + 数字」表年份",
      "explain": "年份用「năm + 数字」，如「năm 2026」（2026 年）。「năm nay」表示今年。",
      "examples": [
        {
          "vi": "Năm nay là năm 2026.",
          "zh": "今年是 2026 年。"
        },
        {
          "vi": "Tôi sinh năm 2000.",
          "zh": "我 2000 年出生。"
        }
      ]
    },
    {
      "point": "「năm nay / ngoái / sau」三时",
      "explain": "「năm nay」今年、「năm ngoái」去年、「năm sau」明年，三个一组记忆。",
      "examples": [
        {
          "vi": "Năm ngoái tôi ở Trung Quốc.",
          "zh": "去年我在中国。"
        },
        {
          "vi": "Năm sau tôi sẽ đi Việt Nam.",
          "zh": "明年我要去越南。"
        }
      ]
    }
