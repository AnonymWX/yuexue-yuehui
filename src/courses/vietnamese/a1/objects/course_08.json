    "grammar": [
        {
            "point": "形容词作谓语「主语 + 形容词」",
            "explain": "越南语形容词可直接作谓语，不需要系动词，如「Anh ấy cao」（他高）。",
            "examples": [
                {
                    "vi": "Anh ấy cao.",
                    "zh": "他高。"
                },
                {
                    "vi": "Cô ấy đẹp.",
                    "zh": "她漂亮。"
                }
            ]
        },
        {
            "point": "「trông + 形容词」表看起来",
            "explain": "「trông」意为「看起来」，后接形容词表示外观给人印象。",
            "examples": [
                {
                    "vi": "Cô ấy trông trẻ.",
                    "zh": "她看起来很年轻。"
                },
                {
                    "vi": "Anh ấy trông mập.",
                    "zh": "他看起来很胖。"
                }
            ]
        }
    ],
