  "grammar": [
    {
      "point": "成对量词 đôi",
      "explain": "「đôi」用于成对物品（đôi đũa 一双筷子 / đôi giày 一双鞋 / đôi tất 一双袜子）。其他无生命物品用「cái」，与「第 1 课：日常物品与量词」一致。数量放在量词前：một đôi đũa、hai cái bát。",
      "examples": [
        {
          "vi": "Một đôi đũa.",
          "zh": "一双筷子。"
        },
        {
          "vi": "Hai cái bát.",
          "zh": "两个碗。"
        }
      ]
    },
    {
      "point": "位置介词 trong / trên / ở",
      "explain": "「trong」= 在……里（盒子、冰箱、袋子内部）；「trên」= 在……上（桌面、货架表面）；「ở」= 在（地点/位置）。三者语序都是「介词 + 名词 + 动词/谓语」或「名词 + 介词 + 名词」。",
      "examples": [
        {
          "vi": "Chai nước ở trong tủ lạnh.",
          "zh": "水瓶在冰箱里。"
        },
        {
          "vi": "Bát ở trên bàn.",
          "zh": "碗在桌上。"
        }
      ]
    }
  ],
