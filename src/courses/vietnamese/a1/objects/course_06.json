  "grammar": [
    {
      "point": "「làm bằng + 材料」表材质",
      "explain": "表示物品由什么材料制成用「làm bằng + 材料」，如「làm bằng gỗ」（木制的）。",
      "examples": [
        {
          "vi": "Cái bàn này làm bằng gỗ.",
          "zh": "这张桌子是木制的。"
        },
        {
          "vi": "Cái ly này làm bằng thủy tinh.",
          "zh": "这个杯子是玻璃制的。"
        }
      ]
    },
    {
      "point": "材料名词的常见搭配",
      "explain": "越南语中材料名词可以直接作定语，也可以与「làm bằng」搭配。注意「da」有「皮/皮革」和「石头」两种意思，语境区分。",
      "examples": [
        {
          "vi": "Cái túi này làm bằng da.",
          "zh": "这个包是皮革制的。"
        },
        {
          "vi": "Cái áo này làm bằng vải.",
          "zh": "这件衣服是布制的。"
        }
      ]
    }
  ],
