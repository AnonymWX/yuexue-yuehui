    "grammar": [
        {
            "point": "「dùng + 名词 + để + 动词」表用途",
            "explain": "表示「用某物来做某事」用「dùng + 名词 + để + 动词」，如「dùng bút để viết」（用笔写字）。",
            "examples": [
                {
                    "vi": "Tôi dùng bút để viết.",
                    "zh": "我用笔写字。"
                },
                {
                    "vi": "Tôi dùng thước để vẽ.",
                    "zh": "我用尺子画图。"
                }
            ]
        },
        {
            "point": "文具量词「cái / quyển / tờ」",
            "explain": "文具类量词：笔、尺、橡皮等用「cái」；书本、笔记本用「quyển」；纸用「tờ」。",
            "examples": [
                {
                    "vi": "Đây là cái bút.",
                    "zh": "这是笔。"
                },
                {
                    "vi": "Đây là quyển vở.",
                    "zh": "这是笔记本。"
                }
            ]
        }
    ],
