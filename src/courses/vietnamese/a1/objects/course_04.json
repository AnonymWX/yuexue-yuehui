  "grammar": [
    {
      "point": "「Nhà tôi có + 名词」表拥有",
      "explain": "表示「我家有……」用「Nhà tôi có + 名词」。泛指「有」时也可省略「nhà」，直接用「Tôi có...」。",
      "examples": [
        {
          "vi": "Nhà tôi có tivi.",
          "zh": "我家有电视。"
        },
        {
          "vi": "Nhà tôi có tủ lạnh.",
          "zh": "我家有冰箱。"
        }
      ]
    },
    {
      "point": "家电名词的组合特点",
      "explain": "越南语家电名词多为组合词，如「tủ lạnh」（冷柜→冰箱）、「máy giặt」（洗衣机器→洗衣机）、「điều hòa」（调节→空调）。",
      "examples": [
        {
          "vi": "Đây là tủ lạnh.",
          "zh": "这是冰箱。"
        },
        {
          "vi": "Đây là máy giặt.",
          "zh": "这是洗衣机。"
        }
      ]
    }
  ],
