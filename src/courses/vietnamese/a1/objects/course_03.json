    "grammar": [
        {
            "point": "形容词作谓语「名词 + 形容词」",
            "explain": "越南语中形容词可直接跟在名词后作谓语，不需要「是」。如「Cái bàn này to」（这张桌子大）。",
            "examples": [
                {
                    "vi": "Cái bàn này to.",
                    "zh": "这张桌子大。"
                },
                {
                    "vi": "Quyển sách này nhỏ.",
                    "zh": "这本书小。"
                }
            ]
        },
        {
            "point": "指示词「này / kia」后置",
            "explain": "「này」（这）和「kia」（那）放在名词之后，如「cái bàn này」（这张桌子）、「cái bàn kia」（那张桌子）。",
            "examples": [
                {
                    "vi": "Cái ghế này mới.",
                    "zh": "这把椅子新。"
                },
                {
                    "vi": "Cái bàn kia cũ.",
                    "zh": "那张桌子旧。"
                }
            ]
        }
    ],
