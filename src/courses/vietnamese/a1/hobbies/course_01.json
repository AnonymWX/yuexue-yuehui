    "grammar": [
        {
            "point": "「Sở thích của tôi là + 动词」表爱好",
            "explain": "介绍爱好用「Sở thích của tôi là + 动词短语」，如「Sở thích của tôi là đọc sách」（我的爱好是读书）。",
            "examples": [
                {
                    "vi": "Sở thích của tôi là đọc sách.",
                    "zh": "我的爱好是读书。"
                },
                {
                    "vi": "Sở thích của tôi là nghe nhạc.",
                    "zh": "我的爱好是听音乐。"
                }
            ]
        },
        {
            "point": "「thích + 动词/名词」表喜欢",
            "explain": "「thích」后接动词或名词，如「thích đọc sách」（喜欢读书）、「thích âm nhạc」（喜欢音乐）。",
            "examples": [
                {
                    "vi": "Tôi thích đọc sách.",
                    "zh": "我喜欢读书。"
                },
                {
                    "vi": "Anh ấy thích nghe nhạc.",
                    "zh": "他喜欢听音乐。"
                }
            ]
        }
    ],
