    "grammar": [
        {
            "point": "「đi + 休闲活动」表去做某事",
            "explain": "外出休闲用「đi + 活动」，如「đi du lịch」（去旅游）、「đi cắm trại」（去露营）、「đi câu cá」（去钓鱼）。",
            "examples": [
                {
                    "vi": "Cuối tuần tôi đi du lịch.",
                    "zh": "周末我去旅游。"
                },
                {
                    "vi": "Anh ấy đi câu cá.",
                    "zh": "他去钓鱼。"
                }
            ]
        },
        {
            "point": "「chụp ảnh / đàn guitar / vẽ」艺术类活动",
            "explain": "艺术类活动用动词原形，如「chụp ảnh」（拍照）、「đàn guitar」（弹吉他）、「vẽ」（画画）。",
            "examples": [
                {
                    "vi": "Tôi thích chụp ảnh.",
                    "zh": "我喜欢拍照。"
                },
                {
                    "vi": "Cô ấy biết đàn guitar.",
                    "zh": "她会弹吉他。"
                }
            ]
        }
    ],
