    {
      "point": "「chơi + 球类运动」表玩球",
      "explain": "球类运动用「chơi + 运动名」，如「chơi bóng đá」（踢足球）、「chơi bóng rổ」（打篮球）。",
      "examples": [
        {
          "vi": "Tôi chơi bóng đá.",
          "zh": "我踢足球。"
        },
        {
          "vi": "Anh ấy chơi cầu lông.",
          "zh": "他打羽毛球。"
        }
      ]
    },
    {
      "point": "「tập + 运动/健身」表锻炼",
      "explain": "「tập」表示「练习、锻炼」，如「tập thể dục」（做运动）、「tập bơi」（练游泳）。",
      "examples": [
        {
          "vi": "Tôi tập thể dục mỗi sáng.",
          "zh": "我每天早上做运动。"
        },
        {
          "vi": "Cô ấy tập bơi.",
          "zh": "她练游泳。"
        }
      ]
    }
