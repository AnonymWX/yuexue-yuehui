    "grammar": [
        {
            "point": "频率副词的位置",
            "explain": "频率副词放在动词前：主语 + 频率副词 + 动词。如「Tôi thường đọc sách」（我常读书）。",
            "examples": [
                {
                    "vi": "Tôi thường đọc sách.",
                    "zh": "我常读书。"
                },
                {
                    "vi": "Anh ấy luôn luôn nghe nhạc.",
                    "zh": "他总是听音乐。"
                }
            ]
        },
        {
            "point": "「thỉnh thoảng / hiếm khi / không bao giờ」频率递减",
            "explain": "频率递减：「luôn luôn」（总是）>「thường xuyên」（经常）>「thỉnh thoảng」（偶尔）>「hiếm khi」（很少）>「không bao giờ」（从不）。",
            "examples": [
                {
                    "vi": "Tôi thỉnh thoảng xem phim.",
                    "zh": "我偶尔看电影。"
                },
                {
                    "vi": "Tôi không bao giờ hút thuốc.",
                    "zh": "我从不抽烟。"
                }
            ]
        }
    ],
