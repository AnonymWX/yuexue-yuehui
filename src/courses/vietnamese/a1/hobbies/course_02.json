    "grammar": [
        {
            "point": "「Sở thích của bạn là gì?」问爱好",
            "explain": "问爱好用「Sở thích của bạn là gì?」，回答用「Sở thích của tôi là...」或「Tôi thích...」。",
            "examples": [
                {
                    "vi": "Sở thích của bạn là gì?",
                    "zh": "你的爱好是什么？"
                },
                {
                    "vi": "Sở thích của tôi là đọc sách.",
                    "zh": "我的爱好是读书。"
                }
            ]
        },
        {
            "point": "「Có thích... không?」问是否喜欢",
            "explain": "问「你喜欢……吗」用「Bạn có thích... không?」，回答「Có, tôi thích」或「Không, tôi không thích」。",
            "examples": [
                {
                    "vi": "Bạn có thích nghe nhạc không?",
                    "zh": "你喜欢听音乐吗？"
                },
                {
                    "vi": "Có, tôi rất thích.",
                    "zh": "是的，我很喜欢。"
                }
            ]
        }
    ],
