    "grammar": [
        {
            "point": "「tham gia + 活动/组织」表参加",
            "explain": "「tham gia」意为「参加」，后接活动或组织，如「tham gia câu lạc bộ」（参加俱乐部）。",
            "examples": [
                {
                    "vi": "Tôi tham gia câu lạc bộ bóng đá.",
                    "zh": "我参加足球俱乐部。"
                },
                {
                    "vi": "Anh ấy tham gia hội đọc sách.",
                    "zh": "他参加读书会。"
                }
            ]
        },
        {
            "point": "「vì + 名词 + nên + 结果」表因果关系",
            "explain": "「vì... nên...」表示「因为……所以……」，用于说明爱好带来的结果。",
            "examples": [
                {
                    "vi": "Vì thích đọc sách nên tôi tham gia hội đọc sách.",
                    "zh": "因为喜欢读书，所以我参加读书会。"
                },
                {
                    "vi": "Vì chơi bóng đá nên tôi kết bạn nhiều.",
                    "zh": "因为踢足球，所以我交了很多朋友。"
                }
            ]
        }
    ],
