    "grammar": [
        {
            "point": "「từ + 起点 + đến + 终点」",
            "explain": "表示「从……到……」用「từ + 起点 + đến + 终点」，可用于时间或地点。",
            "examples": [
                {
                    "vi": "Tôi làm việc từ 8 giờ đến 5 giờ.",
                    "zh": "我从 8 点工作到 5 点。"
                },
                {
                    "vi": "Từ thứ hai đến thứ sáu tôi đi học.",
                    "zh": "周一到周五我上学。"
                }
            ]
        },
        {
            "point": "「mỗi / hàng + 时间单位」表频率",
            "explain": "「mỗi」和「hàng」都表示「每」，后接时间单位，如「mỗi ngày」（每天）、「hàng tuần」（每周）。",
            "examples": [
                {
                    "vi": "Mỗi ngày tôi học tiếng Việt.",
                    "zh": "我每天学越南语。"
                },
                {
                    "vi": "Hàng tuần tôi đi chợ.",
                    "zh": "我每周去市场。"
                }
            ]
        }
    ],
