    "grammar": [
        {
            "point": "「số giờ + số phút」表几点几分",
            "explain": "表达几点几分用「数字 + giờ + 数字 + phút」，如「bảy giờ mười lăm phút」（7 点 15 分）。口语可省略「phút」。",
            "examples": [
                {
                    "vi": "Bây giờ là bảy giờ mười lăm.",
                    "zh": "现在 7 点 15。"
                },
                {
                    "vi": "Tám giờ ba mươi phút tôi đến.",
                    "zh": "我 8 点 30 到。"
                }
            ]
        },
        {
            "point": "「kém」表差几分",
            "explain": "表示「差几分到几点」用「kém + 数字 + phút」，如「bảy giờ kém mười lăm」（差 15 分 7 点，即 6:45）。",
            "examples": [
                {
                    "vi": "Bây giờ là tám giờ kém mười lăm.",
                    "zh": "现在差 15 分 8 点。"
                },
                {
                    "vi": "Mười giờ kém năm tôi về.",
                    "zh": "我差 5 分 10 点回家。"
                }
            ]
        }
    ],
