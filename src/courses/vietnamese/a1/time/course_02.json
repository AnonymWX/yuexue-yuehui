  "grammar": [
    {
      "point": "整点「số + giờ」",
      "explain": "整点直接用「数字 + giờ」，如「bảy giờ」（7 点）。强调整点可说「đúng bảy giờ」。",
      "examples": [
        {
          "vi": "Bây giờ là bảy giờ.",
          "zh": "现在 7 点。"
        },
        {
          "vi": "Đúng bảy giờ tôi đi làm.",
          "zh": "我 7 点整去上班。"
        }
      ]
    },
    {
      "point": "半点「số + giờ + rưỡi」",
      "explain": "半点用「数字 + giờ + rưỡi」，如「bảy giờ rưỡi」（7 点半）。",
      "examples": [
        {
          "vi": "Bây giờ là bảy giờ rưỡi.",
          "zh": "现在 7 点半。"
        },
        {
          "vi": "Tám giờ rưỡi tôi tan làm.",
          "zh": "我 8 点半下班。"
        }
      ]
    }
  ],
