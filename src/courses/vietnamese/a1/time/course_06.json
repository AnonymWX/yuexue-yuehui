    "grammar": [
        {
            "point": "时间状语「lúc + 时间」",
            "explain": "用「lúc + 时间」表示动作发生的时间，如「lúc 6 giờ」（6 点时）。",
            "examples": [
                {
                    "vi": "Lúc 6 giờ tôi thức dậy.",
                    "zh": "我 6 点起床。"
                },
                {
                    "vi": "Lúc 7 giờ tôi ăn sáng.",
                    "zh": "我 7 点吃早饭。"
                }
            ]
        },
        {
            "point": "「sau đó / rồi」表顺序",
            "explain": "表示动作顺序用「sau đó」或「rồi」，意为「然后」。",
            "examples": [
                {
                    "vi": "Tôi thức dậy, sau đó ăn sáng.",
                    "zh": "我起床，然后吃早饭。"
                },
                {
                    "vi": "Tôi đi làm, rồi về nhà.",
                    "zh": "我去上班，然后回家。"
                }
            ]
        }
    ],
