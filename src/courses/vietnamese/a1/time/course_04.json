    "grammar": [
        {
            "point": "「buổi + 时段」表时段",
            "explain": "「buổi」意为「时段」，与时段词组合，如「buổi sáng」（早上）、「buổi chiều」（下午）、「buổi tối」（晚上）。",
            "examples": [
                {
                    "vi": "Buổi sáng tôi học tiếng Việt.",
                    "zh": "早上我学越南语。"
                },
                {
                    "vi": "Buổi tối tôi xem tivi.",
                    "zh": "晚上我看电视。"
                }
            ]
        },
        {
            "point": "「vào + 时段」表在某个时段",
            "explain": "「vào」意为「在……时」，后接时段词，如「vào buổi sáng」（在早上）。",
            "examples": [
                {
                    "vi": "Vào buổi sáng, tôi đi làm.",
                    "zh": "早上我去上班。"
                },
                {
                    "vi": "Vào buổi tối, tôi nghỉ ngơi.",
                    "zh": "晚上我休息。"
                }
            ]
        }
    ],
