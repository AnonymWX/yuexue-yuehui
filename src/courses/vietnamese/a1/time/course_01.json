    "grammar": [
        {
            "point": "问时间「Bây giờ là mấy giờ?」",
            "explain": "最常用的问时间句型是「Bây giờ là mấy giờ?」（现在几点？），口语可省略「là」说成「Bây giờ mấy giờ?」。",
            "examples": [
                {
                    "vi": "Bây giờ là mấy giờ?",
                    "zh": "现在几点？"
                },
                {
                    "vi": "Bây giờ mấy giờ rồi?",
                    "zh": "现在几点了？"
                }
            ]
        },
        {
            "point": "「khi nào」问什么时候",
            "explain": "问某事发生的时间用「khi nào?」，可放在句末。",
            "examples": [
                {
                    "vi": "Anh đi khi nào?",
                    "zh": "你什么时候走？"
                },
                {
                    "vi": "Bạn đến khi nào?",
                    "zh": "你什么时候到？"
                }
            ]
        }
    ],
