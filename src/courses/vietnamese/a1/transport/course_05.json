    "grammar": [
        {
            "point": "「phải + 动词」表必须",
            "explain": "表示「必须做某事」用「phải + 动词」，如「phải đội mũ bảo hiểm」（必须戴头盔）。",
            "examples": [
                {
                    "vi": "Phải đội mũ bảo hiểm.",
                    "zh": "必须戴头盔。"
                },
                {
                    "vi": "Phải tuân thủ luật giao thông.",
                    "zh": "必须遵守交通法规。"
                }
            ]
        },
        {
            "point": "「cấm + 动词」表禁止",
            "explain": "「cấm」意为「禁止」，后接动词或名词，如「cấm lái xe khi uống rượu」（禁止酒后驾车）。",
            "examples": [
                {
                    "vi": "Cấm lái xe khi uống rượu.",
                    "zh": "禁止酒后驾车。"
                },
                {
                    "vi": "Cấm vượt đèn đỏ.",
                    "zh": "禁止闯红灯。"
                }
            ]
        }
