    "grammar": [
        {
            "point": "乘坐方式：đi bằng + 工具",
            "explain": "「đi bằng + 交通工具」= 坐…去。bằng 强调方式。口语中可省略 bằng，直接说「đi xe đạp」。但「đi bộ」是特例（步行），不加 bằng。",
            "examples": [
                {
                    "vi": "Tôi đi học bằng xe đạp.",
                    "zh": "我骑自行车上学。"
                },
                {
                    "vi": "Chúng tôi đi Hà Nội bằng tàu hỏa.",
                    "zh": "我们坐火车去河内。"
                }
            ]
        },
        {
            "point": "比较快慢：nhanh hơn / chậm hơn",
            "explain": "「A + 形容词 + hơn + B」= A 比 B 更…。nhanh = 快，chậm = 慢。例：「Máy bay nhanh hơn tàu hỏa」（飞机比火车快）。否定比较用「không … bằng」（不如）。",
            "examples": [
                {
                    "vi": "Đi máy bay nhanh hơn đi tàu.",
                    "zh": "坐飞机比坐火车快。"
                },
                {
                    "vi": "Xe đạp chậm hơn xe máy.",
                    "zh": "自行车比摩托车慢。"
                }
            ]
        }
    ],
