    "grammar": [
        {
            "point": "「lên / xuống + 交通工具」表上下车",
            "explain": "上车用「lên xe」，下车用「xuống xe」。坐公交也可说「lên xe buýt」（上公交）。",
            "examples": [
                {
                    "vi": "Lên xe đi!",
                    "zh": "上车吧！"
                },
                {
                    "vi": "Xuống xe ở trạm tiếp theo.",
                    "zh": "在下一站下车。"
                }
            ]
        },
        {
            "point": "「đi + 交通工具」与「lái + 交通工具」",
            "explain": "「đi xe」= 骑车/坐车（自己骑或作为乘客）；「lái xe」= 开车、驾驶（司机动作）。",
            "examples": [
                {
                    "vi": "Tôi đi xe máy đến trường.",
                    "zh": "我骑摩托去学校。"
                },
                {
                    "vi": "Anh ấy lái xe buýt.",
                    "zh": "他开公交车。"
                }
            ]
        }
    ],
