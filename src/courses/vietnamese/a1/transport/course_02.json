  "grammar": [
    {
      "point": "「mua vé + đi + 地点」表买去哪里的票",
      "explain": "买票用「mua vé + đi + 地点」，如「mua vé đi Hà Nội」（买去河内的票）。",
      "examples": [
        {
          "vi": "Tôi muốn mua vé đi Hà Nội.",
          "zh": "我想买去河内的票。"
        },
        {
          "vi": "Mua hai vé đi Huế.",
          "zh": "买两张去顺化的票。"
        }
      ]
    },
    {
      "point": "问票价「Giá vé bao nhiêu?」",
      "explain": "问票价用「Giá vé bao nhiêu?」，回答用具体金额加「đồng」。",
      "examples": [
        {
          "vi": "Giá vé bao nhiêu?",
          "zh": "票价多少？"
        },
        {
          "vi": "Vé một chiều là 200 nghìn.",
          "zh": "单程票 20 万。"
        }
      ]
    }
