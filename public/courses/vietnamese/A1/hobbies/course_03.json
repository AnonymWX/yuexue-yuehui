    "grammar": [
        {
            "point": "「rất thích / không thích lắm / ghét」程度递进",
            "explain": "好恶程度递进：「rất thích」（很喜欢）>「thích」（喜欢）>「không thích lắm」（不太喜欢）>「không thích」（不喜欢）>「ghét」（讨厌）。",
            "examples": [
                {
                    "vi": "Tôi rất thích đọc sách.",
                    "zh": "我很喜欢读书。"
                },
                {
                    "vi": "Tôi ghét nghe nhạc ồn ào.",
                    "zh": "我讨厌吵闹的音乐。"
                }
            ]
        },
        {
            "point": "「mê / yêu」表热爱",
            "explain": "「mê」和「yêu」比「thích」更强烈，表示酷爱、热爱。",
            "examples": [
                {
                    "vi": "Tôi mê bóng đá.",
                    "zh": "我酷爱足球。"
                },
                {
                    "vi": "Cô ấy yêu âm nhạc.",
                    "zh": "她热爱音乐。"
                }
            ]
        }
    ],
