    "grammar": [
        {
            "point": "「đã + 动词」表过去",
            "explain": "「đã」放在动词前表示过去发生的动作，如「đã thích」（以前喜欢过）。",
            "examples": [
                {
                    "vi": "Tôi đã thích đọc sách.",
                    "zh": "我以前喜欢读书。"
                },
                {
                    "vi": "Anh ấy đã chơi bóng đá.",
                    "zh": "他以前踢过足球。"
                }
            ]
        },
        {
            "point": "「từng + 动词」表曾经",
            "explain": "「từng」表示曾经做过某事，强调经历，如「từng đi du lịch」（曾经去旅游过）。",
            "examples": [
                {
                    "vi": "Tôi từng đi du lịch Nhật Bản.",
                    "zh": "我曾去日本旅游。"
                },
                {
                    "vi": "Cô ấy từng học đàn guitar.",
                    "zh": "她曾学过吉他。"
                }
            ]
        }
    ],
