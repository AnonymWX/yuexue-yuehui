    "grammar": [
        {
            "point": "「đi bằng + 交通工具」表乘坐方式",
            "explain": "表示「乘……去」用「đi bằng + 交通工具」，如「đi bằng xe buýt」（乘公交去）、「đi bằng máy bay」（乘飞机去）。",
            "examples": [
                {
                    "vi": "Tôi đi bằng xe buýt.",
                    "zh": "我乘公交去。"
                },
                {
                    "vi": "Anh ấy đi bằng máy bay.",
                    "zh": "他乘飞机去。"
                }
            ]
        },
        {
            "point": "「xe」的泛指用法",
            "explain": "「xe」泛指车辆，可单独使用或与品类组合：「xe đạp」自行车、「xe máy」摩托、「xe buýt」公交。「ô tô」是汽车的固定说法。",
            "examples": [
                {
                    "vi": "Tôi có xe máy.",
                    "zh": "我有摩托车。"
                },
                {
                    "vi": "Xe buýt đến rồi.",
                    "zh": "公交车到了。"
                }
            ]
        }
    ],
