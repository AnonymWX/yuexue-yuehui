    "grammar": [
        {
            "point": "「sinh năm + 数字」表出生年",
            "explain": "表达「出生于某年」用「sinh năm + 数字」，如「sinh năm 2000」（2000 年出生）。",
            "examples": [
                {
                    "vi": "Tôi sinh năm 2000.",
                    "zh": "我 2000 年出生。"
                },
                {
                    "vi": "Anh ấy sinh năm 1995.",
                    "zh": "他 1995 年出生。"
                }
            ]
        },
        {
            "point": "「quê quán ở + 地点」表籍贯",
            "explain": "表示籍贯或老家用「quê quán ở + 地点」或「quê ở + 地点」。",
            "examples": [
                {
                    "vi": "Quê quán tôi ở Hà Nội.",
                    "zh": "我籍贯在河内。"
                },
                {
                    "vi": "Quê tôi ở miền Nam.",
                    "zh": "我老家在南方。"
                }
            ]
        }
