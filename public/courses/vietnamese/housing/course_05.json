    "grammar": [
        {
            "point": "「treo + 名词 + ở/trên + 位置」表挂",
            "explain": "「treo」意为「挂」，如「treo tranh trên tường」（在墙上挂画）。",
            "examples": [
                {
                    "vi": "Tranh treo trên tường.",
                    "zh": "画挂在墙上。"
                },
                {
                    "vi": "Rèm treo ở cửa sổ.",
                    "zh": "窗帘挂在窗户上。"
                }
            ]
        },
        {
            "point": "「đặt / để + 名词 + ở + 位置」表放置",
            "explain": "「đặt」和「để」都可表示「放置」，前者更强调有意识的摆放，后者更口语。",
            "examples": [
                {
                    "vi": "Tôi đặt đèn trên bàn.",
                    "zh": "我把灯放在桌上。"
                },
                {
                    "vi": "Tôi để sách ở kệ sách.",
                    "zh": "我把书放在书架上。"
                }
            ]
        }
    ],
