    "grammar": [
        {
            "point": "「Nhà tôi ở + 地点」介绍家的位置",
            "explain": "介绍家的位置用「Nhà tôi ở + 地点」，如「Nhà tôi ở đường Nguyễn Huệ」。",
            "examples": [
                {
                    "vi": "Nhà tôi ở đường Nguyễn Huệ.",
                    "zh": "我家在阮惠街。"
                },
                {
                    "vi": "Nhà tôi ở trong hẻm nhỏ.",
                    "zh": "我家在小巷里。"
                }
            ]
        },
        {
            "point": "「gần / xa + 地点」表远近",
            "explain": "「gần」意为「近」，「xa」意为「远」，后接地点名词。",
            "examples": [
                {
                    "vi": "Nhà tôi gần chợ.",
                    "zh": "我家靠近市场。"
                },
                {
                    "vi": "Nhà tôi xa trung tâm.",
                    "zh": "我家离市中心远。"
                }
            ]
        }
    ],
