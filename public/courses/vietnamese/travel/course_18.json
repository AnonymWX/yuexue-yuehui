    "grammar": [
        {
            "point": "住在：ở / sống ở + 地点",
            "explain": "ở 和 sống ở 都表示「住在」，ở 更侧重位置，sống ở 更侧重生活居住。",
            "examples": [
                {
                    "vi": "Tôi ở homestay.",
                    "zh": "我住民宿。"
                },
                {
                    "vi": "Họ sống ở nông thôn.",
                    "zh": "他们住在乡村。"
                }
            ]
        },
        {
            "point": "很安静：rất yên tĩnh",
            "explain": "yên tĩnh 意为「安静」，rất 放在前面表示「很」，用于描述乡村环境。",
            "examples": [
                {
                    "vi": "Ngôi làng này rất yên tĩnh.",
                    "zh": "这个村子很安静。"
                },
                {
                    "vi": "Buổi tối ở đây rất yên tĩnh.",
                    "zh": "这里的晚上很安静。"
                }
            ]
        }
