    "grammar": [
        {
            "point": "「đổi A thành B」表示「把 A 换成 B」",
            "explain": "「đổi」后接要换的东西，用「thành」引出换成的结果。「đổi đô la thành tiền Việt」=「把美元换成越南盾」。",
            "examples": [
                {
                    "vi": "Tôi muốn đổi đô la thành tiền Việt.",
                    "zh": "我想把美元换成越南盾。"
                },
                {
                    "vi": "Đổi tiền ở đâu?",
                    "zh": "在哪里换钱？"
                }
            ]
        },
        {
            "point": "「được không?」表示「可以吗？」",
            "explain": "放在动词短语后构成请求许可的疑问句，回答用「được」（可以）或「không được」（不可以）。",
            "examples": [
                {
                    "vi": "Tôi dùng thẻ được không?",
                    "zh": "我可以用卡吗？"
                },
                {
                    "vi": "Tôi đổi tiền ở đây được không?",
                    "zh": "我可以在这里换钱吗？"
                }
            ]
        }
    ],
