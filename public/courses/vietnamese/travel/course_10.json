    "grammar": [
        {
            "point": "称赞：... giỏi quá / ... hay quá",
            "explain": "quá 放在形容词后表示「太……了」，常与 giỏi（棒）、hay（好听/精彩）搭配表达称赞。",
            "examples": [
                {
                    "vi": "Bạn giỏi quá!",
                    "zh": "你真棒！"
                },
                {
                    "vi": "Bài hát này hay quá.",
                    "zh": "这首歌太好听了。"
                }
            ]
        },
        {
            "point": "鼓励：Cố lên / Đừng lo",
            "explain": "cố lên 意为「加油」，đừng lo 意为「别担心」，都是常见的鼓励用语。",
            "examples": [
                {
                    "vi": "Cố lên, bạn làm được!",
                    "zh": "加油，你能做到！"
                },
                {
                    "vi": "Đừng lo, mọi chuyện sẽ ổn.",
                    "zh": "别担心，一切都会好的。"
                }
            ]
        }
    ],
