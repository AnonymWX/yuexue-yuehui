    "grammar": [
        {
            "point": "请人拍照：nhờ + 人 + chụp ảnh",
            "explain": "nhờ 意为「请、托」，后接人和动作，nhờ ai chụp ảnh 表示「请某人拍照」。",
            "examples": [
                {
                    "vi": "Tôi nhờ anh ấy chụp ảnh.",
                    "zh": "我请他拍照。"
                },
                {
                    "vi": "Nhờ cô ấy chụp giúp.",
                    "zh": "请她帮忙拍照。"
                }
            ]
        },
        {
            "point": "买……作为礼物：mua ... làm quà",
            "explain": "làm 意为「作为、当作」，làm quà 表示「作为礼物」。",
            "examples": [
                {
                    "vi": "Tôi mua cái này làm quà.",
                    "zh": "我买这个作为礼物。"
                },
                {
                    "vi": "Mua quà lưu niệm cho bạn bè.",
                    "zh": "给朋友买纪念品。"
                }
            ]
        }
    ],
