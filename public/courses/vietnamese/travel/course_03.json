    "grammar": [
        {
            "point": "「giúp」表示「帮助」",
            "explain": "「giúp」后接人，再接事情。「Giúp tôi!」=「帮帮我！」「Giúp tôi gọi cảnh sát.」=「帮我叫警察。」",
            "examples": [
                {
                    "vi": "Xin giúp tôi!",
                    "zh": "请帮帮我！"
                },
                {
                    "vi": "Giúp tôi gọi cảnh sát.",
                    "zh": "帮我叫警察。"
                }
            ]
        },
        {
            "point": "祈使句：动词开头",
            "explain": "越南语祈使句常以动词开头，主语省略。「Gọi bệnh viện!」=「叫医院！」加「Xin」表示礼貌。",
            "examples": [
                {
                    "vi": "Gọi bệnh viện!",
                    "zh": "叫医院！"
                },
                {
                    "vi": "Xin giúp tôi!",
                    "zh": "请帮帮我！"
                }
            ]
        }
    ],
