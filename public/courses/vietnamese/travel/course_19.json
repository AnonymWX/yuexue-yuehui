    "grammar": [
        {
            "point": "被 / 遭遇：bị + 名词",
            "explain": "bị 后接不愉快的事件，表示「遭遇、被」，如 bị lạc（迷路）、bị mất（丢了）。",
            "examples": [
                {
                    "vi": "Tôi bị lạc đường.",
                    "zh": "我迷路了。"
                },
                {
                    "vi": "Cô ấy bị mất tiền.",
                    "zh": "她丢了钱。"
                }
            ]
        },
        {
            "point": "需要帮助：cần giúp đỡ",
            "explain": "cần 意为「需要」，giúp đỡ 意为「帮助」，合起来表示需要帮忙，是求助常用语。",
            "examples": [
                {
                    "vi": "Tôi cần giúp đỡ.",
                    "zh": "我需要帮助。"
                },
                {
                    "vi": "Ai có thể giúp đỡ tôi?",
                    "zh": "谁能帮我？"
                }
            ]
        }
    ],
