    "grammar": [
        {
            "point": "叫车：gọi / đặt + xe",
            "explain": "gọi 是「叫」，đặt 是「订」，gọi taxi 或 đặt xe 都表示叫车。",
            "examples": [
                {
                    "vi": "Tôi muốn gọi taxi.",
                    "zh": "我想叫出租车。"
                },
                {
                    "vi": "Tôi đặt xe qua ứng dụng.",
                    "zh": "我通过应用叫车。"
                }
            ]
        },
        {
            "point": "通过：qua + 方式",
            "explain": "qua 意为「通过、经由」，引出方式或渠道，如 qua ứng dụng（通过应用）。",
            "examples": [
                {
                    "vi": "Tôi đặt xe qua ứng dụng.",
                    "zh": "我通过应用叫车。"
                },
                {
                    "vi": "Thanh toán qua điện thoại.",
                    "zh": "通过手机支付。"
                }
            ]
        }
