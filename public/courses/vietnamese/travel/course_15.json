    "grammar": [
        {
            "point": "会游泳：biết bơi",
            "explain": "biết 意为「会、知道」，后接动词表示具备某种技能，biết bơi 意为「会游泳」。",
            "examples": [
                {
                    "vi": "Tôi biết bơi.",
                    "zh": "我会游泳。"
                },
                {
                    "vi": "Cô ấy không biết bơi.",
                    "zh": "她不会游泳。"
                }
            ]
        },
        {
            "point": "在……很：ở ... rất ...",
            "explain": "ở 引出地点，rất 后接形容词，表示在某地具有某种特征。",
            "examples": [
                {
                    "vi": "Bãi biển này rất đẹp.",
                    "zh": "这个海滩很美。"
                },
                {
                    "vi": "Cát ở đây rất trắng.",
                    "zh": "这里的沙子很白。"
                }
            ]
        }
