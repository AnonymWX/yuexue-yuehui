    "grammar": [
        {
            "point": "有……吗：có ... không?",
            "explain": "có ... không 是越南语最常用的疑问句式，把要问的事物放在 có 和 không 之间。",
            "examples": [
                {
                    "vi": "Tàu này có toa nằm không?",
                    "zh": "这火车有卧铺吗？"
                },
                {
                    "vi": "Xe khách có điều hòa không?",
                    "zh": "长途车有空调吗？"
                }
            ]
        },
        {
            "point": "在……停：dừng ở + 地点",
            "explain": "dừng 意为「停」，ở 引出地点，表示在某处停靠。",
            "examples": [
                {
                    "vi": "Xe dừng ở bến nào?",
                    "zh": "车停在哪一站？"
                },
                {
                    "vi": "Tàu dừng ở ga Hà Nội.",
                    "zh": "火车停河内站。"
                }
            ]
        }
