    "grammar": [
        {
            "point": "开（户/门）：mở + 名词",
            "explain": "mở 意为「开」，可搭配 mở tài khoản（开户）、mở cửa（开门）、mở thẻ（办卡）。",
            "examples": [
                {
                    "vi": "Tôi muốn mở tài khoản.",
                    "zh": "我想开户。"
                },
                {
                    "vi": "Ngân hàng mở cửa mấy giờ?",
                    "zh": "银行几点开门？"
                }
            ]
        },
        {
            "point": "询问信息：... là gì?",
            "explain": "「名词 + là gì?」用于询问某物是什么，là 是系动词「是」，gì 是疑问词「什么」。",
            "examples": [
                {
                    "vi": "Mật khẩu của bạn là gì?",
                    "zh": "你的密码是什么？"
                },
                {
                    "vi": "Số tài khoản là gì?",
                    "zh": "账号是多少？"
                }
            ]
        }
