    "grammar": [
        {
            "point": "缴纳费用：đóng + 费用名",
            "explain": "đóng 本意是「关、合」，引申为「缴纳（费用）」，后接 tiền điện / tiền nước 等。",
            "examples": [
                {
                    "vi": "Tôi đi đóng tiền điện.",
                    "zh": "我去交电费。"
                },
                {
                    "vi": "Đóng tiền nước ở đâu?",
                    "zh": "在哪里交水费？"
                }
            ]
        },
        {
            "point": "时间限定：tháng này / tháng trước",
            "explain": "tháng 意为「月」，này 表示「这」，trước 表示「前」，用于限定账单所属月份。",
            "examples": [
                {
                    "vi": "Hóa đơn tháng này bao nhiêu?",
                    "zh": "这个月的账单多少钱？"
                },
                {
                    "vi": "Tôi chưa đóng tiền tháng trước.",
                    "zh": "我上个月的钱还没交。"
                }
            ]
        }
    ],
