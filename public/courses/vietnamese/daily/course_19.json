    "grammar": [
        {
            "point": "邀请：Mời bạn + 动词 / đến + 地点",
            "explain": "mời 意为「邀请」，后接对象和动作；đến 意为「到、来」，引出地点。",
            "examples": [
                {
                    "vi": "Mời bạn đến nhà tôi chơi.",
                    "zh": "邀请你来我家玩。"
                },
                {
                    "vi": "Tôi mời cô ấy đi ăn.",
                    "zh": "我请她去吃饭。"
                }
            ]
        },
        {
            "point": "有空 / 没空：rảnh / bận",
            "explain": "rảnh 表示「有空」，bận 表示「忙」，常用来回应邀请。không 加在前面表示否定。",
            "examples": [
                {
                    "vi": "Tối nay bạn có rảnh không?",
                    "zh": "今晚你有空吗？"
                },
                {
                    "vi": "Xin lỗi, tôi bận rồi.",
                    "zh": "抱歉，我忙。"
                }
            ]
        }
    ],
