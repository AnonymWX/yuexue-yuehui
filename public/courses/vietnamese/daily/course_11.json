    "grammar": [
        {
            "point": "需要做某事：cần + 动词",
            "explain": "cần 意为「需要」，后接动词原形，表示需要做某事。",
            "examples": [
                {
                    "vi": "Tôi cần xét nghiệm máu.",
                    "zh": "我需要验血。"
                },
                {
                    "vi": "Bạn cần nghỉ ngơi.",
                    "zh": "你需要休息。"
                }
            ]
        },
        {
            "point": "必须做某事：phải + 动词",
            "explain": "phải 意为「必须、得」，语气比 cần 更强，表示义务或必要性。",
            "examples": [
                {
                    "vi": "Tôi phải chờ bao lâu?",
                    "zh": "我要等多久？"
                },
                {
                    "vi": "Bạn phải uống thuốc đều.",
                    "zh": "你必须按时吃药。"
                }
            ]
        }
