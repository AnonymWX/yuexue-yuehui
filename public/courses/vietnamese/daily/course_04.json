    "grammar": [
        {
            "point": "询问价格：... bao nhiêu tiền?",
            "explain": "询问价格用「主语 + bao nhiêu tiền?」。bao nhiêu 意为「多少」，tiền 意为「钱」。",
            "examples": [
                {
                    "vi": "Cái này bao nhiêu tiền?",
                    "zh": "这个多少钱？"
                },
                {
                    "vi": "Một cân táo bao nhiêu tiền?",
                    "zh": "一公斤苹果多少钱？"
                }
            ]
        },
        {
            "point": "讲价表达：bớt ... đi / rẻ hơn được không?",
            "explain": "bớt 意为「减少」，đi 是语气词，合起来表示「便宜点吧」。rẻ hơn được không? 意为「能更便宜吗？」，更礼貌。",
            "examples": [
                {
                    "vi": "Đắt quá, bớt chút đi.",
                    "zh": "太贵了，便宜点吧。"
                },
                {
                    "vi": "Rẻ hơn được không?",
                    "zh": "能便宜点吗？"
                }
            ]
        }
    ],
