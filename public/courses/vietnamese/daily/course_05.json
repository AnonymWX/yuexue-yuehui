    "grammar": [
        {
            "point": "请求句型：Cho tôi ...",
            "explain": "Cho tôi + 名词 = 「请给我……」，是点菜、购物时最常用的请求句。",
            "examples": [
                {
                    "vi": "Cho tôi xem thực đơn.",
                    "zh": "请给我看菜单。"
                },
                {
                    "vi": "Cho tôi một bát phở.",
                    "zh": "给我一碗河粉。"
                }
            ]
        },
        {
            "point": "点菜句型：Tôi muốn gọi ...",
            "explain": "Tôi muốn + 动词 = 「我想……」，gọi món 意为「点菜」，后面接具体菜名。",
            "examples": [
                {
                    "vi": "Tôi muốn gọi món.",
                    "zh": "我想点菜。"
                },
                {
                    "vi": "Tôi muốn gọi một bát phở.",
                    "zh": "我想点一碗河粉。"
                }
            ]
        }
