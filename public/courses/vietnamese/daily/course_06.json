    "grammar": [
        {
            "point": "量词：một cốc / một ly",
            "explain": "越南语中「一杯」常用 một cốc 或 một ly（南方更常用 ly），后接饮品名。",
            "examples": [
                {
                    "vi": "Cho tôi một cốc cà phê.",
                    "zh": "给我一杯咖啡。"
                },
                {
                    "vi": "Một ly trà đá.",
                    "zh": "一杯冰茶。"
                }
            ]
        },
        {
            "point": "形容词后置：cà phê nóng / trà lạnh",
            "explain": "越南语形容词放在名词之后修饰，与中文相反。nóng（热）、lạnh（冷）、ngon（好喝）都后置。",
            "examples": [
                {
                    "vi": "Tôi uống trà nóng.",
                    "zh": "我喝热茶。"
                },
                {
                    "vi": "Cà phê sữa đá rất ngon.",
                    "zh": "冰奶咖啡很好喝。"
                }
            ]
        }
