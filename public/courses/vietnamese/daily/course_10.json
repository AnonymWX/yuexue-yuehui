    "grammar": [
        {
            "point": "生病表达：bị + 病症",
            "explain": "bị 表示「遭受、患上」，后接病症，构成「生病」的表达。đau 后可接身体部位。",
            "examples": [
                {
                    "vi": "Tôi bị đau đầu.",
                    "zh": "我头疼。"
                },
                {
                    "vi": "Cô ấy bị sốt.",
                    "zh": "她发烧了。"
                }
            ]
        },
        {
            "point": "频率表达：mỗi ngày + 数字 + lần",
            "explain": "mỗi ngày 意为「每天」，lần 是量词「次」，用于说明用药或活动频率。",
            "examples": [
                {
                    "vi": "Uống thuốc mỗi ngày hai lần.",
                    "zh": "每天吃两次药。"
                },
                {
                    "vi": "Tôi tập thể dục mỗi ngày một lần.",
                    "zh": "我每天锻炼一次。"
                }
            ]
        }
    ],
