    "grammar": [
        {
            "point": "方位问句：... ở đâu?",
            "explain": "ở đâu 意为「在哪里」，用于询问地点。结构为「名词 + ở đâu?」。",
            "examples": [
                {
                    "vi": "Siêu thị ở đâu?",
                    "zh": "超市在哪里？"
                },
                {
                    "vi": "Quầy thanh toán ở đâu?",
                    "zh": "结账柜台在哪里？"
                }
            ]
        },
        {
            "point": "进行时：đang + 动词",
            "explain": "đang 放在动词前，表示动作正在进行，相当于中文的「正在」。",
            "examples": [
                {
                    "vi": "Cái này đang giảm giá.",
                    "zh": "这个正在打折。"
                },
                {
                    "vi": "Tôi đang mua sắm.",
                    "zh": "我正在购物。"
                }
            ]
        }
    ],
