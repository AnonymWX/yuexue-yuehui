    "grammar": [
        {
            "point": "疑问词「ở đâu」（在哪里）",
            "explain": "「ở đâu」用于询问地点，放在句末。「Nhà ga ở đâu?」=「火车站在哪里？」",
            "examples": [
                {
                    "vi": "Nhà ga ở đâu?",
                    "zh": "火车站在哪里？"
                },
                {
                    "vi": "Cửa hàng ở đâu?",
                    "zh": "商店在哪里？"
                }
            ]
        },
        {
            "point": "「đi + 交通工具」表示出行方式",
            "explain": "「đi」后接交通工具表示「乘坐...去」。走路则用「đi bộ」。「Tôi đi xe buýt.」=「我坐公交车去。」",
            "examples": [
                {
                    "vi": "Tôi đi xe buýt.",
                    "zh": "我坐公交车。"
                },
                {
                    "vi": "Tôi đi bộ.",
                    "zh": "我走路。"
                }
            ]
        }
    ],
