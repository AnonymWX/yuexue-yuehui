    "grammar": [
        {
            "point": "动物量词：con + 动物",
            "explain": "越南语中动物普遍用量词 con，如 con chó（狗）、con mèo（猫）、con cá（鱼）。",
            "examples": [
                {
                    "vi": "Nhà tôi có hai con mèo.",
                    "zh": "我家有两只猫。"
                },
                {
                    "vi": "Con chó này rất dễ thương.",
                    "zh": "这只狗很可爱。"
                }
            ]
        },
        {
            "point": "程度副词：rất / lắm",
            "explain": "rất 放在形容词前，lắm 放在形容词后，都表示「很、非常」。",
            "examples": [
                {
                    "vi": "Con mèo rất dễ thương.",
                    "zh": "猫很可爱。"
                },
                {
                    "vi": "Con chó này thông minh lắm.",
                    "zh": "这只狗很聪明。"
                }
            ]
        }
    ],
