    "grammar": [
        {
            "point": "被动 / 状态：bị + 动词",
            "explain": "bị 除表示生病，还可表示「被、遭到」，用于不好的事情，如 bị hỏng（坏了）、bị mất（丢了）。",
            "examples": [
                {
                    "vi": "Máy giặt bị hỏng rồi.",
                    "zh": "洗衣机坏了。"
                },
                {
                    "vi": "Cửa bị hư.",
                    "zh": "门坏了。"
                }
            ]
        },
        {
            "point": "请人做事：nhờ + 人 + 动词",
            "explain": "nhờ 意为「请、托」，后接人和动词，表示请某人做某事。",
            "examples": [
                {
                    "vi": "Tôi nhờ thợ sửa máy giặt.",
                    "zh": "我请修理工修洗衣机。"
                },
                {
                    "vi": "Nhờ chị dọn nhà giúp.",
                    "zh": "请姐姐帮忙打扫房子。"
                }
            ]
        }
    ],
