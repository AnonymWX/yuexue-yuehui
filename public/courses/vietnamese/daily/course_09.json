    "grammar": [
        {
            "point": "寄给某人：gửi ... cho ...",
            "explain": "gửi + 物品 + cho + 人，表示「把某物寄给某人」。cho 在这里表示「给」。",
            "examples": [
                {
                    "vi": "Tôi gửi lá thư này cho mẹ.",
                    "zh": "我把这封信寄给妈妈。"
                },
                {
                    "vi": "Gửi bưu phẩm cho anh ấy.",
                    "zh": "把包裹寄给他。"
                }
            ]
        },
        {
            "point": "量词：lá thư / con tem / cái phong bì",
            "explain": "越南语量词因物而异：信用量词 lá（叶子），邮票用 con，信封用 cái。",
            "examples": [
                {
                    "vi": "Một lá thư.",
                    "zh": "一封信。"
                },
                {
                    "vi": "Hai con tem.",
                    "zh": "两张邮票。"
                }
            ]
        }
    ],
