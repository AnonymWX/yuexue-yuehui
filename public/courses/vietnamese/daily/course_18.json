    "grammar": [
        {
            "point": "祝贺用语：Chúc mừng + 事件",
            "explain": "Chúc mừng 意为「祝贺」，后接节日或喜事，如 Chúc mừng sinh nhật（生日快乐）。",
            "examples": [
                {
                    "vi": "Chúc mừng sinh nhật!",
                    "zh": "生日快乐！"
                },
                {
                    "vi": "Chúc mừng năm mới!",
                    "zh": "新年快乐！"
                }
            ]
        },
        {
            "point": "赠送：tặng + 人 + 物 / tặng + 物 + cho + 人",
            "explain": "tặng 意为「赠送」，有两种句式：直接 tặng 人 物，或用 cho 引出接受者。",
            "examples": [
                {
                    "vi": "Tôi tặng cô ấy một món quà.",
                    "zh": "我送她一份礼物。"
                },
                {
                    "vi": "Tặng quà cho bạn.",
                    "zh": "送礼物给你。"
                }
            ]
        }
