    "grammar": [
        {
            "point": "越来越：ngày càng + 形容词",
            "explain": "ngày càng 意为「越来越」，后接形容词，表示程度随时间加深。",
            "examples": [
                {
                    "vi": "Tiếng Việt của tôi ngày càng tốt.",
                    "zh": "我的越南语越来越好。"
                },
                {
                    "vi": "Trời ngày càng lạnh.",
                    "zh": "天越来越冷。"
                }
            ]
        },
        {
            "point": "能够：có thể + 动词",
            "explain": "có thể 意为「能够、可以」，后接动词原形，表示能力或许可。",
            "examples": [
                {
                    "vi": "Tôi có thể nói tiếng Việt.",
                    "zh": "我能说越南语。"
                },
                {
                    "vi": "Bạn có thể giúp tôi không?",
                    "zh": "你能帮我吗？"
                }
            ]
        }
    ],
