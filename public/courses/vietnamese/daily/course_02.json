    "grammar": [
        {
            "point": "量词「một + 量词 + 名词」",
            "explain": "越南语中数词后通常要加量词。碗：bát；杯：ly/cốc。例如「một bát phở」=「一碗河粉」，「một ly cà phê」=「一杯咖啡」。",
            "examples": [
                {
                    "vi": "Tôi muốn một bát phở.",
                    "zh": "我要一碗河粉。"
                },
                {
                    "vi": "Cho tôi một ly cà phê.",
                    "zh": "请给我一杯咖啡。"
                }
            ]
        },
        {
            "point": "形容词「ngon」（好吃/好喝）",
            "explain": "「ngon」用于评价食物或饮料的味道，前面可加「rất」表示「很」。例如「Phở rất ngon.」=「河粉很好吃。」",
            "examples": [
                {
                    "vi": "Phở rất ngon.",
                    "zh": "河粉很好吃。"
                },
                {
                    "vi": "Cà phê này ngon.",
                    "zh": "这杯咖啡好喝。"
                }
            ]
        }
    ],
