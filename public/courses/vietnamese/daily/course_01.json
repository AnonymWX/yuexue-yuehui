    "grammar": [
        {
            "point": "疑问词「bao nhiêu」（多少）",
            "explain": "「bao nhiêu」用于询问数量或价格，放在名词前。问价格：「Cái này giá bao nhiêu?」=「这个多少钱？」",
            "examples": [
                {
                    "vi": "Cái áo này giá bao nhiêu?",
                    "zh": "这件衣服多少钱？"
                },
                {
                    "vi": "Quyển sách này bao nhiêu tiền?",
                    "zh": "这本书多少钱？"
                }
            ]
        },
        {
            "point": "数词 11–100",
            "explain": "11–19：mười + 个位数（如 mười một = 11）。20–99：十位数 + mươi + 个位数（如 hai mươi = 20，hai mươi lăm = 25）。100：một trăm。",
            "examples": [
                {
                    "vi": "Mười lăm nghìn đồng.",
                    "zh": "一万五千盾。（15,000₫）"
                },
                {
                    "vi": "Hai mươi nghìn đồng.",
                    "zh": "两万盾。（20,000₫）"
                }
            ]
        }
    ],
