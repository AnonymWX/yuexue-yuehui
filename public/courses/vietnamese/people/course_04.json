    "grammar": [
        {
            "point": "问年龄「bao nhiêu tuổi?」",
            "explain": "问年龄用「主语 + bao nhiêu tuổi?」，回答用「主语 + số + tuổi」。对小孩也可问「mấy tuổi?」。",
            "examples": [
                {
                    "vi": "Anh bao nhiêu tuổi?",
                    "zh": "你多大了？"
                },
                {
                    "vi": "Tôi 25 tuổi.",
                    "zh": "我 25 岁。"
                }
            ]
        },
        {
            "point": "年龄段称谓",
            "explain": "越南语用不同词区分年龄段：「em bé」婴儿、「trẻ em」儿童、「thanh niên」青年、「trung niên」中年、「người già」老人。",
            "examples": [
                {
                    "vi": "Anh ấy còn trẻ.",
                    "zh": "他还年轻。"
                },
                {
                    "vi": "Bà ấy đã già.",
                    "zh": "她已经老了。"
                }
            ]
        }
    ],
