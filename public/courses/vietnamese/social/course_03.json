    "grammar": [
        {
            "point": "形容词后置：người + 形容词",
            "explain": "描述人时用 người（人）作中心词，形容词后置，如 người cao（高个子）。",
            "examples": [
                {
                    "vi": "Anh ấy là người cao.",
                    "zh": "他是高个子。"
                },
                {
                    "vi": "Cô ấy là người đẹp.",
                    "zh": "她是个美人。"
                }
            ]
        },
        {
            "point": "有：có + 名词",
            "explain": "có 意为「有」，用于描述某人具备的特征，如 có tóc dài（有长头发）。",
            "examples": [
                {
                    "vi": "Cô ấy có tóc dài.",
                    "zh": "她有长头发。"
                },
                {
                    "vi": "Anh ấy có mắt đen.",
                    "zh": "他有黑眼睛。"
                }
            ]
        }
    ],
