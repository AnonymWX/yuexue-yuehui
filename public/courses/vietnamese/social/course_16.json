    "grammar": [
        {
            "point": "过去标记：đã + 动词",
            "explain": "đã 放在动词前，表示动作已经发生，是越南语最常用的过去时标记。口语中常省略。",
            "examples": [
                {
                    "vi": "Tôi đã ăn cơm rồi.",
                    "zh": "我已经吃饭了。"
                },
                {
                    "vi": "Anh ấy đã đi Hà Nội.",
                    "zh": "他去河内了。"
                }
            ]
        },
        {
            "point": "曾经：từng + 动词",
            "explain": "từng 放在动词前，表示「曾经做过」，强调有过某种经历。",
            "examples": [
                {
                    "vi": "Tôi từng đến Việt Nam.",
                    "zh": "我曾去过越南。"
                },
                {
                    "vi": "Cô ấy từng học tiếng Việt.",
                    "zh": "她曾学过越南语。"
                }
            ]
        }
    ],
