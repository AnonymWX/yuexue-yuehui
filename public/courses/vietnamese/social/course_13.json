    "grammar": [
        {
            "point": "约定：hẹn + 时间 / 地点",
            "explain": "hẹn 意为「约」，可接时间或地点，表示约定见面。",
            "examples": [
                {
                    "vi": "Chúng ta hẹn gặp lúc 7 giờ.",
                    "zh": "我们约在 7 点见面。"
                },
                {
                    "vi": "Tôi hẹn bạn ở quán cà phê.",
                    "zh": "我约你在咖啡馆见面。"
                }
            ]
        },
        {
            "point": "承诺：Hứa / Cam kết + 动词",
            "explain": "hứa 和 cam kết 都表示「承诺」，后接动词，cam kết 语气更正式。",
            "examples": [
                {
                    "vi": "Tôi cam kết thực hiện đúng.",
                    "zh": "我承诺按时完成。"
                },
                {
                    "vi": "Tôi hứa sẽ giữ lời.",
                    "zh": "我保证守信。"
                }
            ]
        }
