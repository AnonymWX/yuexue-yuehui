        {
            "point": "将来标记：sẽ + 动词",
            "explain": "sẽ 放在动词前，表示将来的动作或状态。",
            "examples": [
                {
                    "vi": "Ngày mai tôi sẽ đi Hà Nội.",
                    "zh": "明天我要去河内。"
                },
                {
                    "vi": "Tôi sẽ gọi cho bạn.",
                    "zh": "我会给你打电话。"
                }
            ]
        },
        {
            "point": "打算：dự định + 动词",
            "explain": "dự định 意为「打算」，后接动词，表示已有计划。",
            "examples": [
                {
                    "vi": "Tôi dự định học tiếng Việt.",
                    "zh": "我打算学越南语。"
                },
                {
                    "vi": "Cô ấy dự định đi du lịch.",
                    "zh": "她打算去旅游。"
                }
            ]
        }
