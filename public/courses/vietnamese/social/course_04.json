    "grammar": [
        {
            "point": "形容词后置：cái + 名词 + 形容词",
            "explain": "越南语中形容词放在名词后面，量词 cái 常与物品搭配，如 cái túi to（大包）。",
            "examples": [
                {
                    "vi": "Cái túi này to.",
                    "zh": "这个包很大。"
                },
                {
                    "vi": "Điện thoại mới của tôi nhỏ.",
                    "zh": "我的新手机很小。"
                }
            ]
        },
        {
            "point": "材料：bằng + 材质",
            "explain": "bằng 表示「用……做的」，引出物品的材质。",
            "examples": [
                {
                    "vi": "Cái bàn này bằng gỗ.",
                    "zh": "这张桌子是木头的。"
                },
                {
                    "vi": "Túi bằng da.",
                    "zh": "皮包。"
                }
            ]
        }
    ],
