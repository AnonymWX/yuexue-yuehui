    "grammar": [
        {
            "point": "附和回应：Đúng vậy / Ừ / Vâng",
            "explain": "đúng vậy 意为「确实如此」；ừ 是口语「嗯」；vâng 是礼貌回应，多用于对长辈。",
            "examples": [
                {
                    "vi": "Đúng vậy, tôi cũng nghĩ thế.",
                    "zh": "确实，我也这么想。"
                },
                {
                    "vi": "Vâng, tôi hiểu rồi.",
                    "zh": "是的，我明白了。"
                }
            ]
        },
        {
            "point": "练习：luyện tập + 动词 / 名词",
            "explain": "luyện tập 意为「练习」，后接动词或名词，表示训练某项技能。",
            "examples": [
                {
                    "vi": "Tôi luyện tập nói tiếng Việt.",
                    "zh": "我练习说越南语。"
                },
                {
                    "vi": "Chúng ta luyện tập hội thoại.",
                    "zh": "我们练习对话。"
                }
            ]
        }
