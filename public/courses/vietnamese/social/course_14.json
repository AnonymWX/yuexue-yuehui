    "grammar": [
        {
            "point": "打电话给某人：gọi (điện) cho + 人",
            "explain": "gọi 意为「叫、打」，gọi điện 意为「打电话」，cho 引出对象。",
            "examples": [
                {
                    "vi": "Tôi gọi điện cho mẹ.",
                    "zh": "我打电话给妈妈。"
                },
                {
                    "vi": "Gọi lại cho tôi nhé.",
                    "zh": "给我回个电话吧。"
                }
            ]
        },
        {
            "point": "稍后 / 等一下：một lát / chút nữa",
            "explain": "một lát 和 chút nữa 都表示「一会儿、稍后」，常用于电话中让对方等待。",
            "examples": [
                {
                    "vi": "Chờ một lát nhé.",
                    "zh": "请稍等一会儿。"
                },
                {
                    "vi": "Tôi sẽ gọi lại chút nữa.",
                    "zh": "我稍后回电话。"
                }
            ]
        }
    ],
