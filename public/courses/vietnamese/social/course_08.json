    "grammar": [
        {
            "point": "道歉：Xin lỗi vì / về ...",
            "explain": "xin lỗi 后接 vì 或 về 引出道歉原因，vì 更强调因果，về 更强调关于某事。",
            "examples": [
                {
                    "vi": "Xin lỗi vì tôi đến muộn.",
                    "zh": "抱歉我迟到了。"
                },
                {
                    "vi": "Xin lỗi về chuyện hôm qua.",
                    "zh": "为昨天的事道歉。"
                }
            ]
        },
        {
            "point": "保证：Hứa + 动词",
            "explain": "hứa 意为「保证、许诺」，后接动词，表示承诺今后做某事。",
            "examples": [
                {
                    "vi": "Tôi hứa sẽ không tái phạm.",
                    "zh": "我保证不再犯。"
                },
                {
                    "vi": "Tôi hứa sẽ đến đúng giờ.",
                    "zh": "我保证准时到。"
                }
            ]
        }
    ],
