    "grammar": [
        {
            "point": "在网上：trên mạng / trên mạng xã hội",
            "explain": "trên 意为「在……上」，trên mạng 表示「在网上」，trên mạng xã hội 表示「在社交网络上」。",
            "examples": [
                {
                    "vi": "Tôi thấy tin này trên mạng.",
                    "zh": "我在网上看到这条消息。"
                },
                {
                    "vi": "Cô ấy đăng bài trên mạng xã hội.",
                    "zh": "她在社交网络上发帖。"
                }
            ]
        },
        {
            "point": "给某人：cho + 人",
            "explain": "cho 引出动作的接受者，常用于分享、发帖等网络行为。",
            "examples": [
                {
                    "vi": "Chia sẻ bài này cho bạn bè.",
                    "zh": "把这个帖子分享给朋友。"
                },
                {
                    "vi": "Tôi gửi tin nhắn cho anh ấy.",
                    "zh": "我给他发消息。"
                }
            ]
        }
    ],
