    "grammar": [
        {
            "point": "感谢某事：Cảm ơn vì / về ...",
            "explain": "cảm ơn 后接 vì 或 về 引出感谢的原因，vì 更常用于具体行为。",
            "examples": [
                {
                    "vi": "Cảm ơn vì đã giúp tôi.",
                    "zh": "谢谢你帮了我。"
                },
                {
                    "vi": "Cảm ơn về món quà.",
                    "zh": "谢谢你的礼物。"
                }
            ]
        },
        {
            "point": "回应感谢：Không có gì / Đừng khách sáo",
            "explain": "không có gì 意为「没什么」，是最常见的回应；đừng khách sáo 意为「别客气」。",
            "examples": [
                {
                    "vi": "Không có gì, đừng khách sáo.",
                    "zh": "没什么，别客气。"
                },
                {
                    "vi": "Không có gì đâu.",
                    "zh": "没什么啦。"
                }
            ]
        }
