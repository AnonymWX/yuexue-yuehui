    "grammar": [
        {
            "point": "「thích + 动词」表示喜好",
            "explain": "「thích」后直接接动词或动词短语，表示喜欢做某事。否定用「không thích」。「Tôi thích đọc sách.」=「我喜欢读书。」",
            "examples": [
                {
                    "vi": "Tôi thích nghe nhạc.",
                    "zh": "我喜欢听音乐。"
                },
                {
                    "vi": "Tôi không thích xem phim.",
                    "zh": "我不喜欢看电影。"
                }
            ]
        },
        {
            "point": "「có...không?」疑问句型",
            "explain": "在陈述句末加「có...không?」构成一般疑问句，回答用「có」（是）或「không」（不）。「Bạn có thích đọc sách không?」=「你喜欢读书吗？」",
            "examples": [
                {
                    "vi": "Bạn có thích chơi thể thao không?",
                    "zh": "你喜欢做运动吗？"
                },
                {
                    "vi": "Bạn có rảnh không?",
                    "zh": "你有空吗？"
                }
            ]
        }
    ],
