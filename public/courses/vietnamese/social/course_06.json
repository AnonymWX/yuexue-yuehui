    "grammar": [
        {
            "point": "表达看法：Tôi nghĩ (rằng) ...",
            "explain": "nghĩ 意为「想、认为」，后接从句表达个人观点，rằng 可省略。",
            "examples": [
                {
                    "vi": "Tôi nghĩ vấn đề này quan trọng.",
                    "zh": "我认为这个问题重要。"
                },
                {
                    "vi": "Tôi nghĩ rằng bạn đúng.",
                    "zh": "我认为你是对的。"
                }
            ]
        },
        {
            "point": "据……看：Theo tôi / Theo ý kiến của tôi",
            "explain": "theo 意为「按照、据」，theo tôi 意为「在我看来」，是礼貌表达观点的方式。",
            "examples": [
                {
                    "vi": "Theo tôi, việc này nên làm.",
                    "zh": "在我看来，这件事应该做。"
                },
                {
                    "vi": "Theo ý kiến của tôi, anh ấy đúng.",
                    "zh": "依我看，他是对的。"
                }
            ]
        }
    ],
