    "grammar": [
        {
            "point": "太……了：quá + 形容词",
            "explain": "quá 放在形容词后，表示程度过分，常用于抱怨，如 chậm quá（太慢了）。",
            "examples": [
                {
                    "vi": "Dịch vụ ở đây tệ quá.",
                    "zh": "这里的服务太差了。"
                },
                {
                    "vi": "Giao hàng chậm quá.",
                    "zh": "送货太慢了。"
                }
            ]
        },
        {
            "point": "要求：Tôi muốn đổi / trả ...",
            "explain": "đổi 意为「换」，trả 意为「退」，合起来 đổi trả 表示「退换」，是投诉常用表达。",
            "examples": [
                {
                    "vi": "Tôi muốn đổi trả sản phẩm này.",
                    "zh": "我想退换这个产品。"
                },
                {
                    "vi": "Có thể hoàn tiền không?",
                    "zh": "可以退款吗？"
                }
            ]
        }
    ],
