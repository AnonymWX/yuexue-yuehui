    "grammar": [
        {
            "point": "应该做：nên + 动词",
            "explain": "nên 意为「应该」，放在动词前表示建议。không nên 表示「不应该」。",
            "examples": [
                {
                    "vi": "Bạn nên nghỉ ngơi.",
                    "zh": "你应该休息。"
                },
                {
                    "vi": "Bạn không nên thức khuya.",
                    "zh": "你不应该熬夜。"
                }
            ]
        },
        {
            "point": "最好：tốt nhất là + 动词",
            "explain": "tốt nhất 意为「最好」，加 là 后接动词，表示最推荐的做法。",
            "examples": [
                {
                    "vi": "Tốt nhất là bạn đi khám bác sĩ.",
                    "zh": "你最好去看医生。"
                },
                {
                    "vi": "Tốt nhất là đi sớm.",
                    "zh": "最好早点去。"
                }
            ]
        }
    ],
