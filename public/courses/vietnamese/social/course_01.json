    "grammar": [
        {
            "point": "形容词谓语句（不用「là」）",
            "explain": "越南语中形容词可以直接作谓语，不加「là」。「Trời nóng.」=「天热。」「Hôm nay lạnh.」=「今天冷。」",
            "examples": [
                {
                    "vi": "Trời nóng.",
                    "zh": "天热。"
                },
                {
                    "vi": "Hôm nay lạnh.",
                    "zh": "今天冷。"
                }
            ]
        },
        {
            "point": "「rất」表示「很」",
            "explain": "「rất」放在形容词前表示程度加深。「Trời rất nóng.」=「天很热。」",
            "examples": [
                {
                    "vi": "Trời rất nóng.",
                    "zh": "天很热。"
                },
                {
                    "vi": "Mùa đông rất lạnh.",
                    "zh": "冬天很冷。"
                }
            ]
        }
    ],
