    "grammar": [
        {
            "point": "感到：cảm thấy + 情绪",
            "explain": "cảm thấy 意为「感到」，后接情绪词，表示主观感受。",
            "examples": [
                {
                    "vi": "Tôi cảm thấy vui.",
                    "zh": "我感到高兴。"
                },
                {
                    "vi": "Cô ấy cảm thấy mệt.",
                    "zh": "她感到累。"
                }
            ]
        },
        {
            "point": "因为：vì / tại vì + 原因",
            "explain": "vì 和 tại vì 都表示「因为」，引出原因，tại vì 语气更口语。",
            "examples": [
                {
                    "vi": "Tôi vui vì được gặp bạn.",
                    "zh": "我因为见到你而高兴。"
                },
                {
                    "vi": "Cô ấy buồn vì thua.",
                    "zh": "她因为输了而难过。"
                }
            ]
        }
    ],
