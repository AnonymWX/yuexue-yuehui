    "grammar": [
        {
            "point": "进行时：đang + 动词",
            "explain": "đang 放在动词前，表示动作正在进行，相当于中文的「正在」。",
            "examples": [
                {
                    "vi": "Tôi đang ăn cơm.",
                    "zh": "我正在吃饭。"
                },
                {
                    "vi": "Cô ấy đang học bài.",
                    "zh": "她正在学习。"
                }
            ]
        },
        {
            "point": "即将：sắp + 动词",
            "explain": "sắp 放在动词前，表示动作马上要发生。",
            "examples": [
                {
                    "vi": "Tôi sắp đi học.",
                    "zh": "我快要去上学了。"
                },
                {
                    "vi": "Trời sắp mưa.",
                    "zh": "天快下雨了。"
                }
            ]
        }
    ],
