    "grammar": [
        {
            "point": "「Nơi tôi sống + 特征」表居住地特点",
            "explain": "描述居住地用「Nơi tôi sống + 形容词/动词短语」，如「Nơi tôi sống rất yên tĩnh」。",
            "examples": [
                {
                    "vi": "Nơi tôi sống rất yên tĩnh.",
                    "zh": "我住的地方很安静。"
                },
                {
                    "vi": "Nơi tôi sống ở trung tâm.",
                    "zh": "我住的地方在市中心。"
                }
            ]
        },
        {
            "point": "「ở + 内城/郊区」表位置",
            "explain": "用「ở nội thành」（在市区）或「ở ngoại ô」（在郊区）说明居住位置。",
            "examples": [
                {
                    "vi": "Tôi sống ở nội thành.",
                    "zh": "我住在市区。"
                },
                {
                    "vi": "Anh ấy sống ở ngoại ô.",
                    "zh": "他住在郊区。"
                }
            ]
        }
    ],
