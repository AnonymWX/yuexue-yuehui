    "grammar": [
        {
            "point": "自我介绍：Tôi tên là ... / Tôi là ...",
            "explain": "tên là 意为「名叫」，là 是系动词「是」，两者都可用于介绍姓名。",
            "examples": [
                {
                    "vi": "Tôi tên là Nam.",
                    "zh": "我叫南。"
                },
                {
                    "vi": "Tôi là nhân viên mới.",
                    "zh": "我是新员工。"
                }
            ]
        },
        {
            "point": "来自：đến từ / quê ở ...",
            "explain": "đến từ 意为「来自」，quê ở 意为「家乡在」，均用于介绍籍贯。",
            "examples": [
                {
                    "vi": "Tôi đến từ Hà Nội.",
                    "zh": "我来自河内。"
                },
                {
                    "vi": "Tôi quê ở Đà Nẵng.",
                    "zh": "我家乡在岘港。"
                }
            ]
        }
    ],
