    "grammar": [
        {
            "point": "互相：lẫn nhau / với nhau",
            "explain": "lẫn nhau 和 với nhau 都表示「互相、彼此」，常放在动词后。",
            "examples": [
                {
                    "vi": "Chúng tôi giúp đỡ lẫn nhau.",
                    "zh": "我们互相帮助。"
                },
                {
                    "vi": "Đồng nghiệp hợp tác với nhau.",
                    "zh": "同事们互相合作。"
                }
            ]
        },
        {
            "point": "对……：đối với + 人/事物",
            "explain": "đối với 意为「对于、对……而言」，用于引出对象。",
            "examples": [
                {
                    "vi": "Tôi tôn trọng đối với đồng nghiệp.",
                    "zh": "我尊重同事。"
                },
                {
                    "vi": "Đối với tôi, công việc rất quan trọng.",
                    "zh": "对我而言，工作很重要。"
                }
            ]
        }
    ],
