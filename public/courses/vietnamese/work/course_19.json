    "grammar": [
        {
            "point": "申请：xin + 名词 / nộp đơn + 动词",
            "explain": "xin 意为「申请、请求」，后接具体事物；nộp đơn 意为「递交申请」，后接申请内容。",
            "examples": [
                {
                    "vi": "Tôi muốn xin học bổng.",
                    "zh": "我想申请奖学金。"
                },
                {
                    "vi": "Tôi nộp đơn xin du học.",
                    "zh": "我递交留学申请。"
                }
            ]
        },
        {
            "point": "去……留学：du học ở / tại + 国家",
            "explain": "du học 意为「留学」，ở 或 tại 引出留学国家。",
            "examples": [
                {
                    "vi": "Tôi muốn du học ở Việt Nam.",
                    "zh": "我想去越南留学。"
                },
                {
                    "vi": "Cô ấy du học tại Nhật Bản.",
                    "zh": "她在日本留学。"
                }
            ]
        }
