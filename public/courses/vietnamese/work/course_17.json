    "grammar": [
        {
            "point": "借 / 还：mượn / trả + 物",
            "explain": "mượn 意为「借入」，trả 意为「归还」，两者常搭配书籍、资料等。",
            "examples": [
                {
                    "vi": "Tôi muốn mượn sách.",
                    "zh": "我想借书。"
                },
                {
                    "vi": "Trả sách đúng hạn.",
                    "zh": "按时还书。"
                }
            ]
        },
        {
            "point": "在……里：trong + 地点",
            "explain": "trong 意为「在……里面」，用于描述在某处内部。",
            "examples": [
                {
                    "vi": "Tôi tự học trong thư viện.",
                    "zh": "我在图书馆自习。"
                },
                {
                    "vi": "Có nhiều sách trong thư viện.",
                    "zh": "图书馆里有很多书。"
                }
            ]
        }
