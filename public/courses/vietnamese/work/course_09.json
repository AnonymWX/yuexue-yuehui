    "grammar": [
        {
            "point": "展示：trình bày + 名词",
            "explain": "trình bày 意为「展示、陈述」，后接内容，是汇报中的核心动词。",
            "examples": [
                {
                    "vi": "Tôi sẽ trình bày số liệu.",
                    "zh": "我将展示数据。"
                },
                {
                    "vi": "Anh ấy trình bày kết quả.",
                    "zh": "他展示结果。"
                }
            ]
        },
        {
            "point": "根据：dựa trên / dựa vào + 名词",
            "explain": "dựa trên 和 dựa vào 都表示「根据、基于」，后接依据。",
            "examples": [
                {
                    "vi": "Dựa trên số liệu, chúng tôi phân tích.",
                    "zh": "根据数据，我们分析。"
                },
                {
                    "vi": "Dựa vào kết quả, ta kết luận.",
                    "zh": "根据结果，我们得出结论。"
                }
            ]
        }
