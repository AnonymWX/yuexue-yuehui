    "grammar": [
        {
            "point": "「đặt」表示「预订」",
            "explain": "「đặt」后直接接名词，表示预订某物。订房用「đặt phòng」，订桌用「đặt bàn」。",
            "examples": [
                {
                    "vi": "Tôi muốn đặt một phòng.",
                    "zh": "我想订一个房间。"
                },
                {
                    "vi": "Tôi đặt phòng đơn.",
                    "zh": "我订单人间。"
                }
            ]
        },
        {
            "point": "「một đêm」表示「一晚」",
            "explain": "「đêm」是时间量词，放在数词后表示「几晚」。问价格：「một đêm bao nhiêu tiền?」=「一晚多少钱？」",
            "examples": [
                {
                    "vi": "Một đêm bao nhiêu tiền?",
                    "zh": "一晚多少钱？"
                },
                {
                    "vi": "Tôi ở lại hai đêm.",
                    "zh": "我住两晚。"
                }
            ]
        }
    ],
