    "grammar": [
        {
            "point": "请假：xin nghỉ + 原因",
            "explain": "xin 意为「请求」，nghỉ 意为「休息」，xin nghỉ 后常接原因或时长。",
            "examples": [
                {
                    "vi": "Tôi muốn xin nghỉ ốm.",
                    "zh": "我想请病假。"
                },
                {
                    "vi": "Xin nghỉ một ngày.",
                    "zh": "请一天假。"
                }
            ]
        },
        {
            "point": "被批准：được duyệt",
            "explain": "được 表示被动，duyệt 意为「批准」，合起来表示被批准。",
            "examples": [
                {
                    "vi": "Đơn của tôi được duyệt rồi.",
                    "zh": "我的申请被批准了。"
                },
                {
                    "vi": "Yêu cầu chưa được duyệt.",
                    "zh": "请求还没被批准。"
                }
            ]
        }
    ],
