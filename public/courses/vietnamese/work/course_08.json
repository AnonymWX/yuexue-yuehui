    "grammar": [
        {
            "point": "留言：để lại lời nhắn",
            "explain": "để lại 意为「留下」，lời nhắn 意为「口信」，合起来表示留言。",
            "examples": [
                {
                    "vi": "Tôi muốn để lại lời nhắn.",
                    "zh": "我想留言。"
                },
                {
                    "vi": "Xin để lại lời nhắn cho anh ấy.",
                    "zh": "请给他留个口信。"
                }
            ]
        },
        {
            "point": "稍后：lát nữa / chút nữa",
            "explain": "lát nữa 和 chút nữa 都表示「一会儿、稍后」，常用于电话中约定回电。",
            "examples": [
                {
                    "vi": "Lát nữa tôi gọi lại.",
                    "zh": "我一会儿回电话。"
                },
                {
                    "vi": "Chút nữa tôi sẽ gọi lại.",
                    "zh": "我稍后回电话。"
                }
            ]
        }
    ],
