    "grammar": [
        {
            "point": "发送给：gửi ... cho ...",
            "explain": "gửi 意为「发送」，cho 引出接收者，表示把某物发给某人。",
            "examples": [
                {
                    "vi": "Tôi gửi email cho sếp.",
                    "zh": "我给老板发邮件。"
                },
                {
                    "vi": "Gửi file cho đồng nghiệp.",
                    "zh": "把文件发给同事。"
                }
            ]
        },
        {
            "point": "已经：đã + 动词",
            "explain": "đã 表示动作已完成，放在动词前，常用于工作沟通中的确认。",
            "examples": [
                {
                    "vi": "Tôi đã gửi email rồi.",
                    "zh": "我已经发邮件了。"
                },
                {
                    "vi": "Cô ấy đã thông báo.",
                    "zh": "她已经通知了。"
                }
            ]
        }
