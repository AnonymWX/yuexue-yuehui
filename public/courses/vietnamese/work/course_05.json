    "grammar": [
        {
            "point": "从……到……：từ ... đến ...",
            "explain": "từ ... đến ... 表示时间或空间的起止，常用于描述工作时间。",
            "examples": [
                {
                    "vi": "Tôi làm việc từ 8 giờ đến 5 giờ.",
                    "zh": "我从 8 点工作到 5 点。"
                },
                {
                    "vi": "Họp từ 2 giờ đến 3 giờ.",
                    "zh": "从 2 点开会到 3 点。"
                }
            ]
        },
        {
            "point": "完成：hoàn thành + 名词",
            "explain": "hoàn thành 意为「完成」，后接任务或工作内容。",
            "examples": [
