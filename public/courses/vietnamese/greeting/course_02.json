    "grammar": [
        {
            "point": "问姓名「Tên + 主语 + là gì?」",
            "explain": "越南语问姓名常用「Tên bạn là gì?」（你叫什么名字？）。正式场合也可用「Anh tên là gì?」。",
            "examples": [
                {
                    "vi": "Tên bạn là gì?",
                    "zh": "你叫什么名字？"
                },
                {
                    "vi": "Tên tôi là Nam.",
                    "zh": "我叫南。"
                }
            ]
        },
        {
            "point": "「là」的用法",
            "explain": "「là」相当于汉语的「是」，用于连接主语和表语。",
            "examples": [
                {
                    "vi": "Tôi là sinh viên.",
                    "zh": "我是学生。"
                },
                {
                    "vi": "Đây là bạn tôi.",
                    "zh": "这是我的朋友。"
                }
            ]
        }
    ],
