    "grammar": [
        {
            "point": "问健康「Khỏe không?」",
            "explain": "最常用的健康问候是「Khỏe không?」（好吗？），完整形式为「Bạn có khỏe không?」。回答常用「khỏe」、「bình thường」、「mệt」。",
            "examples": [
                {
                    "vi": "Dạo này bạn có khỏe không?",
                    "zh": "最近你好吗？"
                },
                {
                    "vi": "Mình khỏe, cảm ơn bạn.",
                    "zh": "我很好，谢谢你。"
                }
            ]
        },
        {
            "point": "「Dạo này」+「thế nào?」",
            "explain": "「Dạo này」意为「最近」，「thế nào?」意为「怎么样？」，两者结合用于询问近况。",
            "examples": [
                {
                    "vi": "Dạo này công việc thế nào?",
                    "zh": "最近工作怎么样？"
                },
                {
                    "vi": "Dạo này bạn thế nào?",
                    "zh": "最近你怎么样？"
                }
            ]
        }
    ],
