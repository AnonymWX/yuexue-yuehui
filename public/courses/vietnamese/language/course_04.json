    "grammar": [
        {
            "point": "「biết + 动词」表会做某事",
            "explain": "「biết」后接动词表示「会做某事」，如「biết nói」（会说）、「biết viết」（会写）。",
            "examples": [
                {
                    "vi": "Tôi biết nói tiếng Anh.",
                    "zh": "我会说英语。"
                },
                {
                    "vi": "Anh ấy biết viết tiếng Việt.",
                    "zh": "他会写越南语。"
                }
            ]
        },
        {
            "point": "程度表达「giỏi / một chút / không biết」",
            "explain": "语言水平用「giỏi」（擅长）、「một chút」（一点）、「không biết」（不会）等表达。",
            "examples": [
                {
                    "vi": "Tôi nói tiếng Anh giỏi.",
                    "zh": "我英语说得好。"
                },
                {
                    "vi": "Tôi biết một chút tiếng Việt.",
                    "zh": "我会一点越南语。"
                }
            ]
        }
    ],
