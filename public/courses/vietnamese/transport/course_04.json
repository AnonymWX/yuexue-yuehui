    "grammar": [
        {
            "point": "「Đi đến + 地点 + bằng gì?」表怎么去",
            "explain": "问怎么去某地用「Đi đến + 地点 + bằng gì?」，回答用「bằng + 交通工具」。",
            "examples": [
                {
                    "vi": "Đi đến sân bay bằng gì?",
                    "zh": "怎么去机场？"
                },
                {
                    "vi": "Đi bằng xe buýt.",
                    "zh": "坐公交去。"
                }
            ]
        },
        {
            "point": "「mất + 时间」表花费时间",
            "explain": "表示「花费多少时间」用「mất + 时间」，如「mất 30 phút」（花 30 分钟）。",
            "examples": [
                {
                    "vi": "Đi đến đó mất 30 phút.",
                    "zh": "到那里要 30 分钟。"
                },
                {
                    "vi": "Mất bao lâu để đến?",
                    "zh": "到那里要多久？"
                }
            ]
        }
    ],
