    "grammar": [
        {
            "point": "「Đây là + 名词」介绍物品",
            "explain": "「Đây là...」意为「这是……」，用于介绍身边或近处的物品。「Kia là...」意为「那是……」，用于较远的物品。",
            "examples": [
                {
                    "vi": "Đây là cái bàn.",
                    "zh": "这是桌子。"
                },
                {
                    "vi": "Kia là quyển sách.",
                    "zh": "那是书。"
                }
            ]
        },
        {
            "point": "是非问句「... có phải là ... không?」",
            "explain": "问「是不是」用「... có phải là ... không?」，回答用「Đúng」（对）或「Không phải」（不是）。",
            "examples": [
                {
                    "vi": "Đây có phải là cái bàn không?",
                    "zh": "这是桌子吗？"
                },
                {
                    "vi": "Đúng, đây là cái bàn.",
                    "zh": "对，这是桌子。"
                }
            ]
        }
    ],
