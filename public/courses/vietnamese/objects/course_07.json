    "grammar": [
        {
            "point": "「名词 + của + 人称」表所属",
            "explain": "表示「某人的某物」用「名词 + của + 人称」，如「cái bàn của tôi」（我的桌子）。",
            "examples": [
                {
                    "vi": "Cái bàn này của tôi.",
                    "zh": "这张桌子是我的。"
                },
                {
                    "vi": "Quyển sách này của bạn.",
                    "zh": "这本书是你的。"
                }
            ]
        },
        {
            "point": "问所属「của ai?」",
            "explain": "问「这是谁的」用「Đây là ... của ai?」，回答用「của + 人称」。",
            "examples": [
                {
                    "vi": "Đây là đồ của ai?",
                    "zh": "这是谁的东西？"
                },
                {
                    "vi": "Đây là đồ của tôi.",
                    "zh": "这是我的东西。"
                }
            ]
        }
    ],
