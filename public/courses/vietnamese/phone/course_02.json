    "grammar": [
        {
            "point": "「gọi cho + 人」表打给某人",
            "explain": "「gọi cho」意为「打给某人」，如「gọi cho mẹ」（给妈妈打电话）。",
            "examples": [
                {
                    "vi": "Tôi gọi cho mẹ.",
                    "zh": "我给妈妈打电话。"
                },
                {
                    "vi": "Anh ấy gọi cho bạn.",
                    "zh": "他给你打电话。"
                }
            ]
        },
        {
            "point": "「số điện thoại của + 人」表某人的电话",
            "explain": "问或说电话号码用「số điện thoại của + 人」。",
            "examples": [
                {
                    "vi": "Số điện thoại của bạn là gì?",
                    "zh": "你的电话号码是多少？"
                },
                {
                    "vi": "Số điện thoại của tôi là 0901234567.",
                    "zh": "我的电话号码是 0901234567。"
                }
            ]
        }
    ],
