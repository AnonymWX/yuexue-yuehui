    "grammar": [
        {
            "point": "「Cho tôi gặp + 人」表我找某人",
            "explain": "打电话找某人用「Cho tôi gặp + 人」（请让某人接电话）或「Tôi muốn gặp + 人」。",
            "examples": [
                {
                    "vi": "Cho tôi gặp anh Nam.",
                    "zh": "请让阿南接电话。"
                },
                {
                    "vi": "Tôi muốn gặp chị Lan.",
                    "zh": "我想找阿兰。"
                }
            ]
        },
        {
            "point": "「Chờ một chút」表请稍等",
            "explain": "接电话时让对方稍等用「Chờ một chút」（请稍等）或「Giữ máy một chút」（请别挂断）。",
            "examples": [
                {
                    "vi": "Chờ một chút, tôi đi tìm.",
                    "zh": "请稍等，我去找一下。"
                },
                {
                    "vi": "Giữ máy một chút nhé.",
                    "zh": "请别挂断。"
                }
            ]
        }
    ],
