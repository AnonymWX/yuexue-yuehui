    "grammar": [
        {
            "point": "「bị + 病/不适」表示患病",
            "explain": "「bị」表示遭受不好的事。「Tôi bị đau đầu.」=「我头疼。」「đau」表示疼。",
            "examples": [
                {
                    "vi": "Tôi bị đau đầu.",
                    "zh": "我头疼。"
                },
                {
                    "vi": "Tôi bị đau bụng.",
                    "zh": "我肚子疼。"
                }
            ]
        },
        {
            "point": "「đau + 部位」表示「某部位疼」",
            "explain": "「đau」后接身体部位，就是「哪里疼」。「đau đầu」= 头疼，「đau tay」= 手疼。",
            "examples": [
                {
                    "vi": "đau đầu",
                    "zh": "头疼"
                },
                {
                    "vi": "đau chân",
                    "zh": "腿疼"
                }
            ]
        }
    ],
