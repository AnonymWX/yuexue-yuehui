    "grammar": [
        {
            "point": "「người + 国名」表示某国人",
            "explain": "「người」表示「人」，后接国家名，表示「某国人」。「người Việt Nam」= 越南人，「người Trung Quốc」= 中国人。",
            "examples": [
                {
                    "vi": "Tôi là người Việt Nam.",
                    "zh": "我是越南人。"
                },
                {
                    "vi": "Anh ấy là người Mỹ.",
                    "zh": "他是美国人。"
                }
            ]
        },
        {
            "point": "问国籍「nước nào?」",
            "explain": "「Bạn là người nước nào?」=「你是哪国人？」「nước nào」= 哪个国家。也可用「quốc tịch」问国籍。",
            "examples": [
                {
                    "vi": "Bạn là người nước nào?",
                    "zh": "你是哪国人？"
                },
                {
                    "vi": "Tôi là người Nhật Bản.",
                    "zh": "我是日本人。"
                }
            ]
        }
    ],
