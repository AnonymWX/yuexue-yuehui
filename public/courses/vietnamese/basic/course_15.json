    "grammar": [
        {
            "point": "「sinh năm + 年份」表示出生年",
            "explain": "「Tôi sinh năm 2000.」=「我 2000 年出生。」「năm」后接年份数字。",
            "examples": [
                {
                    "vi": "Tôi sinh năm 2000.",
                    "zh": "我 2000 年出生。"
                },
                {
                    "vi": "Chị ấy sinh năm 1998.",
                    "zh": "她 1998 年出生。"
                }
            ]
        },
        {
            "point": "问出生年份「sinh năm nào?」",
            "explain": "「nào」表示「哪」。「Bạn sinh năm nào?」=「你哪年出生？」",
            "examples": [
                {
                    "vi": "Bạn sinh năm nào?",
                    "zh": "你哪年出生？"
                },
                {
                    "vi": "Anh sinh năm nào?",
                    "zh": "你（哥）哪年出生？"
                }
            ]
        }
    ],
