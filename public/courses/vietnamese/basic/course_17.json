    "grammar": [
        {
            "point": "问时间「mấy giờ?」",
            "explain": "「Bây giờ là mấy giờ?」=「现在几点？」回答「X giờ Y phút.」，整点可省略「phút」。",
            "examples": [
                {
                    "vi": "Bây giờ là mấy giờ?",
                    "zh": "现在几点？"
                },
                {
                    "vi": "Bây giờ là ba giờ.",
                    "zh": "现在三点。"
                }
            ]
        },
        {
            "point": "时态词「đã / đang / sẽ」",
            "explain": "「đã」表过去（已经），「đang」表现在（正在），「sẽ」表将来（将要）。都放在动词前。",
            "examples": [
                {
                    "vi": "Tôi đã ăn cơm.",
                    "zh": "我已经吃饭了。"
                },
                {
                    "vi": "Tôi đang học bài.",
                    "zh": "我正在学习。"
                },
                {
                    "vi": "Tôi sẽ đi Hà Nội.",
                    "zh": "我将去河内。"
                }
            ]
        }
    ],
