    "grammar": [
        {
            "point": "「hãy + 动词」表示建议/命令",
            "explain": "「hãy」放在动词前，表示让对方做某事，语气客气。「Hãy ngồi xuống.」=「请坐下。」",
            "examples": [
                {
                    "vi": "Hãy ngồi xuống.",
                    "zh": "请坐下。"
                },
                {
                    "vi": "Hãy đợi một chút.",
                    "zh": "请等一下。"
                }
            ]
        },
        {
            "point": "「nên / đừng + 动词」表示应该/不要",
            "explain": "「nên」= 应该，「đừng」= 不要。都放动词前。「Bạn nên nghỉ ngơi.」=「你应该休息。」「Đừng lo.」=「别担心。」",
            "examples": [
                {
                    "vi": "Bạn nên nghỉ ngơi.",
                    "zh": "你应该休息。"
                },
                {
                    "vi": "Đừng lo.",
                    "zh": "别担心。"
                }
            ]
        }
    ],
