    "grammar": [
        {
            "point": "「là」表示「是」",
            "explain": "「là」用于连接主语和身份/职业名词，相当于中文的「是」。否定用「không phải là」。",
            "examples": [
                {
                    "vi": "Tôi là giáo viên.",
                    "zh": "我是老师。"
                },
                {
                    "vi": "Bố tôi là bác sĩ.",
                    "zh": "我爸爸是医生。"
                }
            ]
        },
        {
            "point": "「có」表示「有」",
            "explain": "「có」表示拥有。问数量用「mấy」（几）。「Gia đình bạn có mấy người?」=「你家有几口人？」",
            "examples": [
                {
                    "vi": "Gia đình tôi có bốn người.",
                    "zh": "我家有四口人。"
                },
                {
                    "vi": "Tôi có một anh trai.",
                    "zh": "我有一个哥哥。"
                }
            ]
        }
    ],
