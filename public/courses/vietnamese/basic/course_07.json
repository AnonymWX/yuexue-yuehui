    "grammar": [
        {
            "point": "「học + 语言/科目」",
            "explain": "「học」后直接接所学内容。「học tiếng Việt」=「学越南语」，「học tiếng Anh」=「学英语」。",
            "examples": [
                {
                    "vi": "Tôi học tiếng Việt.",
                    "zh": "我学越南语。"
                },
                {
                    "vi": "Tôi học tiếng Anh.",
                    "zh": "我学英语。"
                }
            ]
        },
        {
            "point": "「ở + 地点」表示「在...」",
            "explain": "「ở」引出地点。「Tôi học ở trường.」=「我在学校学习。」",
            "examples": [
                {
                    "vi": "Tôi học ở trường.",
                    "zh": "我在学校学习。"
                },
                {
                    "vi": "Tôi ở nhà.",
                    "zh": "我在家。"
                }
            ]
        }
    ],
