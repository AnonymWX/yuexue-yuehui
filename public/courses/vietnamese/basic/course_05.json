    "grammar": [
        {
            "point": "「màu gì?」问颜色",
            "explain": "「Cái này màu gì?」=「这个什么颜色？」回答：「màu + 颜色」。「màu」放在颜色词前。",
            "examples": [
                {
                    "vi": "Cái này màu gì?",
                    "zh": "这个什么颜色？"
                },
                {
                    "vi": "Cái này màu đỏ.",
                    "zh": "这个是红色。"
                }
            ]
        },
        {
            "point": "形容词后置",
            "explain": "越南语形容词放在名词后。「áo đỏ」=「红衣服」（字面：衣服红）。「nhà trắng」=「白房子」。",
            "examples": [
                {
                    "vi": "Áo đỏ",
                    "zh": "红衣服"
                },
                {
                    "vi": "Nhà trắng",
                    "zh": "白房子"
                }
            ]
        }
    ],
