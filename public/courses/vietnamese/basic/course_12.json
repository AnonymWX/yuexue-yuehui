    "grammar": [
        {
            "point": "量词「cái」和「chiếc」",
            "explain": "「cái」用于大多数无生命物品（cái bàn, cái ghế）。「chiếc」多用于车辆、成对物之一（chiếc xe, chiếc đèn）。",
            "examples": [
                {
                    "vi": "một cái bàn",
                    "zh": "一张桌子"
                },
                {
                    "vi": "một chiếc xe",
                    "zh": "一辆车"
                }
            ]
        },
        {
            "point": "指示词「này / kia / ấy」",
            "explain": "「này」= 这（近），「kia」= 那（远），「ấy」= 那（中距离）。放在名词后。「Cái bàn này」= 这张桌子。",
            "examples": [
                {
                    "vi": "Cái bàn này đẹp.",
                    "zh": "这张桌子好看。"
                },
                {
                    "vi": "Cái ghế kia cũ rồi.",
                    "zh": "那把椅子旧了。"
                }
            ]
        }
    ],
