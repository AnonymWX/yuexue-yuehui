    "grammar": [
        {
            "point": "「A + 形容词 + hơn + B」表示「A 比 B 更…」",
            "explain": "「hơn」放在形容词后，后接被比较对象。「Tôi cao hơn anh ấy.」=「我比他高。」",
            "examples": [
                {
                    "vi": "Tôi cao hơn anh ấy.",
                    "zh": "我比他高。"
                },
                {
                    "vi": "Cái này đắt hơn cái kia.",
                    "zh": "这个比那个贵。"
                }
            ]
        },
        {
            "point": "「A + 形容词 + nhất」表示「A 最…」",
            "explain": "「nhất」放在形容词后，表示最高级。「Chị ấy đẹp nhất lớp.」=「她是班里最漂亮的。」",
            "examples": [
                {
                    "vi": "Chị ấy đẹp nhất lớp.",
                    "zh": "她是班里最漂亮的。"
                },
                {
                    "vi": "Đây là món ngon nhất.",
                    "zh": "这是最好吃的一道菜。"
                }
            ]
        }
    ],
