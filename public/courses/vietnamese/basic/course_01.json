    "grammar": [
        {
            "point": "打招呼基本公式",
            "explain": "[自称] + chào + [称呼对方] + (ạ)。ạ 是对长辈或老师的礼貌语气词。",
            "examples": [
                {
                    "vi": "Em chào cô ạ.",
                    "zh": "老师好。（学生向女老师）"
                },
                {
                    "vi": "Em chào thầy ạ.",
                    "zh": "老师好。（学生向男老师）"
                }
            ]
        },
        {
            "point": "Xin chào 与 Chào 的区别",
            "explain": "Xin chào 更正式、更礼貌；Chào 更日常，后面通常直接跟称呼词。",
            "examples": [
                {
                    "vi": "Xin chào.",
                    "zh": "你好。（正式）"
                },
                {
                    "vi": "Chào bạn!",
                    "zh": "你好，朋友。（日常）"
                }
            ]
        }
    ],
    "telex": [
