    "grammar": [
        {
            "point": "动词连用",
            "explain": "越南语动词可连用，无变形。「Tôi muốn đi xem phim.」=「我想去看电影。」muốn + đi + xem + phim 四个动词连在一起。",
            "examples": [
                {
                    "vi": "Tôi muốn đi xem phim.",
                    "zh": "我想去看电影。"
                },
                {
                    "vi": "Tôi thích nghe nhạc.",
                    "zh": "我喜欢听音乐。"
                }
            ]
        },
        {
            "point": "「làm」表示「做」",
            "explain": "「làm」用途广，可表示「做某事」或「工作」。「Tôi làm việc.」=「我工作。」「Bạn làm gì?」=「你做什么？」",
            "examples": [
                {
                    "vi": "Tôi làm việc.",
                    "zh": "我工作。"
                },
                {
                    "vi": "Bạn làm gì?",
                    "zh": "你做什么？"
                }
            ]
        }
    ],
