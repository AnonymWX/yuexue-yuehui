    "grammar": [
        {
            "point": "综合句型：là / có / không",
            "explain": "「là」连接主语和身份；「có」表示拥有；「không」放动词前表否定。三者可组合使用。",
            "examples": [
                {
                    "vi": "Tôi là sinh viên, tôi có một anh trai.",
                    "zh": "我是学生，我有一个哥哥。"
                },
                {
                    "vi": "Tôi không phải là giáo viên.",
                    "zh": "我不是老师。"
                }
            ]
        },
        {
            "point": "自我介绍模板",
            "explain": "「Xin chào, tôi là [tên]. Tôi là người [nước]. Tôi [tuổi] tuổi. Tôi là [nghề].」",
            "examples": [
                {
                    "vi": "Xin chào, tôi là Nam. Tôi là người Việt Nam.",
                    "zh": "你好，我是 Nam。我是越南人。"
                },
                {
                    "vi": "Tôi hai mươi tuổi. Tôi là sinh viên.",
                    "zh": "我二十岁。我是学生。"
                }
            ]
        }
    ],
