    "grammar": [
        {
            "point": "时间词放句首",
            "explain": "越南语中时间词常放在句首，用逗号隔开，再接主语和谓语。例如「Buổi sáng, tôi thức dậy.」=「早上，我起床。」",
            "examples": [
                {
                    "vi": "Buổi sáng, tôi thức dậy.",
                    "zh": "早上，我起床。"
                },
                {
                    "vi": "Buổi chiều, tôi đi học.",
                    "zh": "下午，我去上学。"
                }
            ]
        },
        {
            "point": "否定用「không」",
            "explain": "「không」放在动词前表示否定，相当于中文的「不」。例如「Tôi không đi học.」=「我不去上学。」",
            "examples": [
                {
                    "vi": "Ngày mai tôi không đi học.",
                    "zh": "明天我不去上学。"
                },
                {
                    "vi": "Hôm nay tôi không đi làm.",
                    "zh": "今天我不去上班。"
                }
            ]
        }
    ],
