    "grammar": [
        {
            "point": "「lắm」表示「很」，放在形容词后",
            "explain": "「lắm」放在形容词后表示程度强，比「rất」语气更重，多用于口语。「Nóng lắm!」=「很热！」",
            "examples": [
                {
                    "vi": "Hôm nay nóng lắm.",
                    "zh": "今天很热。"
                },
                {
                    "vi": "Mùa hè ở Hà Nội nóng lắm.",
                    "zh": "河内的夏天很热。"
                }
            ]
        },
        {
            "point": "「hơi」表示「有点」",
            "explain": "「hơi」放在形容词前，表示程度轻。「hơi lạnh」= 有点冷，「hơi mệt」= 有点累。",
            "examples": [
                {
                    "vi": "Hôm nay hơi lạnh.",
                    "zh": "今天有点冷。"
                },
                {
                    "vi": "Tôi hơi mệt.",
                    "zh": "我有点累。"
                }
            ]
        }
    ],
