    "grammar": [
        {
            "point": "方位词直接放名词前",
            "explain": "「trên bàn」= 桌子上，「dưới ghế」= 椅子下，「trong nhà」= 家里。方位词在前，名词在后。",
            "examples": [
                {
                    "vi": "Sách ở trên bàn.",
                    "zh": "书在桌子上。"
                },
                {
                    "vi": "Mèo ở dưới ghế.",
                    "zh": "猫在椅子下面。"
                }
            ]
        },
        {
            "point": "「ở + 方位 + 名词」表示位置",
            "explain": "「ở」引出位置，后接方位短语。「Tôi ở trong nhà.」=「我在家里。」",
            "examples": [
                {
                    "vi": "Tôi ở trong nhà.",
                    "zh": "我在家里。"
                },
                {
                    "vi": "Ngoài trời đang mưa.",
                    "zh": "外面在下雨。"
                }
            ]
        }
    ],
