    "grammar": [
        {
            "point": "「biết + 动词」表示会做某事",
            "explain": "「biết」表示学会的技能。「Tôi biết nói tiếng Việt.」=「我会说越南语。」否定「không biết」。",
            "examples": [
                {
                    "vi": "Tôi biết nói tiếng Việt.",
                    "zh": "我会说越南语。"
                },
                {
                    "vi": "Tôi không biết hát.",
                    "zh": "我不会唱歌。"
                }
            ]
        },
        {
            "point": "「có thể + 动词」表示能够",
            "explain": "「có thể」表示能力或可能性，比「biết」更正式，可用于请求。「Tôi có thể giúp bạn.」=「我能帮你。」",
            "examples": [
                {
                    "vi": "Tôi có thể giúp bạn.",
                    "zh": "我能帮你。"
                },
                {
                    "vi": "Bạn có thể nói lại không?",
                    "zh": "你能再说一遍吗？"
                }
            ]
        }
    ],
